-- ---------------------------------------------------------------- session
-- A channel id, minted per Studio session. Nothing else identifies this Studio,
-- and it is deliberately NOT persisted: the setup line gets pasted into a chat
-- window, so it must be a capability that dies with the session rather than a
-- password that lives on disk forever.

local function randomHex(n)
	local rng = Random.new()
	local chars = "0123456789abcdef"
	local out = table.create(n)
	for i = 1, n do
		local idx = rng:NextInteger(1, 16)
		out[i] = string.sub(chars, idx, idx)
	end
	return table.concat(out)
end

local function cmdUrl()
	return FIREBASE_DB .. "/channels/" .. tostring(bridge.channel) .. "/cmd"
end

local function resUrl()
	return FIREBASE_DB .. "/channels/" .. tostring(bridge.channel) .. "/res"
end

local function beaconUrl(channel)
	local id = channel or bridge.channel
	return FIREBASE_DB .. "/channels/" .. tostring(id) .. "/beacons"
end

local function ensureIdentity()
	if bridge.channel ~= nil then
		return
	end
	-- Whatever an older build stored is worthless now (and leaving it behind
	-- would keep an old line alive), so wipe it and mint a fresh channel.
	local stale = getSetting("Golem_Channel", nil)
	pcall(function()
		plugin:SetSetting("Golem_Channel", nil)
	end)
	if type(stale) == "string" and #stale &gt;= 8 then
		bridge.previousChannel = stale
	end
	bridge.channel = randomHex(16)
end

ensureIdentity()

-- Mint a fresh channel and wipe the old one. Any line handed to an AI before
-- this call stops working immediately - that is the point of END SESSION.
local function rotateChannel()
	local old = bridge.channel
	bridge.channel = randomHex(16)
	bridge.lastMessageKey = nil
	bridge.skipBefore = os.time() - 45
	bridge.interval = 2
	bridge.okStreak = 0
	bridge.previousChannel = old
	return bridge.channel
end

-- The one line the user (or their AI) runs to link this Studio.
local function setupCommandText()
	return "Connect to my Roblox Studio, Run: npx golem-bridge connect " .. tostring(bridge.channel)
end

local httpWarningShown = false

local function ensureHttpEnabled()
	local enabled = false
	local okRead = pcall(function()
		enabled = HttpService.HttpEnabled
	end)
	if okRead and enabled then
		return true
	end
	-- A plugin can run without the place's "Allow HTTP Requests" setting, but on
	-- some Studio builds the setting still gates HttpService. Try both quietly.
	local okSet = pcall(function()
		HttpService.HttpEnabled = true
	end)
	if not okSet and not httpWarningShown then
		httpWarningShown = true
		log("HttpService is blocked. Turn on Game Settings &gt; Security &gt; Allow HTTP Requests and reopen the Golem window.")
	end
	return okSet or (okRead and enabled)
end

-- sanitizeEnvelope is defined with the JSON helpers further down; it must be
-- declared here so this encode helper closes over it instead of a nil global.
local sanitizeEnvelope

-- Thin RequestAsync wrapper: no compression, no redirects, hard timeouts.
local function request(opts)
	local req = {
		Url = opts.url,
		Method = opts.method or "GET",
		Headers = opts.headers or {},
		Compress = Enum.HttpCompression.None,
	}
	if opts.body ~= nil then
		req.Body = opts.body
	end
	req.Headers["Accept"] = "application/json"
	req.Headers["X-Golem-Plugin"] = VERSION
	req.Headers["X-Golem-Studio"] = STUDIO_VERSION
	local ok, response = pcall(function()
		return HttpService:RequestAsync(req)
	end)
	if not ok then
		return nil, tostring(response)
	end
	if not response.Success then
		local body = tostring(response.Body or "")
		if #body &gt; 300 then
			body = string.sub(body, 1, 300) .. "…"
		end
		return nil, string.format("HTTP %d %s", tonumber(response.StatusCode) or 0, body)
	end
	return response
end

local function encodeBody(value)
	local ok, body = pcall(function()
		return HttpService:JSONEncode(sanitizeEnvelope(value, 0))
	end)
	if not ok then
		return nil, "JSONEncode failed: " .. tostring(body)
	end
	if type(body) ~= "string" then
		return nil, "JSONEncode returned " .. type(body)
	end
	return body
end

local function decodeBody(response)
	if response == nil or response.Body == nil or response.Body == "" then
		return nil
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(response.Body)
	end)
	if not ok then
		return nil
	end
	return data
end
-- ------------------------------------------------------- safe JSON encoding
-- Firebase/relay-era name kept so the shape of every payload stays identical:
-- invalid UTF-8 becomes "?", control characters are dropped, and keys starting
-- with "$" are escaped so nothing in user data can upset the bridge.
local function jsonSafe(s)
 if type(s) ~= "string" then
 return s
 end
 local n = #s
 local out = table.create(n)
 local i = 1
 while i &lt;= n do
 local b = string.byte(s, i)
 if b == 10 or b == 9 then
 table.insert(out, string.sub(s, i, i))
 i = i + 1
 elseif b &lt; 0x20 or b == 0x7F then
 if b ~= 13 then
 table.insert(out, " ")
 end
 i = i + 1
 elseif b &lt; 0x80 then
 table.insert(out, string.sub(s, i, i))
 i = i + 1
 else

 local len = 0
 if b &gt;= 0xF0 and b &lt;= 0xF4 then
 len = 4
 elseif b &gt;= 0xE0 and b &lt;= 0xEF then
 len = 3
 elseif b &gt;= 0xC2 and b &lt;= 0xDF then
 len = 2
 end
 local valid = len &gt;= 2
 if valid then
 local lo, hi = 0x80, 0xBF
 if b == 0xE0 then
 lo = 0xA0
 elseif b == 0xED then
 hi = 0x9F
 elseif b == 0xF0 then
 lo = 0x90
 elseif b == 0xF4 then
 hi = 0x8F
 end
 for j = i + 1, i + len - 1 do
 local cb = string.byte(s, j)
 local jLo = (j == i + 1) and lo or 0x80
 local jHi = (j == i + 1) and hi or 0xBF
 if cb == nil or cb &lt; jLo or cb &gt; jHi then
 valid = false
 break
 end
 end
 end
 if valid then
 table.insert(out, string.sub(s, i, i + len - 1))
 i = i + len
 else
 table.insert(out, "?")
 i = i + 1
 end
 end
 end
 return table.concat(out)
end

function sanitizeEnvelope(value, depth)
 if depth &gt; 64 then
 return tostring(value)
 end
 local kind = type(value)
 if kind == "string" then
 return jsonSafe(value)
 elseif kind == "table" then
 local out = {}
 for key, item in pairs(value) do
 if type(key) == "string" then
 local safeKey = jsonSafe(key)
 if string.sub(safeKey, 1, 1) == "$" then
 safeKey = "__" .. string.sub(safeKey, 2)
 end
 out[safeKey] = sanitizeEnvelope(item, depth + 1)
 else
 out[key] = sanitizeEnvelope(item, depth + 1)
 end
 end
 return out
 else
 return value
 end
end
-- ------------------------------------------------------- undo/redo recordings
-- Ops used to drop a bare SetWaypoint, which collapses into one vague step and
-- makes Undo do the wrong thing (or nothing). Instead every command that can
-- change the place runs inside a named ChangeHistoryService recording, so the
-- undo entry the user sees in Studio says exactly what the AI did, and one
-- Undo reverts exactly one tool call.
--
-- The old `waypoint("...")` calls are still in the op bodies; they now just
-- note the label for the recording that is already open around them.

local recordingId = nil
local recordingLabel = nil
local recordingDepth = 0

local function recordingBegin(label)
	if recordingDepth &gt; 0 then
		recordingDepth = recordingDepth + 1
		return
	end
	recordingDepth = 1
	recordingLabel = tostring(label or "Golem")
	local ok, id = pcall(function()
		return ChangeHistoryService:TryBeginRecording("Golem: " .. recordingLabel, "Golem")
	end)
	if ok and type(id) == "string" then
		recordingId = id
	else
		-- Studio builds without the recording API: fall back to a waypoint so
		-- Undo still reverts the change, just less precisely.
		recordingId = nil
		pcall(function()
			ChangeHistoryService:SetWaypoint("Golem: " .. recordingLabel)
		end)
	end
end

local function recordingFinish()
	if recordingDepth == 0 then
		return
	end
	recordingDepth = recordingDepth - 1
	if recordingDepth &gt; 0 then
		return
	end
	if recordingId ~= nil then
		local id = recordingId
		recordingId = nil
		pcall(function()
			ChangeHistoryService:FinishRecording(id, Enum.FinishRecordingOperation.Commit)
		end)
	end
end

local function recordingCancel()
	if recordingId ~= nil then
		local id = recordingId
		pcall(function()
			ChangeHistoryService:FinishRecording(id, Enum.FinishRecordingOperation.Cancel)
		end)
	end
	recordingId = nil
	recordingDepth = 0
end

-- Ops that must not open a recording: read-only calls, and the history ops
-- themselves (Undo inside a recording confuses Studio).
local NO_RECORDING = {
	ping = true, debug = true, list = true, tree = true, read = true, find = true,
	grep = true, count = true, look = true, look_through = true, selection = true,
	logs = true, screenshot = true, playstate = true, search_assets = true,
	asset_info = true, undo = true, redo = true, setup = true,
}

local function opNeedsRecording(opName)
	return not NO_RECORDING[opName]
end
-- ------------------------------------------------------------ wire helpers
-- Small pieces every Studio-&gt;relay call shares. Declared early because the
-- play-test tools need them too.

-- Request/reply over Firebase, for the cases where Studio asks something and
-- needs the answer before it can continue (the in-game driver, mostly). The
-- normal command path does not use this: it answers asynchronously through
-- relayDeliver further down.
local function relayRequest(baseUrl, op, args, timeoutSec)
	local id = "q" .. randomHex(8)
	local body, encodeErr = encodeBody({ id = id, op = op, args = args or {}, ts = os.time() })
	if body == nil then
		return nil, "could not encode the request: " .. tostring(encodeErr)
	end
	local posted, postErr = request({
		url = baseUrl .. "/cmd.json",
		method = "POST",
		body = body,
		headers = { ["Content-Type"] = "application/json" },
	})
	if posted == nil then
		return nil, tostring(postErr)
	end
	local started = os.clock()
	local budget = timeoutSec or 20
	while os.clock() - started &lt; budget do
		local listing = request({ url = baseUrl .. "/res.json?shallow=true" })
		if listing ~= nil then
			local keys = decodeBody(listing)
			if type(keys) == "table" then
				local sorted = {}
				for key in pairs(keys) do
					table.insert(sorted, key)
				end
				table.sort(sorted)
				for _, key in ipairs(sorted) do
					local entryResp = request({ url = baseUrl .. "/res/" .. key .. ".json" })
					local entry = entryResp ~= nil and decodeBody(entryResp) or nil
					if type(entry) == "table" and entry.id == id then
						pcall(function()
							request({ url = baseUrl .. "/res/" .. key .. ".json", method = "DELETE" })
						end)
						return entry
					end
				end
			end
		end
		task.wait(0.35)
	end
	return nil, string.format("no answer within %d s", budget)
end

-- The in-game driver's private lane. The driver runs inside the play-test copy,
-- which has no access to this plugin, so it gets its own request/reply pair
-- under the same session channel.
local function guestBase(role)
	return FIREBASE_DB .. "/channels/" .. tostring(bridge.channel) .. "/guest/" .. tostring(role or "client")
end
-- ------------------------------------------------------------ shared vocabulary
-- Op verb names for the timeline, and rich-text escaping for every label.

local OPERATION_NAMES = {
	ping = "ping",
	debug = "debug",
	list = "ls",
	tree = "tree",
	find = "find",
	grep = "grep",
	count = "count",
	look = "look",
	read = "cat",
	script = "write",
	create = "create",
	delete = "rm",
	move = "mv",
	group = "group",
	duplicate = "dup",
	rename = "rename",
	selection = "selection",
	waypoint = "waypoint",
	undo = "undo",
	redo = "redo",
	attributes = "attr",
	tag = "tag",
	rotate = "rot",
	face = "face",
	shift = "shift",
	scale = "scale",
	place = "place",
	set_pivot = "pivot",
	paint = "paint",
	anchor = "anchor",
	collide = "collide",
	terrain = "terrain",
	light = "light",
	sound = "sound",
	weld = "weld",
	ui_screen = "ui_screen",
	ui_frame = "ui_frame",
	ui_label = "ui_label",
	ui_button = "ui_button",
	ui_input = "ui_input",
	ui_image = "ui_image",
	ui_list = "ui_list",
	play = "play",
	stop = "stop",
	logs = "logs",
	screenshot = "screenshot",
	click = "click",
	input = "input",
	look_through = "look_through",
	insert_asset = "insert",
	apply_asset = "apply",
	run = "lua",
}
local function richEscape(s)
	s = string.gsub(tostring(s), "&amp;", "&amp;amp;")
	s = string.gsub(s, "&lt;", "&amp;lt;")
	s = string.gsub(s, "&gt;", "&amp;gt;")
	return s
end
-- ------------------------------------------------------------ chat animation
-- Kept from v3.2.0: the shared scroll/typewriter/expand helpers every row uses.

local scrollTween = nil

local function chatMaxScroll()
	local frame = ui.chatFrame
	if frame == nil then
		return 0
	end
	return math.max(0, frame.AbsoluteCanvasSize.Y - frame.AbsoluteWindowSize.Y)
end

local function isPinned()
	return (chatMaxScroll() - (ui.chatFrame.CanvasPosition.Y)) &lt;= 100
end

local function smoothScrollToBottom()
	local frame = ui.chatFrame
	if frame == nil then
		return
	end
	local target = chatMaxScroll()
	if target &lt;= 0 then
		return
	end
	if scrollTween ~= nil then
		scrollTween:Cancel()
	end
	scrollTween = tween(frame, { CanvasPosition = Vector2.new(0, target) }, 0.22)
end

local function chatFollowRaw()
	if ui.chatFrame ~= nil and isPinned() then
		ui.chatFrame.CanvasPosition = Vector2.new(0, chatMaxScroll())
	end
end

local function chatUpdatePill()
	if ui.jumpPill == nil or ui.chatFrame == nil then
		return
	end
	local shouldShow = chatMaxScroll() &gt; 140 and not isPinned()
	if shouldShow ~= ui.jumpPill.Visible then
		ui.jumpPill.Visible = shouldShow
		if shouldShow then
			ui.jumpPill.BackgroundTransparency = 0.5
			ui.jumpPill.TextTransparency = 0.5
			tween(ui.jumpPill, { BackgroundTransparency = 0, TextTransparency = 0 }, 0.18)
		end
	end
end

local function chatScroll(force)
	if ui.chatFrame == nil then
		return
	end
	if force or isPinned() then
		task.defer(smoothScrollToBottom)
		task.defer(chatUpdatePill)
	else
		chatUpdatePill()
	end
end

local function typeOutRow(row, buildText, totalChars, onDone)
	task.spawn(function()
		if totalChars &lt;= 0 then
			row.Text = buildText(0, true)
			if onDone then
				onDone()
			end
			return
		end
		local steps = math.clamp(math.ceil(totalChars / 2), 14, 40)
		for i = 0, steps do
			local reveal = math.floor(totalChars * i / steps)
			row.Text = buildText(reveal, i == steps)
			chatFollowRaw()
			if i &lt; steps then
				task.wait(0.03)
			end
		end
		if onDone then
			onDone()
		end
	end)
end

local function streamLabel(label, full)
	task.spawn(function()
		local total = utf8Len(full)
		if total &lt;= 0 then
			label.Text = full
			return
		end
		local steps = math.clamp(math.ceil(total / 24), 1, 40)
		for i = 0, steps do
			label.Text = utf8Head(full, math.floor(total * i / steps))
			chatFollowRaw()
			if i &lt; steps then
				task.wait(0.025)
			end
		end
	end)
end

local function heightSize(clip, h)
	local x = clip.Size.X
	return UDim2.new(x.Scale, x.Offset, 0, h)
end

local function expandContainer(clip, content, onDone)
	clip.Visible = true
	clip.Size = heightSize(clip, 0)
	if clip:IsA("CanvasGroup") then
		clip.GroupTransparency = 1
	end
	task.defer(function()
		local t = tween(clip, { Size = heightSize(clip, math.ceil(content.AbsoluteSize.Y)) }, 0.3, Enum.EasingStyle.Quint)
		if clip:IsA("CanvasGroup") then
			tween(clip, { GroupTransparency = 0 }, 0.25)
		end
		t.Completed:Connect(function(playback)
			if playback == Enum.PlaybackState.Completed then
				local nowHeight = math.ceil(content.AbsoluteSize.Y)
				if math.abs(clip.Size.Y.Offset - nowHeight) &gt; 1 then
					tween(clip, { Size = heightSize(clip, nowHeight) }, 0.15)
				end
			end
			if onDone then
				onDone()
			end
		end)
	end)
end

local function collapseContainer(clip, onDone)
	local t = tween(clip, { Size = heightSize(clip, 0) }, 0.24, Enum.EasingStyle.Quint)
	if clip:IsA("CanvasGroup") then
		tween(clip, { GroupTransparency = 1 }, 0.2)
	end
	t.Completed:Connect(function()
		clip.Visible = false
		if clip:IsA("CanvasGroup") then
			clip.GroupTransparency = 0
		end
		if onDone then
			onDone()
		end
	end)
end
local activeDotSets = {}
local dotsPhase = 0.0
local dotsConn = nil

local function dotsHeartbeat(dt)
 dotsPhase = (dotsPhase + dt * 2.2) % (math.pi * 2)
 for _, set in ipairs(activeDotSets) do
 for i, dot in ipairs(set) do
 local phase = (dotsPhase - (i - 1) * 0.55) % (math.pi * 2)
 local s = (math.sin(phase) + 1) / 2
 dot.BackgroundTransparency = 0.15 + 0.65 * (1 - s)
 dot.Size = UDim2.fromOffset(4 + 4 * s, 4 + 4 * s)
 end
 end
end

local function dotsAttach(set)
 table.insert(activeDotSets, set)
 if dotsConn == nil then
 dotsConn = RunService.Heartbeat:Connect(dotsHeartbeat)
 end
end

local function dotsDetach(set)
 for i, existing in ipairs(activeDotSets) do
 if existing == set then
 table.remove(activeDotSets, i)
 break
 end
 end
 for _, dot in ipairs(set) do
 dot.BackgroundTransparency = 1
 end
 if #activeDotSets == 0 and dotsConn ~= nil then
 dotsConn:Disconnect()
 dotsConn = nil
 end
end

local function flashChip(chip, color)
 chip.BackgroundColor3 = color
 task.delay(0.35, function()
 if chip.Parent ~= nil then
 tween(chip, { BackgroundColor3 = COLORS.cardHi }, 0.4)
 end
 end)
end

local function selectInstanceByPath(path, chip)
 local inst = resolvePath(path)
 if inst ~= nil then
 Selection:Set({ inst })
 if chip ~= nil then
 flashChip(chip, COLORS.live)
 end
 log("Highlighted " .. slashPath(inst))
 else
 if chip ~= nil then
 flashChip(chip, COLORS.err)
 end
 log("Could not highlight '" .. tostring(path) .. "' (no longer exists?)", "err")
 end
end

local function extractPaths(args, envelope)
 local paths = {}
 local function add(p)
 if type(p) ~= "string" or #p == 0 or string.sub(p, 1, 2) == "I:" then
 return
 end
 for _, existing in ipairs(paths) do
 if existing == p then
 return
 end
 end
 if #paths &lt; 10 then
 table.insert(paths, p)
 end
 end
 if type(args) == "table" then
 add(args.path)
 add(args.parent)
 add(args.scope)
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 add(p)
 end
 end
 if type(args.set) == "table" then
 for _, p in ipairs(args.set) do
 add(p)
 end
 end
 end
 local result = (envelope ~= nil) and envelope.result or nil
 if type(result) == "table" then
 add(result.path)
 if type(result.deleted) == "table" then
 for _, p in ipairs(result.deleted) do
 add(p)
 end
 end
 if type(result.inserted) == "table" then
 for _, r in ipairs(result.inserted) do
 if type(r) == "table" then
 add(r.path)
 end
 end
 end
 if type(result.results) == "table" then
 for _, r in ipairs(result.results) do
 if type(r) == "table" then
 add(r.path)
 end
 end
 end
 if type(result.rotated) == "table" then
 for _, r in ipairs(result.rotated) do
 if type(r) == "table" then
 add(r.path)
 end
 end
 end
 if type(result.copies) == "table" then
 for _, r in ipairs(result.copies) do
 if type(r) == "table" then
 add(r.path)
 end
 end
 end
 if type(result.moved) == "table" then
 for _, p in ipairs(result.moved) do
 add(p)
 end
 end
 if type(result.selection) == "table" then
 for _, r in ipairs(result.selection) do
 if type(r) == "table" then
 add(r.path)
 end
 end
 end
 end
 return paths
end

-- ------------------------------------------------------- tool row rendering
-- Row/badge rendering and the per-row detail panel. Everything here only
-- touches already-defined animation helpers declared above.

local function rowTitle(opName, descText)
	local verb = OPERATION_NAMES[opName] or tostring(opName)
	if descText ~= nil and #descText &gt; 0 then
		return verb, descText
	end
	return verb, nil
end

local function rowRichText(opName, descText, glyphHex, msText, descReveal)
	local verb, desc = rowTitle(opName, descText)
	local shown = desc
	if shown ~= nil and descReveal ~= nil then
		shown = utf8Head(shown, descReveal)
	end
	local text = string.format('&lt;font color="%s"&gt;%s&lt;/font&gt;', glyphHex, richEscape(verb))
	if shown ~= nil and #shown &gt; 0 then
		text = text .. string.format(' &lt;font color="%s"&gt;%s&lt;/font&gt;', COLORS_HEX.text, richEscape(shown))
	end
	if msText ~= nil then
		text = text .. string.format(' &lt;font color="%s"&gt;· %s&lt;/font&gt;', COLORS_HEX.faint, msText)
	end
	return text
end

-- The detail panel that opens when a row is clicked: request, result, and any
-- instance paths the call touched (each path is clickable to select it).

local function buildDetail(rowHolder)
	local detail = createElement("Frame", {
		Position = UDim2.new(0, 30, 0, 24),
		Size = UDim2.new(1, -30, 0, 0),
		BackgroundColor3 = COLORS.inner,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
	}, rowHolder)
	addCorner(detail, 6)
	local inner = createElement("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, detail)
	createElement("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, inner)
	createElement("UIPadding", {
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
	}, inner)
	local function sectionTitle(order, text)
		createElement("TextLabel", {
			Size = UDim2.new(1, 0, 0, 12),
			BackgroundTransparency = 1,
			FontFace = fontSemibold,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = COLORS.textFaint,
			Text = text,
			LayoutOrder = order,
		}, inner)
	end
	sectionTitle(1, "REQUEST")
	local argsLabel = createElement("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		FontFace = fontMono,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		TextColor3 = COLORS.textDim,
		Text = "{}",
		LayoutOrder = 2,
	}, inner)
	sectionTitle(3, "RESULT")
	local resultLabel = createElement("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		FontFace = fontMono,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		TextColor3 = COLORS.textDim,
		Text = "",
		LayoutOrder = 4,
	}, inner)
	local chips = createElement("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 5,
	}, inner)
	createElement("UIListLayout", {
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, chips)
	local detail = {
		frame = detail,
		inner = inner,
		argsLabel = argsLabel,
		resultLabel = resultLabel,
		chips = chips,
		open = false,
	}
	detail.addChip = function(p)
		local chip = createElement("TextButton", {
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundColor3 = COLORS.cardHi,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			FontFace = fontMono,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = COLORS.text,
			Text = "» " .. tostring(p),
		}, chips)
		addCorner(chip, 5)
		chip.MouseEnter:Connect(function()
			tween(chip, { BackgroundColor3 = COLORS.inner }, 0.12)
		end)
		chip.MouseLeave:Connect(function()
			tween(chip, { BackgroundColor3 = COLORS.cardHi }, 0.2)
		end)
		chip.Activated:Connect(function()
			selectInstanceByPath(tostring(p), chip)
		end)
	end
	detail.openPanel = function()
		detail.open = true
		expandContainer(detail.frame, detail.inner, chatScroll)
	end
	detail.closePanel = function()
		detail.open = false
		collapseContainer(detail.frame)
	end
	detail.toggle = function()
		if detail.open then
			detail.closePanel()
		else
			detail.openPanel()
		end
		chatScroll()
	end
	detail.inner:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if detail.open and detail.frame.Visible then
			tween(detail.frame, { Size = heightSize(detail.frame, math.ceil(detail.inner.AbsoluteSize.Y)) }, 0.12)
		end
	end)
	return detail
end
-- ---------------------------------------------------------------- tool history
-- Numbered turns: each turn header says "Turn: N" and its tool rows hang
-- underneath it. This replaces the old note system entirely - there is no
-- free-text entry in the timeline, only the turn counter and tool rows.
-- The save under the place keeps the same events, so reopening Studio
-- rebuilds the identical list.

local CHAT_HISTORY_MAX = 260
local RESTORE_MAX_EVENTS = 220

local chatEvents = {}
local chatQueue = {}
local chatOrder = 0
local currentTurn = nil
local turnNumber = 0
local saveScheduled = false
-- Token identifying the AI's current request. The CLI stamps every command it
-- sends during one request with the same token, so the timeline opens the new
-- turn on the *first* call of a request instead of on the next one.
local turnToken = nil

local function chatPlaceKey()
	if game.PlaceId ~= nil and game.PlaceId ~= 0 then
		return "Golem_History_" .. tostring(game.PlaceId)
	end
	local name = string.gsub(tostring(game.Name), "[^%w%-_]", "_")
	return "Golem_History_local_" .. name
end

local function saveNow()
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode({ v = 4, turn = turnNumber, events = chatEvents })
	end)
	if ok then
		pcall(function()
			plugin:SetSetting(chatPlaceKey(), encoded)
		end)
	end
end

local function saveSoon()
	if saveScheduled then
		return
	end
	saveScheduled = true
	task.delay(1.5, function()
		saveScheduled = false
		saveNow()
	end)
end

local function pushEvent(entry)
	table.insert(chatEvents, entry)
	while #chatEvents &gt; CHAT_HISTORY_MAX do
		table.remove(chatEvents, 1)
	end
	saveSoon()
end

local function chatHideEmpty()
	if ui.chatEmpty ~= nil and ui.chatEmpty.Visible then
		ui.chatEmpty.Visible = false
	end
	if ui.setupPill ~= nil then
		ui.setupPill.Visible = false
	end
	if ui.setupPopup ~= nil and ui.setupPopup.Visible and ui.hideSetupPopup ~= nil then
		ui.hideSetupPopup()
	end
end

local function turnElapsed(turn)
	return string.format("%ds", math.max(1, math.floor(os.clock() - (turn.startedAt or os.clock()))))
end

local function rerenderTurnLabel(turn)
	if turn == nil or turn.label == nil then
		return
	end
	local extra = ""
	if turn.count &gt; 0 then
		extra = string.format('  &lt;font color="%s"&gt;· %d tool%s · %s&lt;/font&gt;',
			COLORS_HEX.faint, turn.count, turn.count == 1 and "" or "s", turnElapsed(turn))
	end
	turn.label.Text = string.format("Turn: %d", turn.number) .. extra
end

-- A turn container. Created only when there is a tool to show, so an idle
-- Studio never grows empty "Turn: N" headers.
local function newTurn()
	local holder = createElement("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = turnNumber,
	}, ui.chatFrame)
	createElement("UIListLayout", {
		Padding = UDim.new(0, 3),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, holder)
	local label = createElement("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		RichText = true,
		FontFace = fontSemibold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COLORS.text,
		Text = "",
		LayoutOrder = 1,
	}, holder)
	local rows = createElement("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
	}, holder)
	createElement("UIListLayout", {
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, rows)
	local turn = {
		number = turnNumber,
		holder = holder,
		label = label,
		rows = rows,
		count = 0,
		startedAt = os.clock(),
	}
	chatOrder = chatOrder + 1
	table.insert(chatQueue, holder)
	while #chatQueue &gt; 60 do
		local oldest = table.remove(chatQueue, 1)
		if oldest ~= nil and oldest ~= holder then
			oldest:Destroy()
		end
	end
	rerenderTurnLabel(turn)
	return turn
end

-- Advance the counter and open a fresh turn. The very first turn of a session
-- must be Turn: 1, so the counter is advanced *before* the label is drawn and
-- the turn is announced even before its first tool row exists.
local function touchTurn()
	turnNumber = turnNumber + 1
	pushEvent({ k = "turn", n = turnNumber })
	currentTurn = newTurn()
	if refreshWorking ~= nil then
		refreshWorking()
	end
end

-- A new AI request: open its turn immediately, before any tool runs.
local function beginTurnFor(token)
	if token == nil or token == turnToken then
		return false
	end
	turnToken = token
	if currentTurn ~= nil then
		currentTurn = nil
	end
	touchTurn()
	return true
end

local function bumpRow(turn)
	if turn == nil then
		return
	end
	turn.count = turn.count + 1
	rerenderTurnLabel(turn)
end

-- One tool row. The tick sits in a shared left column so consecutive rows line
-- up under their turn header, and the detail panel is created *inside* the row
-- (never as a sibling), which is what kept the old error box off the header.
local function addRow(turn)
	local rowHolder = createElement("Frame", {
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		LayoutOrder = turn.count + 1,
	}, turn.rows)
	local tick = createElement("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 15, 0.5, 0),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = COLORS.accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, rowHolder)
	addCorner(tick, 3)
	local row = createElement("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = COLORS.card,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		RichText = true,
		FontFace = fontRegular,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COLORS.textDim,
		Text = "",
		TextTransparency = 1,
	}, rowHolder)
	local pad = createElement("UIPadding", { PaddingLeft = UDim.new(0, 30) }, row)
	row.MouseEnter:Connect(function()
		tween(row, { BackgroundTransparency = 0.9 }, 0.12)
	end)
	row.MouseLeave:Connect(function()
		tween(row, { BackgroundTransparency = 1 }, 0.2)
	end)
	return rowHolder, row, tick
end
-- ------------------------------------------------------------ arg summaries

local function describeArgs(op, args)
	if type(args) ~= "table" then
		return ""
	end
	local function s(value)
		return tostring(value or "")
	end
	local pathOps = {
		read = true, script = true, rotate = true, face = true, shift = true, scale = true,
		duplicate = true, set_pivot = true, place = true, look = true, rename = true,
		light = true, selection = true, undo = true, redo = true, waypoint = true,
	}
	if pathOps[op] then
		if op == "rename" then
			return s(args.path) .. " → " .. s(args.name)
		end
		return s(args.path)
	end
	if op == "list" or op == "tree" or op == "count" then
		return s(args.path == nil and args.scope or args.path)
	end
	if op == "grep" then
		return "\"" .. s(args.pattern) .. "\""
	end
	if op == "find" then
		if args.tag ~= nil then
			return "tag " .. s(args.tag)
		end
		return "\"" .. s(args.query) .. "\""
	end
	if op == "script" then
		return s(args.class or "Script") .. " " .. s(args.parent) .. "/" .. s(args.name)
	end
	if op == "create" then
		return s(args.class) .. (args.parent ~= nil and (" in " .. s(args.parent)) or "")
	end
	if op == "delete" or op == "paint" or op == "anchor" or op == "collide"
		or op == "tag" or op == "weld" or op == "group" then
		if type(args.paths) == "table" then
			if #args.paths == 1 then
				return s(args.paths[1])
			end
			return string.format("%d instances", #args.paths)
		end
		return s(args.path)
	end
	if op == "move" then
		return s(args.path) .. " → " .. s(args.parent)
	end
	if op == "run" then
		local code = s(args.code)
		local firstLine = string.match(code, "^[^\n]*") or ""
		if #firstLine &gt; 0 then
			return firstLine
		end
		return "Lua"
	end
	if op == "play" then
		return s(args.mode or "play")
	end
	if op == "logs" then
		return s(args.filter or "errors")
	end
	if op == "screenshot" then
		return s(args.label or "viewport")
	end
	if op == "click" then
		return string.format("%s,%s", s(args.x), s(args.y))
	end
	if op == "input" then
		return s(args.keys or args.key or args.text or "")
	end
	if op == "look_through" then
		return s(args.path)
	end
	return ""
end
-- Public entry points used by the command loop and by restore.

local function beginToolRow(opName, args)
	if ui.chatFrame == nil then
		return nil
	end
	if currentTurn == nil then
		touchTurn()
	end
	bumpRow(currentTurn)
	local turn = currentTurn
	local handle = {
		op = tostring(opName),
		desc = describeArgs(opName, args),
		args = args,
		turn = turn,
	}
	if #handle.desc &gt; 56 then
		handle.desc = truncateBytes(handle.desc, 54) .. "…"
	end
	local rowHolder, row, tick = addRow(turn, handle.desc)
	handle.rowHolder = rowHolder
	handle.row = row
	handle.tick = tick
	handle.detail = buildDetail(rowHolder)
	local dotsFrame = createElement("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(42, 16),
	}, row)
	createElement("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
	}, dotsFrame)
	handle.dots = {}
	for i = 1, 3 do
		local dot = createElement("Frame", {
			Size = UDim2.fromOffset(5, 5),
			BackgroundColor3 = COLORS.accent,
			BorderSizePixel = 0,
			BackgroundTransparency = 1,
			LayoutOrder = i,
		}, dotsFrame)
		addCorner(dot, 4)
		handle.dots[i] = dot
	end
	dotsAttach(handle.dots)
	tween(tick, { BackgroundTransparency = 0.2 }, 0.2)
	row.Text = rowRichText(handle.op, handle.desc, COLORS_HEX.warn, nil, 0)
	tween(row, { TextTransparency = 0 }, 0.15)
	typeOutRow(row, function(reveal, done)
		return rowRichText(handle.op, handle.desc, COLORS_HEX.warn, nil, reveal)
	end, utf8Len(handle.desc))
	handle.argsJson = "{}"
	pcall(function()
		handle.argsJson = HttpService:JSONEncode(type(args) == "table" and args or {})
	end)
	if #handle.argsJson &gt; 600 then
		handle.argsJson = truncateBytes(handle.argsJson, 600) .. "…"
	end
	handle.detail.argsLabel.Text = handle.argsJson
	row.Activated:Connect(handle.detail.toggle)
	chatHideEmpty()
	if refreshWorking ~= nil then
		refreshWorking()
	end
	chatScroll()
	return handle
end

-- Append a tool row to the current turn. Returns a handle whose :finish(envelope)
-- completes it, or nil when the panel is not built.
local function addChatCommand(opName, args)
	return beginToolRow(opName, args)
end

-- Replay one saved event stream into a fresh panel.
function chatRestore()
	local stored = getSetting(chatPlaceKey(), nil)
	if type(stored) ~= "string" or #stored == 0 then
		return
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(stored)
	end)
	if not ok or type(data) ~= "table" then
		return
	end
	local events = data
	local savedTurn = 0
	if type(data.events) == "table" then
		events = data.events
		savedTurn = tonumber(data.turn) or 0
	end
	local skip = math.max(0, #events - RESTORE_MAX_EVENTS)
	if skip &gt; 0 and ui.chatFrame ~= nil then
		-- keep the turn boundary intact: advance to the next "turn" marker
		while skip &lt; #events and events[skip + 1] ~= nil and events[skip + 1].k ~= "turn" do
			skip = skip + 1
		end
	end
	-- a saved history continues where it left off; a fresh place starts at 1
	turnNumber = math.max(savedTurn, 0)
	for i = skip + 1, #events do
		local entry = events[i]
		if type(entry) == "table" then
			if entry.k == "turn" then
				turnNumber = math.max(turnNumber, tonumber(entry.n) or (turnNumber + 1))
				currentTurn = newTurn()
			elseif entry.k == "tool" and type(entry.op) == "string" then
				if currentTurn == nil then
					turnNumber = turnNumber + 1
					currentTurn = newTurn()
				end
				bumpRow(currentTurn)
				local handle = beginToolRow(entry.op, nil)
				if handle ~= nil then
					-- restored rows are static: no typing animation, no dots
					handle.desc = tostring(entry.d or "")
					handle.argsJson = tostring(entry.a or "{}")
					dotsDetach(handle.dots, true)
					handle.detail.argsLabel.Text = handle.argsJson
					local ms = tonumber(entry.ms) or 0
					local resultText = tostring(entry.r or "")
					if entry.ok then
						resultText = "{}"
						handle.detail.resultLabel.TextColor3 = COLORS.textDim
					else
						handle.detail.resultLabel.TextColor3 = COLORS.err
					end
					handle.detail.resultLabel.Text = resultText
					handle.row.Text = rowRichText(handle.op, handle.desc,
						entry.ok and COLORS_HEX.live or COLORS_HEX.err,
						ms &gt; 0 and (tostring(ms) .. " ms") or nil, nil)
					handle.row.TextTransparency = 0
					handle.tick.BackgroundColor3 = entry.ok and COLORS.live or COLORS.err
					handle.tick.BackgroundTransparency = 0
					if type(entry.p) == "table" then
						for _, p in ipairs(entry.p) do
							if type(p) == "string" then
								handle.detail.addChip(p)
							end
						end
					end
				end
			end
		end
	end
	currentTurn = nil
	chatScroll()
end

function chatPersistNow()
	saveNow()
end

function chatFlushTurn()
	currentTurn = nil
	if refreshWorking ~= nil then
		refreshWorking()
	end
end

local function clearHistory()
	chatEvents = {}
	turnNumber = 0
	currentTurn = nil
	for _, holder in ipairs(chatQueue) do
		pcall(function()
			holder:Destroy()
		end)
	end
	chatQueue = {}
	pcall(function()
		plugin:SetSetting(chatPlaceKey(), "")
	end)
	if ui.chatEmpty ~= nil then
		ui.chatEmpty.Visible = true
	end
	if refreshWorking ~= nil then
		refreshWorking()
	end
	chatScroll()
end
-- Completes a live row once the command comes back (Studio side).
local function finishRow(handle, envelope)
	local ms = tonumber(envelope.meta and envelope.meta.durationMs) or 0
	local detail = handle.detail
	handle.detail.argsLabel.Text = handle.argsJson
	local resultText
	if envelope.ok then
		resultText = "{}"
		pcall(function()
			resultText = HttpService:JSONEncode(envelope.result)
		end)
		if #resultText &gt; 1200 then
			resultText = truncateBytes(resultText, 1200) .. "\n… (truncated - ask the AI or narrow the query)"
		end
		if detail.open then
			streamLabel(detail.resultLabel, resultText)
		else
			detail.resultLabel.Text = resultText
		end
		typeOutRow(handle.row, function(reveal, done)
			return rowRichText(handle.op, handle.desc, COLORS_HEX.live, done and (tostring(ms) .. " ms") or nil, reveal)
		end, utf8Len(handle.desc), function()
			dotsDetach(handle.dots)
			tween(handle.tick, { BackgroundColor3 = COLORS.live, BackgroundTransparency = 0 }, 0.2)
		end)
		handle.detail.resultLabel.TextColor3 = COLORS.textDim
	else
		resultText = tostring(envelope.error or "")
		if #resultText &gt; 900 then
			resultText = truncateBytes(resultText, 900) .. "…"
		end
		detail.resultLabel.TextColor3 = COLORS.err
		detail.openPanel()
		streamLabel(detail.resultLabel, resultText)
		-- A failed row opens its own detail, but the panel is inserted *inside*
		-- the row, so it can never draw over the header or the turn label.
		typeOutRow(handle.row, function(reveal, done)
			return rowRichText(handle.op, handle.desc, COLORS_HEX.err, nil, reveal)
		end, utf8Len(handle.desc), function()
			dotsDetach(handle.dots)
			tween(handle.tick, { BackgroundColor3 = COLORS.err, BackgroundTransparency = 0 }, 0.2)
		end)
	end
	for _, p in ipairs(extractPaths(handle.args, envelope)) do
		detail.addChip(p)
	end
	chatScroll()
end

-- Mirror a finished row into the saved history. Stored compactly: the rendered
-- text is rebuilt from these fields on restore.
local function recordRow(handle, envelope)
	pushEvent({
		k = "tool",
		op = tostring(handle.op),
		d = handle.desc,
		a = handle.argsJson,
		ok = envelope.ok ~= false,
		ms = tonumber(envelope.meta and envelope.meta.durationMs) or 0,
		r = envelope.ok and "" or tostring(envelope.error or ""),
		p = extractPaths(handle.args, envelope),
	})
end

local MAX_JSON_DEPTH = 8
local MAX_JSON_ITEMS = 300
local instanceRecord

function instanceRecord(inst)
 local record = nil
 local ok = pcall(function()
 record = {
 type = "Instance",
 ref = makeRef(inst),
 name = inst.Name,
 className = inst.ClassName,
 path = slashPath(inst),
 fullName = inst:GetFullName(),
 children = #inst:GetChildren(),
 }
 end)
 if ok and record ~= nil then
 return record
 end
 return { type = "Instance", name = tostring(inst) }
end

local function jsonSafe(value, depth)
 depth = depth or 1
 local t = typeof(value)
 if value == nil then
 return nil
 end
 if t == "boolean" then
 return value
 end
 if t == "number" then
 if value ~= value or value == math.huge or value == -math.huge then
 return { type = "number", value = tostring(value) }
 end
 return value
 end
 if t == "string" then
 return value
 end
 if t == "Instance" then
 return instanceRecord(value)
 end
 if t == "table" then
 if depth &gt; MAX_JSON_DEPTH then
 return { ["__truncated"] = "max depth reached" }
 end
 local count = 0
 for _ in pairs(value) do
 count = count + 1
 end
 local out = {}
 if count &gt; 0 and #value == count then

 for i, item in ipairs(value) do
 if i &gt; MAX_JSON_ITEMS then
 out[i] = { ["__truncated"] = true }
 break
 end
 local safe = jsonSafe(item, depth + 1)
 if safe ~= nil then
 out[i] = safe
 end
 end
 else

 local inserted = 0
 for key, item in pairs(value) do
 if inserted &gt;= MAX_JSON_ITEMS then
 out["__truncated"] = true
 break
 end
 local safeKey = (type(key) == "string") and key or tostring(key)
 local safe = jsonSafe(item, depth + 1)
 if safe ~= nil then
 out[safeKey] = safe
 inserted = inserted + 1
 end
 end
 end
 return out
 end
 if t == "Vector3" then
 return { type = "Vector3", x = value.X, y = value.Y, z = value.Z }
 end
 if t == "Vector2" then
 return { type = "Vector2", x = value.X, y = value.Y }
 end
 if t == "CFrame" then
 local ok, comps = pcall(function()
 return { value:GetComponents() }
 end)
 if ok and type(comps) == "table" then
 return { type = "CFrame", components = comps }
 end
 return { type = "CFrame", position = { x = value.X, y = value.Y, z = value.Z } }
 end
 if t == "Color3" then
 return {
 type = "Color3",
 r = value.R, g = value.G, b = value.B,
 hex = string.format("#%02X%02X%02X",
 math.floor(value.R * 255 + 0.5),
 math.floor(value.G * 255 + 0.5),
 math.floor(value.B * 255 + 0.5)),
 }
 end
 if t == "UDim" then
 return { type = "UDim", scale = value.Scale, offset = value.Offset }
 end
 if t == "UDim2" then
 return { type = "UDim2", xScale = value.X.Scale, xOffset = value.X.Offset, yScale = value.Y.Scale, yOffset = value.Y.Offset }
 end
 if t == "EnumItem" then
 return { type = "EnumItem", enum = tostring(value.EnumType), name = value.Name, value = value.Value }
 end
 if t == "BrickColor" then
 return { type = "BrickColor", name = value.Name }
 end
 if t == "NumberRange" then
 return { type = "NumberRange", min = value.Min, max = value.Max }
 end
 if t == "NumberSequence" then
 local keypoints = {}
 for i, kp in ipairs(value.Keypoints) do
 keypoints[i] = { time = kp.Time, value = kp.Value, envelope = kp.Envelope }
 end
 return { type = "NumberSequence", keypoints = keypoints }
 end
 if t == "ColorSequence" then
 local keypoints = {}
 for i, kp in ipairs(value.Keypoints) do
 keypoints[i] = { time = kp.Time, color = { r = kp.Value.R, g = kp.Value.G, b = kp.Value.B } }
 end
 return { type = "ColorSequence", keypoints = keypoints }
 end
 if t == "Rect" then
 return { type = "Rect", minX = value.Min.X, minY = value.Min.Y, maxX = value.Max.X, maxY = value.Max.Y }
 end
 if t == "Ray" then
 return { type = "Ray", origin = { x = value.Origin.X, y = value.Origin.Y, z = value.Origin.Z }, direction = { x = value.Direction.X, y = value.Direction.Y, z = value.Direction.Z } }
 end
 if t == "DateTime" then
 return { type = "DateTime", unix = value.UnixTimestamp }
 end
 if t == "PhysicalProperties" then
 return {
 type = "PhysicalProperties",
 density = value.Density, friction = value.Friction,
 elasticity = value.Elasticity, frictionWeight = value.FrictionWeight,
 elasticityWeight = value.ElasticityWeight,
 }
 end
 if t == "Font" then
 return { type = "Font", family = value.Family, weight = tostring(value.Weight), style = tostring(value.Style) }
 end

 local ok, s = pcall(tostring, value)
 return { type = t, value = ok and s or "&lt;unprintable&gt;" }
end

local function parseEnum(s)
 local category, name = string.match(tostring(s), "^Enum%.([%w_]+)%.([%w_]+)$")
 if category == nil then
 category, name = string.match(tostring(s), "^([%w_]+)%.([%w_]+)$")
 end
 if category ~= nil and name ~= nil then
 local ok, result = pcall(function()
 return Enum[category][name]
 end)
 if ok then
 return result
 end
 end
 return nil, "invalid enum reference: " .. tostring(s)
end

local function deserializeValue(v, keyName)
 local t = typeof(v)
 if t == "table" then
 local tag = v["type"]
 if tag == nil then
 return v
 elseif tag == "Instance" then
 return resolveStrict(v.ref or v.path or v.fullName)
 elseif tag == "Vector3" then
 return Vector3.new(v.x or 0, v.y or 0, v.z or 0)
 elseif tag == "Vector2" then
 return Vector2.new(v.x or 0, v.y or 0)
 elseif tag == "Color3" then
 if type(v.hex) == "string" then
 local r, g, b = string.match(v.hex, "^#?(%x%x)(%x%x)(%x%x)$")
 if r ~= nil then
 return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
 end
 end
 return Color3.new(v.r or 0, v.g or 0, v.b or 0)
 elseif tag == "CFrame" then
 if type(v.components) == "table" then
 return CFrame.new(table.unpack(v.components))
 end
 local pos = nil
 if type(v.position) == "table" then
 pos = Vector3.new(v.position.x or 0, v.position.y or 0, v.position.z or 0)
 end

 local ori = v.orientation or v.rotation
 if type(ori) == "table" then
 local rot = CFrame.fromOrientation(math.rad(ori.x or 0), math.rad(ori.y or 0), math.rad(ori.z or 0))
 if pos ~= nil then
 return CFrame.new(pos) * rot
 end
 return rot
 end
 if pos ~= nil and type(v.lookAt) == "table" then
 return CFrame.lookAt(pos,
 Vector3.new(v.lookAt.x or 0, v.lookAt.y or 0, v.lookAt.z or 0))
 end
 if pos ~= nil then
 return CFrame.new(pos)
 end
 return CFrame.new(v.x or 0, v.y or 0, v.z or 0)
 elseif tag == "UDim" then
 return UDim.new(v.scale or 0, v.offset or 0)
 elseif tag == "UDim2" then
 return UDim2.new(v.xScale or 0, v.xOffset or 0, v.yScale or 0, v.yOffset or 0)
 elseif tag == "Enum" or tag == "EnumItem" then
 local e = parseEnum(v.name or v.enum)
 if e == nil and type(v.enum) == "string" and type(v.name) == "string" then
 e = parseEnum(v.enum .. "." .. v.name)
 end
 if e == nil then
 error("invalid enum value for property " .. tostring(keyName), 0)
 end
 return e
 elseif tag == "NumberRange" then
 return NumberRange.new(v.min or 0, v.max or 0)
 elseif tag == "NumberSequence" then
 if type(v.keypoints) == "table" then
 local kps = {}
 for i, kp in ipairs(v.keypoints) do
 kps[i] = NumberSequenceKeypoint.new(kp.time or 0, kp.value or 0, kp.envelope or 0)
 end
 return NumberSequence.new(kps)
 end
 return NumberSequence.new(v.value or 0)
 elseif tag == "ColorSequence" then
 if type(v.keypoints) == "table" then
 local kps = {}
 for i, kp in ipairs(v.keypoints) do
 local c = kp.color or {}
 kps[i] = ColorSequenceKeypoint.new(kp.time or 0, Color3.new(c.r or 0, c.g or 0, c.b or 0))
 end
 return ColorSequence.new(kps)
 end
 return ColorSequence.new(Color3.new(1, 1, 1))
 elseif tag == "Rect" then
 return Rect.new(v.minX or 0, v.minY or 0, v.maxX or 0, v.maxY or 0)
 elseif tag == "BrickColor" then
 return BrickColor.new(tostring(v.name or "Medium stone grey"))
 elseif tag == "Ray" then
 return Ray.new(
 Vector3.new((v.origin or {}).x or 0, (v.origin or {}).y or 0, (v.origin or {}).z or 0),
 Vector3.new((v.direction or {}).x or 0, (v.direction or {}).y or 0, (v.direction or {}).z or 0)
 )
 elseif tag == "DateTime" then
 return DateTime.fromUnixTimestamp(v.unix or 0)
 elseif tag == "PhysicalProperties" then
 return PhysicalProperties.new(v.density or 0.7, v.friction or 0.3, v.elasticity or 0.5, v.frictionWeight or 1, v.elasticityWeight or 1)
 end
 error(string.format("unsupported type '%s' for property '%s' (the marker key is \"type\" - $ keys cannot travel through the bridge)", tostring(tag), tostring(keyName)), 0)
 elseif t == "string" then
 if string.sub(v, 1, 5) == "Enum." then
 local e, err = parseEnum(v)
 if e == nil then
 error(tostring(err), 0)
 end
 return e
 end
 if string.sub(v, 1, 2) == "I:" or string.sub(v, 1, 4) == "ref:" then
 local p = (string.sub(v, 1, 4) == "ref:") and string.sub(v, 5) or v
 return resolveStrict(p)
 end
 if keyName == "Color" or keyName == "Color3" or keyName == "BackgroundColor3" or keyName == "TextColor3" then
 local r, g, b = string.match(v, "^#?(%x%x)(%x%x)(%x%x)$")
 if r == nil then
 local s1, s2, s3 = string.match(v, "^#?(%x)(%x)(%x)$")
 if s1 ~= nil then
 r, g, b = s1 .. s1, s2 .. s2, s3 .. s3
 end
 end
 if r ~= nil then
 return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
 end
 end
 return v
 end
 return v
end

local function setProps(inst, props)
 if type(props) ~= "table" then
 error("props must be a table of {propertyName = value}", 0)
 end

 local ORDER = { "Size", "CFrame", "Position", "Orientation", "Rotation" }
 local pending = {}
 for key, value in pairs(props) do
 pending[tostring(key)] = value
 end
 local applied = {}
 local function apply(name)
 local rawValue = pending[name]
 if rawValue == nil then
 return
 end
 pending[name] = nil
 local value = deserializeValue(rawValue, name)
 local ok, err = pcall(function()
 inst[name] = value
 end)
 if not ok then
 error(string.format("failed to set %s.%s = %s: %s",
 inst:GetFullName(), name, tostring(rawValue), tostring(err)), 0)
 end
 table.insert(applied, name)
 end
 for _, name in ipairs(ORDER) do
 apply(name)
 end
 local rest = {}
 for name in pairs(pending) do
 table.insert(rest, name)
 end
 table.sort(rest)
 for _, name in ipairs(rest) do
 apply(name)
 end
 return applied
end

local COMMON_PROPERTIES = {
 "Name", "ClassName", "Parent",
 "Anchored", "CanCollide", "CanTouch", "CanQuery", "CastShadow", "Massless",
 "Material", "Transparency", "Reflectance", "Size", "Position", "CFrame",
 "Color", "Shape", "CollisionGroup", "TopSurface", "BottomSurface",
 "PrimaryPart", "ModelStreamingMode", "LevelOfDetail",
 "Orientation", "Rotation", "PivotOffset",
 "Value",
 "Text", "RichText", "Font", "TextSize", "TextColor3", "TextTransparency",
 "TextWrapped", "TextXAlignment", "BackgroundColor3", "BackgroundTransparency",
 "BorderSizePixel", "Visible", "ZIndex", "ClipsDescendants",
 "Image", "ImageColor3", "ImageTransparency", "ScaleType",
 "SoundId", "Volume", "Looped", "PlaybackSpeed", "TimePosition", "Playing",
 "WalkSpeed", "JumpPower", "JumpHeight", "Health", "MaxHealth", "DisplayName", "HipHeight",
 "RunContext", "Enabled", "Disabled",
 "MeshId", "TextureId", "Scale", "VertexColor",
 "AssetId", "Tags",
}

local function readProperties(inst, requested)
 local names = {}
 for _, n in ipairs(COMMON_PROPERTIES) do
 table.insert(names, n)
 end
 if type(requested) == "table" then
 for _, n in ipairs(requested) do
 table.insert(names, tostring(n))
 end
 end
 local out = {}
 for _, name in ipairs(names) do
 if name ~= "Source" then
 local value = nil
 local ok = pcall(function()
 value = inst[name]
 end)
 if ok and value ~= nil then
 out[name] = jsonSafe(value)
 end
 end
 end
 local okTags, tags = pcall(function()
 return inst:GetTags()
 end)
 if okTags and type(tags) == "table" then
 out.tags = tags
 end
 return out
end

local function getScriptSource(inst)
 if not inst:IsA("LuaSourceContainer") then
 return nil, nil
 end
 local ok, source = pcall(function()
 return inst.Source
 end)
 if not ok then
 return nil, tostring(source)
 end
 return source, nil
end

-- Ops call this to name the change they are about to make. The command runner
-- already opened a ChangeHistoryService recording around the call, so this only
-- relabels that recording - it never drops a second, half-empty waypoint.
local function waypoint(label)
 if recordingDepth &gt; 0 then
 recordingLabel = tostring(label or "Golem")
 end
end

local http

local OPS = {}

function OPS.ping()
 return {
 ok = true,
 plugin = PLUGIN_TITLE,
 version = VERSION,
 studio = STUDIO_VERSION,
 uptimeSeconds = math.floor(os.clock() - state.startedAt + 0.5),
 placeName = game.Name,
 placeId = game.PlaceId,
 gameId = game.GameId,
 features = { marketplace = "agent-side", playtest = true, screenshot = true, input = true, transport = bridge.mode },
 }
end

function OPS.setup()
	error("the 'setup' op was retired - use a v4+ golem-bridge CLI and the setup line from the Golem window", 0)
end

local function getPivotCFrame(inst)
 if inst:IsA("BasePart") then
 return inst.CFrame
 elseif inst:IsA("Model") then
 return inst:GetPivot()
 end
 return nil
end

local function setPivotCFrame(inst, cf)
 if inst:IsA("BasePart") then
 inst.CFrame = cf
 elseif inst:IsA("Model") then
 inst:PivotTo(cf)
 end
end

function OPS.rotate(args)
 local targets = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(targets, p)
 end
 elseif args.path ~= nil then
 table.insert(targets, args.path)
 end
 if #targets == 0 then
 error("args.path (or args.paths) is required", 0)
 end

 local function rotatedRecords()
 local out = {}
 for _, p in ipairs(targets) do
 local inst = resolveStrict(p)
 table.insert(out, { path = slashPath(inst), className = inst.ClassName })
 end
 return out
 end

 local function notRotatable(inst)
 return string.format("%s is a %s - rotation needs a BasePart or a Model",
 inst:GetFullName(), inst.ClassName)
 end

 local setTo = args.orientation or args.set
 if setTo ~= nil then
 if type(setTo) ~= "table" then
 error("args.orientation must be {x=,y=,z=} in degrees", 0)
 end
 local rx = tonumber(setTo.x) or 0
 local ry = tonumber(setTo.y) or 0
 local rz = tonumber(setTo.z) or 0
 for _, p in ipairs(targets) do
 local inst = resolveStrict(p)
 local cf = getPivotCFrame(inst)
 if cf == nil then
 error(notRotatable(inst), 0)
 end
 setPivotCFrame(inst, CFrame.new(cf.Position)
 * CFrame.fromOrientation(math.rad(rx), math.rad(ry), math.rad(rz)))
 end
 waypoint("rotate")
 return { rotated = rotatedRecords(), count = #targets, mode = "set",
 orientation = { x = rx, y = ry, z = rz } }
 end

 local space = string.lower(tostring(args.space or "world"))
 if space ~= "world" and space ~= "local" then
 error("args.space must be 'world' (default) or 'local'", 0)
 end
 local degrees = tonumber(args.degrees) or tonumber(args.angle)
 if degrees == nil then
 error("provide args.degrees + args.axis (relative) or args.orientation (absolute)", 0)
 end
 local axis = args.axis
 local axisVec, axisLabel
 if type(axis) == "string" then
 local name = string.lower(axis)
 if name == "x" or name == "right" then
 axisVec, axisLabel = Vector3.new(1, 0, 0), name
 elseif name == "y" or name == "up" then
 axisVec, axisLabel = Vector3.new(0, 1, 0), name
 elseif name == "z" or name == "forward" or name == "look" then
 axisVec, axisLabel = Vector3.new(0, 0, -1), name
 end
 elseif type(axis) == "table" then
 axisVec = Vector3.new(tonumber(axis.x) or 0, tonumber(axis.y) or 0, tonumber(axis.z) or 0)
 axisLabel = string.format("{%.2f,%.2f,%.2f}", axisVec.X, axisVec.Y, axisVec.Z)
 end
 if axisVec == nil or axisVec.Magnitude == 0 then
 error('args.axis is required: "x"/"y"/"z"/"up"/"right"/"forward" or {x=,y=,z=}', 0)
 end
 axisVec = axisVec.Unit
 for _, p in ipairs(targets) do
 local inst = resolveStrict(p)
 local cf = getPivotCFrame(inst)
 if cf == nil then
 error(notRotatable(inst), 0)
 end
 local rot = CFrame.fromAxisAngle(axisVec, math.rad(degrees))
 if space == "local" then

 setPivotCFrame(inst, cf * rot)
 else

 local pos = cf.Position
 setPivotCFrame(inst, CFrame.new(pos) * rot * CFrame.new(-pos) * cf)
 end
 end
 waypoint("rotate")
 return { rotated = rotatedRecords(), count = #targets, mode = "add",
 space = space, axis = axisLabel, degrees = degrees }
end

function OPS.face(args)
 local inst = resolveStrict(args.path)
 local cf = getPivotCFrame(inst)
 if cf == nil then
 error(string.format("%s is a %s - face needs a BasePart or a Model",
 inst:GetFullName(), inst.ClassName), 0)
 end
 local axisName = string.lower(tostring(args.axis or "forward"))
 if axisName == "forward" or axisName == "look" or axisName == "z" then
 axisName = "forward"
 elseif axisName == "up" or axisName == "y" then
 axisName = "up"
 elseif axisName == "right" or axisName == "x" then
 axisName = "right"
 else
 error('args.axis must be "forward" (default), "up" or "right"', 0)
 end
 local dir
 if type(args.target) == "table" then
 dir = Vector3.new(tonumber(args.target.x) or 0, tonumber(args.target.y) or 0, tonumber(args.target.z) or 0) - cf.Position
 elseif type(args.direction) == "table" then
 dir = Vector3.new(tonumber(args.direction.x) or 0, tonumber(args.direction.y) or 0, tonumber(args.direction.z) or 0)
 else
 error("args.target {x,y,z} (a world point) or args.direction {x,y,z} is required", 0)
 end
 if dir.Magnitude &lt; 1e-6 then
 error("direction is zero-length", 0)
 end
 dir = dir.Unit
 local base = CFrame.lookAt(cf.Position, cf.Position + dir)
 local newCf = base
 if axisName == "up" then
 newCf = base * CFrame.Angles(math.rad(-90), 0, 0)
 elseif axisName == "right" then
 newCf = base * CFrame.Angles(0, math.rad(90), 0)
 end
 setPivotCFrame(inst, newCf)
 waypoint("face")
 return { path = slashPath(inst), axis = axisName,
 facing = { x = dir.X, y = dir.Y, z = dir.Z } }
end

function OPS.shift(args)
 local targets = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(targets, p)
 end
 elseif args.path ~= nil then
 table.insert(targets, args.path)
 end
 if #targets == 0 then
 error("args.path (or args.paths) is required", 0)
 end
 local off = args.offset
 if type(off) ~= "table" then
 error("args.offset {x=,y=,z} is required (studs)", 0)
 end
 local v = Vector3.new(tonumber(off.x) or 0, tonumber(off.y) or 0, tonumber(off.z) or 0)
 if v.Magnitude == 0 then
 error("offset is zero", 0)
 end
 local space = string.lower(tostring(args.space or "world"))
 if space ~= "world" and space ~= "local" then
 error("args.space must be 'world' (default) or 'local'", 0)
 end
 local moved = {}
 for _, p in ipairs(targets) do
 local inst = resolveStrict(p)
 local cf = getPivotCFrame(inst)
 if cf == nil then
 error(string.format("%s is a %s - shift needs a BasePart or a Model",
 inst:GetFullName(), inst.ClassName), 0)
 end
 local delta = (space == "local") and cf:VectorToWorldSpace(v) or v
 setPivotCFrame(inst, cf + delta)
 table.insert(moved, slashPath(inst))
 end
 waypoint("shift")
 return { moved = moved, count = #moved, offset = { x = v.X, y = v.Y, z = v.Z }, space = space }
end

function OPS.scale(args)
 local factor = tonumber(args.factor)
 if factor == nil or factor &lt;= 0 then
 error("args.factor (a positive number, relative multiplier) is required", 0)
 end
 local inst = resolveStrict(args.path)
 if inst:IsA("Model") then
 local current = 1
 pcall(function()
 current = inst:GetScale()
 end)
 inst:ScaleTo(current * factor)
 elseif inst:IsA("BasePart") then
 inst.Size = inst.Size * factor
 else
 error(string.format("%s is a %s - scale needs a BasePart or a Model",
 inst:GetFullName(), inst.ClassName), 0)
 end
 waypoint("scale")
 return { path = slashPath(inst), factor = factor }
end

function OPS.duplicate(args)
 local inst = resolveStrict(args.path)
 local count = math.clamp(tonumber(args.count) or 1, 1, 200)
 local offset = Vector3.zero
 if type(args.offset) == "table" then
 offset = Vector3.new(tonumber(args.offset.x) or 0, tonumber(args.offset.y) or 0, tonumber(args.offset.z) or 0)
 end
 local parent = (args.parent ~= nil) and resolveStrict(args.parent) or inst.Parent
 local baseName = tostring(args.name or inst.Name)
 local copies = {}
 for i = 1, count do
 local clone = inst:Clone()
 clone.Name = (count &gt; 1) and (baseName .. " " .. tostring(i)) or baseName
 if offset.Magnitude &gt; 0 then
 local cf = getPivotCFrame(inst)
 if cf ~= nil then
 setPivotCFrame(clone, cf + offset * i)
 end
 end
 clone.Parent = parent
 table.insert(copies, instanceRecord(clone))
 end
 waypoint("duplicate")
 return { count = count, copies = copies, parent = slashPath(parent) }
end

function OPS.group(args)
 if type(args.paths) ~= "table" or #args.paths == 0 then
 error("args.paths (an array of paths/refs) is required", 0)
 end
 local first = resolveStrict(args.paths[1])
 local parent = (args.parent ~= nil) and resolveStrict(args.parent) or first.Parent
 if args.parent ~= nil then
 for _, p in ipairs(args.paths) do
 local member = resolveStrict(p)
 if parent == member or parent:IsDescendantOf(member) then
 error("args.parent must not be one of the grouped instances or inside one of them", 0)
 end
 end
 end
 local model = Instance.new("Model")
 model.Name = tostring(args.name or "Group")
 local members = {}
 for _, p in ipairs(args.paths) do
 local inst = resolveStrict(p)
 table.insert(members, slashPath(inst))
 inst.Parent = model
 end
 model.Parent = parent
 pcall(function()
 model.WorldPivot = model:GetBoundingBox()
 end)
 waypoint("group")
 local record = instanceRecord(model)
 record.members = members
 return record
end

function OPS.set_pivot(args)
 local inst = resolveStrict(args.path)
 local current
 local okRead = pcall(function()
 current = inst.WorldPivot
 end)
 if not okRead or current == nil then
 error(inst:GetFullName() .. " has no pivot", 0)
 end
 local pos, ori = args.position, args.orientation
 if pos == nil and ori == nil then
 error("args.position and/or args.orientation {x,y,z} required (orientation in degrees)", 0)
 end
 local newCf
 if type(pos) == "table" then
 newCf = CFrame.new(tonumber(pos.x) or 0, tonumber(pos.y) or 0, tonumber(pos.z) or 0)
 else
 newCf = CFrame.new(current.Position)
 end
 if type(ori) == "table" then
 newCf = newCf * CFrame.fromOrientation(
 math.rad(tonumber(ori.x) or 0),
 math.rad(tonumber(ori.y) or 0),
 math.rad(tonumber(ori.z) or 0))
 else
 newCf = newCf * (current - current.Position)
 end
 local ok, err = pcall(function()
 inst.WorldPivot = newCf
 end)
 if not ok then
 error("could not set pivot: " .. tostring(err), 0)
 end
 waypoint("pivot " .. slashPath(inst))
 return { path = slashPath(inst),
 pivot = { position = { x = newCf.Position.X, y = newCf.Position.Y, z = newCf.Position.Z } } }
end

function OPS.terrain(args)
 local terrain = workspace.Terrain
 local action = string.lower(tostring(args.action or "fill"))
 if action ~= "fill" and action ~= "clear" then
 error('args.action must be "fill" or "clear" (clear = fill with Air)', 0)
 end
 local shape = string.lower(tostring(args.shape or "block"))
 local pos = args.position or args.center
 if type(pos) ~= "table" then
 error("args.position {x,y,z} is required", 0)
 end
 local center = Vector3.new(tonumber(pos.x) or 0, tonumber(pos.y) or 0, tonumber(pos.z) or 0)
 local material = Enum.Material.Air
 if action == "fill" then
 local matName = tostring(args.material or "Grass")
 local parsed = parseEnum(matName)
 if parsed == nil then
 parsed = parseEnum("Enum.Material." .. matName)
 end
 if parsed == nil then
 error("unknown material '" .. matName .. "' (e.g. Grass, Rock, Sand, Water, Wood)", 0)
 end
 material = parsed
 end
 if shape == "block" then
 local size = args.size
 if type(size) ~= "table" then
 error("args.size {x,y,z} is required for shape=block", 0)
 end
 terrain:FillBlock(center,
 Vector3.new(tonumber(size.x) or 1, tonumber(size.y) or 1, tonumber(size.z) or 1), material)
 elseif shape == "ball" then
 local radius = tonumber(args.radius)
 if radius == nil then
 error("args.radius is required for shape=ball", 0)
 end
 terrain:FillBall(center, radius, material)
 else
 error('args.shape must be "block" or "ball"', 0)
 end
 waypoint("terrain " .. action .. " " .. shape)
 return { action = action, shape = shape, material = tostring(material),
 position = { x = center.X, y = center.Y, z = center.Z } }
end

function OPS.run(args)
 if loadstring == nil then
 error("loadstring is not available in this context", 0)
 end
 local code = args.code
 if type(code) ~= "string" or #code == 0 then
 error("args.code (a string of Lua) is required", 0)
 end
 local chunk, compileError = loadstring(code, "=ai-bridge-run")
 if chunk == nil then
 error("Lua compile error: " .. tostring(compileError), 0)
 end
 local results = table.pack(pcall(chunk))
 if results[1] ~= true then
 error("runtime error: " .. tostring(results[2]), 0)
 end
 local returned = results.n - 1
 local values = {}
 for i = 1, math.min(returned, 12) do
 local safe = jsonSafe(results[i + 1])
 if safe == nil then
 safe = { type = "nil" }
 end
 table.insert(values, safe)
 end
 if returned &gt; 12 then
 table.insert(values, { ["__note"] = string.format("...%d more return values truncated", returned - 12) })
 end
 return { returnCount = returned, values = values }
end

function OPS.list(args)
 local inst = resolveStrict(args.path or "game")
 local record = instanceRecord(inst)
 if args.recursive == true then
 local max = math.min(tonumber(args.max) or 500, 5000)
 local all = inst:GetDescendants()
 local descendants = {}
 for i = 1, math.min(#all, max) do
 table.insert(descendants, instanceRecord(all[i]))
 end
 record.descendantCount = #all
 record.truncated = (#all &gt; max)
 record.descendants = descendants
 else
 local children = {}
 for _, child in ipairs(inst:GetChildren()) do
 table.insert(children, instanceRecord(child))
 end
 record.children = children
 end
 return record
end

function OPS.tree(args)
 local rootInst = resolveStrict(args.path or "game")
 local depth = math.clamp(tonumber(args.depth) or 2, 0, 12)
 local maxChildren = math.clamp(tonumber(args.maxChildren) or 50, 1, 500)
 local maxNodes = math.clamp(tonumber(args.maxNodes) or 600, 1, 5000)
 local nodeCount = 0
 local truncated = false

 local function build(inst, remainingDepth)
 nodeCount = nodeCount + 1
 local node = instanceRecord(inst)
 if remainingDepth &gt; 0 then
 local children = inst:GetChildren()
 if #children &gt; maxChildren then
 node.childCount = #children
 end
 node.children = {}
 for i, child in ipairs(children) do
 if i &gt; maxChildren or nodeCount &gt;= maxNodes then
 truncated = true
 break
 end
 table.insert(node.children, build(child, remainingDepth - 1))
 end
 end
 return node
 end

 local tree = build(rootInst, depth)
 return { path = slashPath(rootInst), depth = depth, truncated = truncated, nodeCount = nodeCount, tree = tree }
end

function OPS.read(args)
 local inst = resolveStrict(args.path)
 local record = instanceRecord(inst)
 local source, sourceErr = getScriptSource(inst)
 if source ~= nil then
 record.source = source
 record.sourceLineCount = select(2, string.gsub(source, "\n", "")) + 1
 elseif sourceErr ~= nil then
 record.sourceError = sourceErr
 end
 local okAttrs, attrs = pcall(inst.GetAttributes, inst)
 if okAttrs and type(attrs) == "table" then
 local safe = {}
 for k, v in pairs(attrs) do
 safe[tostring(k)] = jsonSafe(v)
 end
 record.attributes = safe
 end
 record.properties = readProperties(inst, args.props)
 return record
end

function OPS.create(args)
 local class = args.class
 if type(class) ~= "string" or #class == 0 then
 error("args.class is required (e.g. 'Script', 'ModuleScript', 'Folder', 'Part')", 0)
 end
 if args.parent == nil then
 error("args.parent is required (path or ref of the parent, e.g. 'ServerStorage')", 0)
 end
 local okNew, instOrErr = pcall(Instance.new, class)
 if not okNew or instOrErr == nil then
 error(string.format("cannot create Instance of class '%s': %s", class, tostring(instOrErr)), 0)
 end
 local inst = instOrErr
 if args.name ~= nil then
 if string.find(tostring(args.name), "/", 1, true) ~= nil then
 error("names must not contain '/' (it is the path separator)", 0)
 end
 inst.Name = tostring(args.name)
 end
 if args.source ~= nil then
 local okSrc, errSrc = pcall(function()
 inst.Source = tostring(args.source)
 end)
 if not okSrc then
 error(string.format(
 "failed to set Source on the new %s (only Script/LocalScript/ModuleScript have Source): %s",
 class, tostring(errSrc)), 0)
 end
 end
 if args.props ~= nil then
 setProps(inst, args.props)
 end
 if type(args.position) == "table" then
 local okPos, errPos = pcall(function()
 inst.Position = Vector3.new(
 tonumber(args.position.x) or 0,
 tonumber(args.position.y) or 0,
 tonumber(args.position.z) or 0)
 end)
 if not okPos then
 error("could not set position on a " .. class .. ": " .. tostring(errPos), 0)
 end
 end
 if type(args.orientation) == "table" then

 local okOri, errOri = pcall(function()
 inst.Orientation = Vector3.new(
 tonumber(args.orientation.x) or 0,
 tonumber(args.orientation.y) or 0,
 tonumber(args.orientation.z) or 0)
 end)
 if not okOri then
 error("could not set orientation on a " .. class .. " (parts/models only): " .. tostring(errOri), 0)
 end
 end
 inst.Parent = resolveStrict(args.parent)
 waypoint("create " .. class .. " " .. inst.Name)
 local record = instanceRecord(inst)
 record.created = true
 return record
end

function OPS.write(args)
 local inst = resolveStrict(args.path)
 if args.source ~= nil then
 local okSrc, errSrc = pcall(function()
 inst.Source = tostring(args.source)
 end)
 if not okSrc then
 error(string.format("failed to set Source on %s (%s): %s",
 inst:GetFullName(), inst.ClassName, tostring(errSrc)), 0)
 end
 end
 local applied = {}
 if args.props ~= nil then
 applied = setProps(inst, args.props)
 end
 waypoint("write " .. inst:GetFullName())
 local record = instanceRecord(inst)
 record.updated = true
 record.propertiesApplied = applied
 return record
end

function OPS.script(args)

 local parentInst = resolveStrict(args.parent or "game")
 local name = args.name
 if type(name) ~= "string" or #name == 0 then
 error("args.name is required (the script's name)", 0)
 end
 if string.find(name, "/", 1, true) ~= nil then
 error("names must not contain '/' (it is the path separator)", 0)
 end
 local class = args.class or "Script"
 if class ~= "Script" and class ~= "LocalScript" and class ~= "ModuleScript" then
 error("args.class must be Script, LocalScript, or ModuleScript", 0)
 end
 local mode = args.mode or "create"
 if mode ~= "create" and mode ~= "update" and mode ~= "replace" then
 error("args.mode must be create, update, or replace", 0)
 end
 if type(args.source) ~= "string" then
 error("args.source (the full Lua source) is required", 0)
 end
 local existing = parentInst:FindFirstChild(name)
 if existing ~= nil and mode == "create" then
 error(string.format("'%s' already exists under %s (use mode=update or mode=replace)",
 name, slashPath(parentInst)), 0)
 end
 local inst
 local created = true
 if existing ~= nil and mode == "update" then
 if not (existing:IsA("Script") or existing:IsA("LocalScript") or existing:IsA("ModuleScript")) then
 error(string.format("%s is a %s, not a script", slashPath(existing), existing.ClassName), 0)
 end
 inst = existing
 created = false
 else
 if existing ~= nil then
 existing:Destroy()
 end
 inst = Instance.new(class)
 inst.Name = name
 inst.Parent = parentInst
 end
 local okSrc, errSrc = pcall(function()
 inst.Source = args.source
 end)
 if not okSrc then
 error(string.format("failed to set Source on %s: %s", slashPath(inst), tostring(errSrc)), 0)
 end
 waypoint("script " .. slashPath(inst))
 local record = instanceRecord(inst)
 record.created = created
 record.mode = mode
 return record
end

function OPS.delete(args)
 local targets = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(targets, p)
 end
 elseif args.path ~= nil then
 table.insert(targets, args.path)
 end
 if #targets == 0 then
 error("provide args.path (string) or args.paths (array of paths/refs)", 0)
 end
 local doomed = {}
 for _, p in ipairs(targets) do
 table.insert(doomed, resolveStrict(p))
 end
 local deleted = {}
 for _, inst in ipairs(doomed) do
 table.insert(deleted, inst:GetFullName())
 inst:Destroy()
 end
 waypoint("delete")
 return { deleted = deleted, count = #deleted }
end

function OPS.move(args)
 if args.path == nil or args.parent == nil then
 error("args.path and args.parent are both required", 0)
 end
 local inst = resolveStrict(args.path)
 local parent = resolveStrict(args.parent)
 inst.Parent = parent
 waypoint("move " .. inst.Name)
 local record = instanceRecord(inst)
 record.moved = true
 return record
end

function OPS.find(args)
 if type(args.tag) == "string" and #args.tag &gt; 0 then

 local scope = resolveStrict(args.scope or "game")
 local scopeRoot = slashPath(scope)
 local prefix = scopeRoot .. "/"
 local max = math.min(tonumber(args.max) or 200, 2000)
 local matches = {}
 local tagTruncated = false
 for _, inst in ipairs(CollectionService:GetTagged(args.tag)) do
 local p = slashPath(inst)
 if p == scopeRoot or string.sub(p, 1, #prefix) == prefix then
 table.insert(matches, { path = p, className = inst.ClassName })
 if #matches &gt;= max then
 tagTruncated = true
 break
 end
 end
 end
 return { query = "#" .. args.tag, scope = scopeRoot, count = #matches, truncated = tagTruncated, results = matches }
 end
 local query = args.query
 if type(query) ~= "string" or #query == 0 then
 error("args.query is required (substring of an instance name)", 0)
 end
 local scope = resolveStrict(args.scope or "game")
 local classFilter = args.class
 if type(classFilter) == "string" and #classFilter &gt; 0 then
 local okClass = pcall(function()
 return scope:IsA(classFilter)
 end)
 if not okClass then
 error(string.format("unknown class '%s'", classFilter), 0)
 end
 end
 local max = math.min(tonumber(args.max) or 200, 2000)
 local exact = args.exact == true
 local caseSensitive = args.caseSensitive == true
 local needle = caseSensitive and query or string.lower(query)

 local function nameMatches(name)
 local n = caseSensitive and name or string.lower(name)
 if exact then
 return n == needle
 end
 return string.find(n, needle, 1, true) ~= nil
 end

 local matches = {}
 local truncated = false
 for _, desc in ipairs(scope:GetDescendants()) do
 if nameMatches(desc.Name) then
 local classOk = true
 if classFilter ~= nil then
 local ok = false
 pcall(function()
 ok = desc:IsA(classFilter)
 end)
 classOk = ok
 end
 if classOk then
 table.insert(matches, instanceRecord(desc))
 if #matches &gt;= max then
 truncated = true
 break
 end
 end
 end
 end
 return { query = query, scope = slashPath(scope), count = #matches, truncated = truncated, results = matches }
end

function OPS.grep(args)
 local pattern = args.pattern
 if type(pattern) ~= "string" or #pattern == 0 then
 error("args.pattern is required", 0)
 end
 local plain = args.plain ~= false
 local caseSensitive = args.caseSensitive ~= false
 local scope = resolveStrict(args.scope or "game")
 local max = math.min(tonumber(args.max) or 100, 1000)
 local needle = caseSensitive and pattern or string.lower(pattern)

 local function lineMatches(line)
 local hay = caseSensitive and line or string.lower(line)
 if plain then
 return string.find(hay, needle, 1, true) ~= nil
 end
 return string.find(hay, needle) ~= nil
 end

 local matches = {}
 local truncated = false
 for _, desc in ipairs(scope:GetDescendants()) do
 if truncated then
 break
 end
 local isScript = false
 pcall(function()
 isScript = desc:IsA("LuaSourceContainer")
 end)
 if isScript then
 local okSrc, source = pcall(function()
 return desc.Source
 end)
 if okSrc and type(source) == "string" then
 local lineNo = 0
 local text = source
 if string.sub(text, -1) ~= "\n" then
 text = text .. "\n"
 end
 for line in string.gmatch(text, "(.-)\r?\n") do
 lineNo = lineNo + 1
 if lineMatches(line) then
 table.insert(matches, {
 path = slashPath(desc),
 fullName = desc:GetFullName(),
 name = desc.Name,
 line = lineNo,
 text = line,
 })
 if #matches &gt;= max then
 truncated = true
 break
 end
 end
 end
 end
 end
 end
 return { pattern = pattern, scope = slashPath(scope), count = #matches, truncated = truncated, matches = matches }
end

local function hexToColor(value)

 local hex = string.gsub(tostring(value), "^#", "")
 if #hex == 3 then
 hex = string.sub(hex, 1, 1) .. string.sub(hex, 1, 1)
 .. string.sub(hex, 2, 2) .. string.sub(hex, 2, 2)
 .. string.sub(hex, 3, 3) .. string.sub(hex, 3, 3)
 end
 if #hex ~= 6 or string.match(hex, "%X") ~= nil then
 error(string.format("bad color '%s' - use #RRGGBB", tostring(value)), 0)
 end
 return Color3.fromRGB(
 tonumber(string.sub(hex, 1, 2), 16),
 tonumber(string.sub(hex, 3, 4), 16),
 tonumber(string.sub(hex, 5, 6), 16))
end

local function vfxColor(value, fallback)
 if type(value) == "string" and #value &gt; 0 then
 return hexToColor(value)
 end
 return fallback
end

function OPS.beam(args)

 local fromInst = resolveStrict(args.from)
 local toInst = resolveStrict(args.to)
 if not fromInst:IsA("BasePart") or not toInst:IsA("BasePart") then
 error("args.from and args.to must both be parts", 0)
 end
 local color = vfxColor(args.color, Color3.fromRGB(120, 180, 255))
 local width = tonumber(args.width) or 0.4
 local a0 = fromInst:FindFirstChild("BeamAttachment0")
 if a0 == nil or not a0:IsA("Attachment") then
 a0 = Instance.new("Attachment")
 a0.Name = "BeamAttachment0"
 a0.Parent = fromInst
 end
 local a1 = toInst:FindFirstChild("BeamAttachment1")
 if a1 == nil or not a1:IsA("Attachment") then
 a1 = Instance.new("Attachment")
 a1.Name = "BeamAttachment1"
 a1.Parent = toInst
 end
 local beam = fromInst:FindFirstChild(args.name or "Beam")
 if beam == nil or not beam:IsA("Beam") then
 beam = Instance.new("Beam")
 beam.Name = args.name or "Beam"
 beam.Parent = fromInst
 end
 beam.Attachment0 = a0
 beam.Attachment1 = a1
 beam.Color = ColorSequence.new(color)
 beam.Width0 = width
 beam.Width1 = width
 beam.Transparency = NumberSequence.new(0.2)
 beam.LightEmission = 1
 beam.FaceCamera = true
 beam.Segments = 12
 local curve = tonumber(args.curve) or 0
 beam.CurveSize0 = curve
 beam.CurveSize1 = curve
 beam.Parent = fromInst
 waypoint("beam " .. slashPath(fromInst))
 return { beam = slashPath(beam), from = slashPath(fromInst), to = slashPath(toInst), width = width }
end

function OPS.trail(args)

 local inst = resolveStrict(args.path)
 if not inst:IsA("BasePart") then
 error("args.path must be a BasePart to trail behind", 0)
 end
 local color = vfxColor(args.color, Color3.fromRGB(255, 255, 255))
 local lifetime = tonumber(args.lifetime) or 0.6
 local half = math.max(inst.Size.Y, inst.Size.Z) / 2
 local a0 = inst:FindFirstChild("TrailAttachment0")
 if a0 == nil or not a0:IsA("Attachment") then
 a0 = Instance.new("Attachment")
 a0.Name = "TrailAttachment0"
 a0.Parent = inst
 end
 a0.Position = Vector3.new(0, half, 0)
 local a1 = inst:FindFirstChild("TrailAttachment1")
 if a1 == nil or not a1:IsA("Attachment") then
 a1 = Instance.new("Attachment")
 a1.Name = "TrailAttachment1"
 a1.Parent = inst
 end
 a1.Position = Vector3.new(0, -half, 0)
 local trail = inst:FindFirstChild(args.name or "Trail")
 if trail == nil or not trail:IsA("Trail") then
 trail = Instance.new("Trail")
 trail.Name = args.name or "Trail"
 trail.Parent = inst
 end
 trail.Attachment0 = a0
 trail.Attachment1 = a1
 trail.Lifetime = lifetime
 trail.Color = ColorSequence.new(color)
 trail.LightEmission = 0.8
 trail.FaceCamera = true
 trail.Transparency = NumberSequence.new({
 NumberSequenceKeypoint.new(0, 0.3),
 NumberSequenceKeypoint.new(1, 1),
 })
 trail.Parent = inst
 waypoint("trail " .. slashPath(inst))
 return { trail = slashPath(trail), path = slashPath(inst), lifetime = lifetime }
end

function OPS.explosion(args)

 local pos = Vector3.new(0, 10, 0)
 if type(args.position) == "table" then
 pos = Vector3.new(tonumber(args.position.x) or 0,
 tonumber(args.position.y) or 10, tonumber(args.position.z) or 0)
 end
 local boom = Instance.new("Explosion")
 boom.Position = pos
 boom.BlastRadius = tonumber(args.radius) or 8
 boom.BlastPressure = 0
 boom.DestroyJointRadiusPercent = 0
 boom.Parent = workspace
 task.delay(2, function()
 if boom ~= nil and boom.Parent ~= nil then
 boom:Destroy()
 end
 end)
 waypoint("explosion")
 return { position = { x = pos.X, y = pos.Y, z = pos.Z }, radius = boom.BlastRadius, harmless = true }
end

local UI_FONTS = {
 regular = Enum.Font.Gotham,
 medium = Enum.Font.GothamMedium,
 semibold = Enum.Font.GothamBold,
 bold = Enum.Font.GothamBold,
 mono = Enum.Font.Code,
}

local function uiName(args)
 local n = args.name
 if type(n) ~= "string" or #n == 0 then
 error("args.name is required", 0)
 end
 if string.find(n, "/", 1, true) then
 error("names cannot contain '/' (it would break Golem paths)", 0)
 end
 return n
end

local function parseUDim2Arg(value, fallback)
 if value == nil then
 return fallback
 end
 local parts = {}
 for token in string.gmatch(tostring(value), "[^,]+") do
 table.insert(parts, tonumber(token))
 end
 if #parts ~= 4 or parts[1] == nil or parts[2] == nil or parts[3] == nil or parts[4] == nil then
 error(string.format("bad UDim2 '%s' - use 'xscale,xoffset,yscale,yoffset', e.g. 0.5,0,0.5,0", tostring(value)), 0)
 end
 return UDim2.new(parts[1], parts[2], parts[3], parts[4])
end

local function parseAnchor(value)
 if value == nil then
 return Vector2.new(0, 0)
 end
 local ax, ay = string.match(tostring(value), "^%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)%s*$")
 if ax == nil then
 error(string.format("bad anchor '%s' - use 'x,y', e.g. 0.5,0.5", tostring(value)), 0)
 end
 local nx, ny = tonumber(ax), tonumber(ay)
 if nx == nil or ny == nil then
 error(string.format("bad anchor '%s' - use 'x,y', e.g. 0.5,0.5", tostring(value)), 0)
 end
 return Vector2.new(nx, ny)
end

function OPS.ui_screen(args)

 local name = uiName(args)
 local parent
 if args.parent ~= nil then
 parent = resolveStrict(args.parent)
 else
 parent = game:GetService("StarterGui")
 end
 local guiInst = Instance.new("ScreenGui")
 guiInst.Name = name
 guiInst.ResetOnSpawn = false
 guiInst.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
 guiInst.DisplayOrder = tonumber(args.order) or 0
 guiInst.Parent = parent
 waypoint("ui_screen " .. name)
 return { screen = slashPath(guiInst), parent = slashPath(parent) }
end

function OPS.ui_frame(args)

 local parent = resolveStrict(args.parent)
 local name = uiName(args)
 local frameInst = Instance.new("Frame")
 frameInst.Name = name
 frameInst.BackgroundColor3 = vfxColor(args.color, Color3.fromRGB(28, 30, 38))
 frameInst.BorderSizePixel = 0
 frameInst.BackgroundTransparency = tonumber(args.transparency) or 0
 frameInst.Position = parseUDim2Arg(args.position, UDim2.new(0, 0, 0, 0))
 frameInst.Size = parseUDim2Arg(args.size, UDim2.new(1, 0, 1, 0))
 frameInst.AnchorPoint = parseAnchor(args.anchor)
 frameInst.ClipsDescendants = (args.clip == true)
 local corner = Instance.new("UICorner")
 corner.CornerRadius = UDim.new(0, tonumber(args.radius) or 8)
 corner.Parent = frameInst
 frameInst.Parent = parent
 waypoint("ui_frame " .. slashPath(frameInst))
 return { frame = slashPath(frameInst), parent = slashPath(parent) }
end

function OPS.ui_label(args)

 local parent = resolveStrict(args.parent)
 local name = uiName(args)
 local labelInst = Instance.new("TextLabel")
 labelInst.Name = name
 labelInst.BackgroundTransparency = 1
 labelInst.Font = UI_FONTS[string.lower(tostring(args.font or "medium"))] or Enum.Font.GothamMedium
 labelInst.Text = tostring(args.text or "")
 labelInst.TextSize = tonumber(args.text_size) or 16
 labelInst.TextColor3 = vfxColor(args.color, Color3.fromRGB(242, 242, 247))
 local align = string.lower(tostring(args.align or "left"))
 if align == "center" or align == "centre" then
 labelInst.TextXAlignment = Enum.TextXAlignment.Center
 elseif align == "right" then
 labelInst.TextXAlignment = Enum.TextXAlignment.Right
 end
 labelInst.TextWrapped = (args.wrap == true)
 if args.wrap == true then
 labelInst.AutomaticSize = Enum.AutomaticSize.Y
 end
 labelInst.Position = parseUDim2Arg(args.position, UDim2.new(0, 0, 0, 0))
 labelInst.Size = parseUDim2Arg(args.size, UDim2.new(1, 0, 0, 20))
 labelInst.Parent = parent
 waypoint("ui_label " .. slashPath(labelInst))
 return { label = slashPath(labelInst) }
end

function OPS.ui_button(args)

 local parent = resolveStrict(args.parent)
 local name = uiName(args)
 local buttonInst = Instance.new("TextButton")
 buttonInst.Name = name
 buttonInst.Font = UI_FONTS[string.lower(tostring(args.font or "semibold"))] or Enum.Font.GothamBold
 buttonInst.Text = tostring(args.text or "Button")
 buttonInst.TextSize = tonumber(args.text_size) or 16
 buttonInst.TextColor3 = vfxColor(args.text_color, Color3.fromRGB(255, 255, 255))
 buttonInst.BackgroundColor3 = vfxColor(args.color, Color3.fromRGB(64, 72, 92))
 buttonInst.BorderSizePixel = 0
 buttonInst.AutoButtonColor = true
 buttonInst.Position = parseUDim2Arg(args.position, UDim2.new(0, 0, 0, 0))
 buttonInst.Size = parseUDim2Arg(args.size, UDim2.new(1, 0, 0, 40))
 buttonInst.AnchorPoint = parseAnchor(args.anchor)
 local corner = Instance.new("UICorner")
 corner.CornerRadius = UDim.new(0, tonumber(args.radius) or 8)
 corner.Parent = buttonInst
 buttonInst.Parent = parent
 waypoint("ui_button " .. slashPath(buttonInst))
 return { button = slashPath(buttonInst) }
end

function OPS.ui_input(args)

 local parent = resolveStrict(args.parent)
 local name = uiName(args)
 local inputInst = Instance.new("TextBox")
 inputInst.Name = name
 inputInst.Font = Enum.Font.Gotham
 inputInst.Text = tostring(args.text or "")
 inputInst.PlaceholderText = tostring(args.placeholder or "")
 inputInst.PlaceholderColor3 = Color3.fromRGB(140, 140, 150)
 inputInst.TextSize = tonumber(args.text_size) or 16
 inputInst.TextColor3 = vfxColor(args.color, Color3.fromRGB(242, 242, 247))
 inputInst.BackgroundColor3 = vfxColor(args.background, Color3.fromRGB(18, 19, 24))
 inputInst.BorderSizePixel = 0
 inputInst.ClearTextOnFocus = false
 inputInst.TextXAlignment = Enum.TextXAlignment.Left
 inputInst.Position = parseUDim2Arg(args.position, UDim2.new(0, 0, 0, 0))
 inputInst.Size = parseUDim2Arg(args.size, UDim2.new(1, 0, 0, 36))
 local corner = Instance.new("UICorner")
 corner.CornerRadius = UDim.new(0, tonumber(args.radius) or 8)
 corner.Parent = inputInst
 inputInst.Parent = parent
 waypoint("ui_input " .. slashPath(inputInst))
 return { input = slashPath(inputInst) }
end

function OPS.ui_image(args)

 local parent = resolveStrict(args.parent)
 local name = uiName(args)
 local id = tonumber(args.asset) or tonumber(string.match(tostring(args.asset or ""), "(%d+)"))
 if id == nil then
 error("args.asset (the asset id, e.g. 487667385) is required", 0)
 end
 local imageInst = Instance.new("ImageLabel")
 imageInst.Name = name
 imageInst.BackgroundTransparency = 1
 imageInst.Image = "rbxassetid://" .. id
 local scaleTypes = {
 fit = Enum.ScaleType.Fit,
 stretch = Enum.ScaleType.Stretch,
 tile = Enum.ScaleType.Tile,
 crop = Enum.ScaleType.Crop,
 slice = Enum.ScaleType.Slice,
 }
 local scaleName = string.lower(tostring(args.scale or "fit"))
 if scaleTypes[scaleName] == nil then
 error('args.scale must be one of: fit, stretch, tile, crop, slice (got "' .. tostring(args.scale) .. '")', 0)
 end
 imageInst.ScaleType = scaleTypes[scaleName]
 imageInst.Position = parseUDim2Arg(args.position, UDim2.new(0, 0, 0, 0))
 imageInst.Size = parseUDim2Arg(args.size, UDim2.new(1, 0, 1, 0))
 imageInst.Parent = parent
 waypoint("ui_image " .. slashPath(imageInst))
 return { image = slashPath(imageInst), asset = id }
end

function OPS.ui_list(args)

 local parent = resolveStrict(args.parent)
 local listLayout = parent:FindFirstChild("UIListLayout")
 if listLayout == nil then
 listLayout = Instance.new("UIListLayout")
 end
 listLayout.Name = "UIListLayout"
 listLayout.SortOrder = Enum.SortOrder.LayoutOrder
 listLayout.FillDirection = (string.lower(tostring(args.direction or "vertical")) == "horizontal")
 and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
 listLayout.Padding = UDim.new(0, tonumber(args.padding) or 8)
 local h = string.lower(tostring(args.halign or ""))
 if h == "center" or h == "centre" then
 listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
 elseif h == "right" then
 listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
 end
 local v = string.lower(tostring(args.valign or ""))
 if v == "middle" or v == "center" then
 listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
 elseif v == "bottom" then
 listLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
 end
 listLayout.Parent = parent
 waypoint("ui_list " .. slashPath(parent))
 return { layout = slashPath(listLayout), parent = slashPath(parent) }
end

local executeCommand
-- ---------------------------------------------------------------- transport
-- The relay. This plugin can only make outgoing calls, and the AI driving it
-- may be a cloud sandbox that cannot reach this computer, so both sides meet at
-- a Firebase Realtime Database:
--
--   channels/&lt;id&gt;/cmd       the AI's commands land here; we poll, run, delete
--   channels/&lt;id&gt;/res       our results go here; the AI reads its own id
--   channels/&lt;id&gt;/beacons   hello / revoked, so `golem-bridge status` can tell
--                           "Studio is closed" from "that line is from an old
--                           session"
--   channels/&lt;id&gt;/guest/*   the play-test driver's private request/reply lane
--
-- The channel id is the whole capability. It is minted per Studio session, so a
-- line pasted into a chat is worthless once that session ends.

local generation = 0

-- Ops that make sense while the game is running. Everything else edits the
-- place, which must not happen against a live session.
local PLAY_SAFE = {
	ping = true, debug = true, stop = true, playstate = true, screenshot = true,
	logs = true, click = true, input = true, look_through = true, play = true,
}

-- Firebase caps a write around 1 MB; stay well under it so a big reply becomes a
-- clear error instead of an opaque HTTP 400.
local RELAY_MAX_RESULT = 900000
-- A single command may run for at most this long before the loop gives up on it.
local COMMAND_TIMEOUT_SECONDS = 180

-- Results that could not be published yet (relay throttling, network blip).
-- They are retried in order; a command must never look like it did nothing.
local pendingResults = {}

local function relayPublish(env)
	-- Roblox's JSONEncode is not always re-entrant on deep tables, and the AI
	-- side expects a plain string for anything big, so pack the result once.
	if type(env.result) == "table" and not env.resultEncoded then
		local okPack, packed = pcall(function()
			return HttpService:JSONEncode(sanitizeEnvelope(env.result, 0))
		end)
		if okPack and type(packed) == "string" then
			env.resultEncoded = true
			env.result = packed
		end
	end
	local body = encodeBody(env)
	if body == nil then
		return nil, "could not encode the result"
	end
	if #body &gt; RELAY_MAX_RESULT then
		env = {
			id = env.id,
			ok = false,
			v = VERSION,
			error = string.format(
				"the result was %d KB - too large to send from Studio. Narrow the query (path, scope, max, depth) and retry.",
				math.floor(#body / 1024)),
		}
		body = encodeBody(env) or "{}"
	end
	return request({
		url = resUrl() .. ".json",
		method = "POST",
		body = body,
		headers = { ["Content-Type"] = "application/json" },
	})
end

-- Keep the result lane short: the AI polls it, so old replies only cost time.
local function relayTrimRes()
	task.spawn(function()
		local resp = request({ url = resUrl() .. ".json?shallow=true" })
		if resp == nil then
			return
		end
		local keys = decodeBody(resp)
		if type(keys) ~= "table" then
			return
		end
		local sorted = {}
		for key in pairs(keys) do
			table.insert(sorted, key)
		end
		if #sorted &lt;= 15 then
			return
		end
		table.sort(sorted)
		for i = 1, #sorted - 15 do
			pcall(function()
				request({ url = resUrl() .. "/" .. sorted[i] .. ".json", method = "DELETE" })
			end)
		end
	end)
end

local function relayDeliver(env)
	local resp, err = relayPublish(env)
	if resp == nil then
		if #pendingResults &lt; 25 then
			table.insert(pendingResults, { env = env, fails = 0 })
		end
		state.publishError = tostring(err)
		log("relay: result publish failed: " .. tostring(err))
	else
		state.publishError = nil
		relayTrimRes()
	end
	updateStatus()
	return resp ~= nil
end

local function relayFlushPending()
	while #pendingResults &gt; 0 do
		local pending = pendingResults[1]
		local resp, err = relayPublish(pending.env)
		if resp ~= nil then
			table.remove(pendingResults, 1)
			state.publishError = nil
		elseif string.find(tostring(err), "HTTP 429", 1, true) then
			state.publishError = tostring(err) .. " (relay is throttling; results are queued)"
			updateStatus()
			return
		else
			pending.fails = (pending.fails or 0) + 1
			if pending.fails &gt;= 2 then
				if pending.env.id ~= nil and not pending.swapped then
					-- The command ran; only the reply could not travel. Say so, or
					-- the AI will retry an edit that already happened.
					pending.swapped = true
					pending.fails = 0
					pending.env = {
						id = pending.env.id,
						ok = false,
						v = VERSION,
						error = string.format(
							"the command ran, but its result could not reach the relay (%s). Confirm the change with `list`/`read` before repeating it.",
							tostring(err)),
					}
				else
					table.remove(pendingResults, 1)
					log("relay: dropped an undeliverable result: " .. tostring(err))
				end
			end
		end
		task.wait(0.5)
	end
	updateStatus()
end

local function relayBeaconPost(channelId, env)
	if type(channelId) ~= "string" or #channelId &lt; 8 then
		return
	end
	pcall(function()
		local body = encodeBody(env)
		if body ~= nil then
			request({
				url = beaconUrl(channelId) .. ".json",
				method = "POST",
				body = body,
				headers = { ["Content-Type"] = "application/json" },
			})
		end
	end)
	-- keep the last few beacons only
	task.spawn(function()
		local resp = request({ url = beaconUrl(channelId) .. ".json?shallow=true" })
		if resp == nil then
			return
		end
		local keys = decodeBody(resp)
		if type(keys) ~= "table" then
			return
		end
		local sorted = {}
		for key in pairs(keys) do
			table.insert(sorted, key)
		end
		if #sorted &lt;= 5 then
			return
		end
		table.sort(sorted)
		for i = 1, #sorted - 5 do
			pcall(function()
				request({ url = beaconUrl(channelId) .. "/" .. sorted[i] .. ".json", method = "DELETE" })
			end)
		end
	end)
end

local function relayBeacon(op, extra)
	local env = { op = op, v = VERSION, ts = os.time() }
	if type(extra) == "table" then
		for key, value in pairs(extra) do
			env[key] = value
		end
	end
	relayBeaconPost(bridge.channel, env)
	bridge.beaconSentAt = os.clock()
end

-- Wipe a channel and tell anyone listening on it that it is gone, so a stale
-- setup line in a chat produces "ask for a fresh line" instead of silence.
local function relayRetireChannel(channelId)
	if type(channelId) ~= "string" or #channelId &lt; 8 then
		return
	end
	relayBeaconPost(channelId, { op = "revoked", v = VERSION, ts = os.time() })
	task.spawn(function()
		pcall(function()
			request({ url = FIREBASE_DB .. "/channels/" .. channelId .. ".json", method = "DELETE" })
		end)
	end)
end

local function relayHandleMessage(cmd)
	if type(cmd) ~= "table" then
		log("relay: ignored a non-object on the command channel")
		return
	end
	if cmd.id == nil or type(cmd.op) ~= "string" then
		if cmd.id ~= nil then
			relayDeliver({ id = cmd.id, ok = false, error = "a command needs a string 'op' and an 'id'" })
		else
			log("relay: ignored a command without an id")
		end
		return
	end
	state.commandsServed = state.commandsServed + 1
	if not RunService:IsEdit() and not PLAY_SAFE[cmd.op] then
		relayDeliver({
			id = cmd.id,
			op = cmd.op,
			ok = false,
			v = VERSION,
			error = "the game is running - `stop` the play test before editing the place (screenshot, click, input, logs, and playstate work while it runs)",
		})
		return
	end
	-- Every command of one AI request carries the same token, so a new token
	-- means a new request: the turn opens right now and the first tool of that
	-- request already lands in its own turn.
	local turnToken = nil
	if type(cmd.args) == "table" and type(cmd.args.__turn) == "string" and #cmd.args.__turn &gt; 0 then
		turnToken = cmd.args.__turn
		cmd.args.__turn = nil
	end
	if turnToken ~= nil then
		beginTurnFor(turnToken)
	end
	local envelopeTurn = turnNumber
	local chatRow = nil
	if cmd.op ~= "ping" and cmd.op ~= "screenshot" and cmd.op ~= "play" and cmd.op ~= "stop" then
		chatRow = addChatCommand(cmd.op, cmd.args)
		envelopeTurn = turnNumber
	end

	local envelope = nil
	local finished = false
	task.spawn(function()
		if chatRow ~= nil then
			task.wait()
		end
		envelope = executeCommand(cmd)
		finished = true
	end)
	local startedAt = os.time()
	while not finished and os.time() - startedAt &lt; COMMAND_TIMEOUT_SECONDS do
		task.wait(0.1)
	end
	if not finished then
		envelope = {
			id = cmd.id,
			op = cmd.op,
			ok = false,
			v = VERSION,
			error = string.format(
				"'%s' did not finish within %d s - it may be stuck. Restarting Studio clears stuck ops.",
				tostring(cmd.op), COMMAND_TIMEOUT_SECONDS),
		}
	end
	envelope = envelope or { id = cmd.id, ok = false, op = cmd.op, error = "the command returned no result" }
	envelope.v = VERSION
	envelope.turn = envelopeTurn
	envelope.turnTools = currentTurn ~= nil and currentTurn.count or 0
	if chatRow ~= nil then
		finishRow(chatRow, envelope)
		recordRow(chatRow, envelope)
	end
	if envelope.ok then
		log(string.format("OK %s (%s ms)", tostring(cmd.op),
			tostring(envelope.meta and envelope.meta.durationMs or "?")))
	else
		state.errors = state.errors + 1
		log(string.format("ERR %s: %s", tostring(cmd.op), tostring(envelope.error)))
	end
	relayDeliver(envelope)
end

-- One poll: ask only for keys newer than the last one we handled, so a chatty
-- channel never costs a growing download.
local function pollOnce()
	local query = ".json?orderBy=" .. HttpService:UrlEncode('"$key"') .. "&amp;limitToLast=25"
	if bridge.lastMessageKey ~= nil then
		query = query .. "&amp;startAt=" .. HttpService:UrlEncode('"' .. bridge.lastMessageKey .. '"')
	end
	local resp, err = request({ url = cmdUrl() .. query })
	if resp == nil then
		return nil, tostring(err)
	end
	bridge.okStreak = bridge.okStreak + 1
	if bridge.okStreak &gt;= 12 then
		-- quiet and healthy: back the cadence off to the floor
		bridge.interval = math.max(2, bridge.interval - 1)
		bridge.okStreak = 0
	end
	setConnected(true, nil)
	local body = resp.Body
	if type(body) ~= "string" or #body == 0 or body == "null" then
		return true, nil
	end
	local data = decodeBody(resp)
	if type(data) ~= "table" then
		return true, nil
	end
	local keys = {}
	for key in pairs(data) do
		table.insert(keys, key)
	end
	table.sort(keys)
	local skipped = 0
	for _, key in ipairs(keys) do
		local cmd = data[key]
		if key ~= bridge.lastMessageKey then
			local isOld = type(cmd) == "table" and type(cmd.ts) == "number" and cmd.ts &lt; bridge.skipBefore
			if type(cmd) == "table" and not isOld then
				local okHandle, errHandle = pcall(relayHandleMessage, cmd)
				if not okHandle then
					state.errors = state.errors + 1
					log("relay: command '" .. tostring(cmd.op) .. "' crashed: " .. tostring(errHandle))
					if cmd.id ~= nil then
						pcall(function()
							relayDeliver({
								id = cmd.id,
								ok = false,
								op = tostring(cmd.op),
								error = "plugin internal error, command dropped: " .. tostring(errHandle),
							})
						end)
					end
				end
			else
				skipped = skipped + 1
			end
			-- Always consume the key, even a skipped one, so the loop moves on.
			pcall(function()
				request({ url = cmdUrl() .. "/" .. key .. ".json", method = "DELETE" })
			end)
		end
		bridge.lastMessageKey = key
	end
	if skipped &gt; 0 then
		log("relay: ignored " .. skipped .. " command(s) left over from before this session started")
	end
	return true, nil
end

-- The polling loop. Runs for the life of the plugin. During a play test it keeps
-- polling: the screen, input, and log tools still have to reach us, and the
-- in-game driver needs its lane served.
local function relayLoop(myGeneration)
	log(string.format("relay: live on channel %s (every ~%ds)", tostring(bridge.channel), bridge.interval))
	while myGeneration == generation do
		relayFlushPending()
		local ok, err = pollOnce()
		if ok then
			bridge.lastError = nil
			bridge.lastPollAt = os.clock()
			task.wait(bridge.interval)
		else
			local e = tostring(err)
			bridge.lastError = e
			bridge.okStreak = 0
			ensureHttpEnabled()
			setConnected(false, e)
			if string.find(e, "HTTP 429", 1, true) then
				bridge.interval = math.min(bridge.interval * 2 + 1, 25)
				log(string.format("relay: rate limited - polling every %ds now", bridge.interval))
			elseif string.find(e, "Http requests are not enabled", 1, true) then
				bridge.interval = 10
			else
				bridge.interval = 2
			end
			task.wait(math.max(1, bridge.interval / 2))
		end
	end
end

local function startBridge()
	ensureHttpEnabled()
	ensureIdentity()
	if bridge.previousChannel ~= nil then
		local old = bridge.previousChannel
		bridge.previousChannel = nil
		relayRetireChannel(old)
	end
	generation = generation + 1
	state.running = true
	bridge.mode = "relay"
	-- Ignore anything that was already sitting in the channel before this
	-- session began: a queued command from a dead Studio must never run here.
	bridge.skipBefore = os.time() - 45
	bridge.lastMessageKey = nil
	task.spawn(relayLoop, generation)
	if RunService:IsEdit() then
		relayBeacon("hello", { place = game.PlaceId })
	end
	updateStatus()
end

local function promptRefresh()
	if ui.setupBox ~= nil then
		ui.setupBox.Text = setupCommandText()
	end
	if ui.settingsSetupBox ~= nil then
		ui.settingsSetupBox.Text = setupCommandText()
	end
end

local function applyModeToUi()
	promptRefresh()
	updateStatus()
end
-- ------------------------------------------------------- in-session driver
-- Source for the two scripts injected for the duration of a play test. They are
-- plain Roblox scripts (they run inside the game, not as plugins), so they can
-- use CaptureService and UserInputService:CreateVirtualInput() - the same APIs
-- Studio's own playtest automation uses. They never touch anything outside the
-- test session and are destroyed as soon as it starts.

local GUEST_TEMPLATE = [==[
-- Golem's play-test driver. It lives inside the running test session only, for
-- the length of that session, and speaks to the same relay channel the plugin
-- uses. Its own request/reply lane keeps it out of the command path, so a slow
-- screenshot can never block the AI's editing tools.
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CaptureService = game:GetService("CaptureService")
local AssetService = game:GetService("AssetService")

local ROLE = "@ROLE@"
local RELAY = "@RELAY@"
local CHANNEL = "@CHANNEL@"

local BASE = RELAY .. "/channels/" .. CHANNEL .. "/guest/" .. ROLE

local function send(url, method, body)
  local ok, response = pcall(function()
    return HttpService:RequestAsync({
      Url = url,
      Method = method,
      Body = body,
      Headers = { ["Content-Type"] = "application/json", ["Accept"] = "application/json" },
      Compress = Enum.HttpCompression.None,
    })
  end)
  if not ok then
    return nil, tostring(response)
  end
  if not response.Success then
    return nil, string.format("HTTP %d %s", response.StatusCode, tostring(response.Body or ""))
  end
  return response
end

local function decode(response)
  if response == nil or type(response.Body) ~= "string" or #response.Body == 0 then
    return nil
  end
  local ok, data = pcall(function()
    return HttpService:JSONDecode(response.Body)
  end)
  if not ok then
    return nil
  end
  return data
end

-- Publish a frame for the plugin to pick up on its next poll.
local function post(kind, payload)
  local body = HttpService:JSONEncode(payload)
  return send(BASE .. "/" .. kind .. ".json", "POST", body)
end

local function answer(commandId, result)
  result.id = commandId
  post("res", result)
end

local function readCommands()
  local listing = decode(send(BASE .. "/cmd.json?shallow=true", "GET"))
  if type(listing) ~= "table" then
    return {}
  end
  local keys = {}
  for key in pairs(listing) do
    table.insert(keys, key)
  end
  table.sort(keys)
  local out = {}
  for _, key in ipairs(keys) do
    local entry = decode(send(BASE .. "/cmd/" .. key .. ".json", "GET"))
    -- claim it before running it: a second read must never repeat the input
    send(BASE .. "/cmd/" .. key .. ".json", "DELETE")
    if type(entry) == "table" then
      table.insert(out, entry)
    end
  end
  return out
end

-- Pointer/keyboard helper. VirtualInput is the supported path; the older
-- VirtualInputManager is only used if the Studio build predates it.
local function getVirtualInput()
  local ok, input = pcall(function()
    return UserInputService:CreateVirtualInput()
  end)
  if ok and input ~= nil then
    return { kind = "VirtualInput", handle = input }
  end
  local okManager, manager = pcall(function()
    return game:GetService("VirtualInputManager")
  end)
  if okManager and manager ~= nil then
    return { kind = "VirtualInputManager", handle = manager }
  end
  return nil
end

local KEY_ALIASES = {
  [" "] = "Space", enter = "Return", esc = "Escape", ctrl = "LeftControl",
  shift = "LeftShift", alt = "LeftAlt", tab = "Tab", backspace = "Backspace",
}

local function keyCodeFor(name)
  local text = tostring(name or "")
  if #text == 1 then
    text = string.upper(text)
  end
  text = KEY_ALIASES[string.lower(text)] or text
  local ok, code = pcall(function()
    return Enum.KeyCode[text]
  end)
  if not ok or code == nil then
    return nil
  end
  return code
end

local function pressKey(vim, name)
  local code = keyCodeFor(name)
  if code == nil then
    return false, "unknown key '" .. tostring(name) .. "'"
  end
  if vim.kind == "VirtualInput" then
    pcall(function()
      vim.handle:SendKey(true, code)
      task.wait(0.03)
      vim.handle:SendKey(false, code)
    end)
    return true
  end
  pcall(function()
    vim.handle:SendKeyEvent(true, code, false, game)
    task.wait(0.03)
    vim.handle:SendKeyEvent(false, code, false, game)
  end)
  return true
end

local function clickAt(vim, x, y, holdSeconds)
  local point = Vector2.new(x, y)
  if vim.kind == "VirtualInput" then
    pcall(function()
      vim.handle:SendMousePosition(point)
      vim.handle:SendMouseButton(point, Enum.UserInputType.MouseButton1, true)
      task.wait(holdSeconds or 0.06)
      vim.handle:SendMouseButton(point, Enum.UserInputType.MouseButton1, false)
    end)
    return true
  end
  pcall(function()
    vim.handle:SendMouseMoveEvent(x, y, game)
    vim.handle:SendMouseButtonEvent(x, y, 1, true, game, 0)
    task.wait(holdSeconds or 0.06)
    vim.handle:SendMouseButtonEvent(x, y, 1, false, game, 0)
  end)
  return true
end

-- Crop + downscale RGBA into a PNG-friendly payload.
local function captureScreenshot(args)
  local maxWidth = tonumber(args and args.maxWidth) or 900
  local contentId = nil
  local finished = false
  CaptureService:CaptureScreenshot(function(id)
    contentId = id
    finished = true
  end)
  local started = os.clock()
  while not finished and os.clock() - started &lt; 8 do
    task.wait(0.1)
  end
  if contentId == nil then
    return { ok = false, error = "CaptureService did not hand back an image (is the viewport visible?)" }
  end
  local image = nil
  local okImage, errImage = pcall(function()
    image = AssetService:CreateEditableImageAsync(contentId)
  end)
  if not okImage or image == nil then
    return { ok = false, error = "could not read the capture: " .. tostring(errImage) }
  end
  local size = image.Size
  local scale = math.min(1, maxWidth / math.max(1, size.X))
  local width = math.max(8, math.floor(size.X * scale))
  local height = math.max(8, math.floor(size.Y * scale))
  local points = {}
  local opaque = 0
  local stepX = size.X / width
  local stepY = size.Y / height
  for y = 0, height - 1 do
    for x = 0, width - 1 do
      local okPixel, r, g, b, a = pcall(function()
        local px = image:ReadPixels(Vector2.new(math.floor(x * stepX), math.floor(y * stepY)), Vector2.new(1, 1))
        return px[1], px[2], px[3], px[4]
      end)
      if okPixel and r ~= nil then
        if (a or 1) &gt; 0.01 then
          opaque = opaque + 1
        end
        table.insert(points, string.format("%d,%d,%d,%d",
          math.floor((r or 0) * 255), math.floor((g or 0) * 255), math.floor((b or 0) * 255),
          math.floor((a or 1) * 255)))
      else
        table.insert(points, "0,0,0,0")
      end
    end
  end
  pcall(function()
    image:Destroy()
  end)
  return {
    ok = true,
    label = tostring(args and args.label or "viewport"),
    source = "play",
    width = width,
    height = height,
    format = "rgba-csv",
    pixels = table.concat(points, ";"),
    note = "captured from the running play session",
  }
end

local handlers = {}

handlers.hello = function()
  return {
    ok = true,
    role = ROLE,
    place = game.Name,
    play = RunService:IsRunning(),
    client = ROLE == "client",
    camera = workspace.CurrentCamera ~= nil,
  }
end

handlers.screenshot = function(args)
  return captureScreenshot(args)
end

handlers.click = function(args)
  local vim = getVirtualInput()
  if vim == nil then
    return { ok = false, error = "this Studio build has no virtual input API" }
  end
  local ok, err = clickAt(vim, tonumber(args.x), tonumber(args.y), tonumber(args.holdMs) and (tonumber(args.holdMs) / 1000))
  return { ok = ok, error = err, x = args.x, y = args.y, api = vim.kind }
end

handlers.input = function(args)
  local vim = getVirtualInput()
  if vim == nil then
    return { ok = false, error = "this Studio build has no virtual input API" }
  end
  local sent = {}
  if type(args.text) == "string" and #args.text &gt; 0 then
    if vim.kind == "VirtualInput" then
      pcall(function()
        vim.handle:SendTextInput(args.text)
      end)
    else
      for i = 1, #args.text do
        pcall(function()
          vim.handle:SendTextInputCharacterEvent(string.sub(args.text, i, i), game)
        end)
      end
    end
    table.insert(sent, "text")
  end
  local sequence = args.keys
  if type(sequence) == "string" then
    sequence = { sequence }
  end
  if type(sequence) == "table" then
    for _, key in ipairs(sequence) do
      local ok, err = pressKey(vim, key)
      if not ok then
        return { ok = false, error = err, sent = sent }
      end
      table.insert(sent, tostring(key))
      task.wait(tonumber(args.keyDelay) or 0.08)
    end
  end
  if type(args.hold) == "table" then
    local held = false
    for _, key in ipairs(args.hold) do
      local code = keyCodeFor(key)
      if code ~= nil then
        pcall(function()
          if vim.kind == "VirtualInput" then
            vim.handle:SendKey(true, code)
          else
            vim.handle:SendKeyEvent(true, code, false, game)
          end
        end)
        held = true
      end
    end
    if held then
      task.wait(math.clamp(tonumber(args.holdSeconds) or 1, 0.05, 10))
      for _, key in ipairs(args.hold) do
        local code = keyCodeFor(key)
        if code ~= nil then
          pcall(function()
            if vim.kind == "VirtualInput" then
              vim.handle:SendKey(false, code)
            else
              vim.handle:SendKeyEvent(false, code, false, game)
            end
          end)
        end
      end
    end
    table.insert(sent, "hold")
  end
  return { ok = true, sent = sent, api = vim.kind }
end

handlers.look_through = function(args)
  local target = nil
  for _, inst in ipairs(game:GetDescendants()) do
    if inst:GetFullName() == tostring(args.path) then
      target = inst
      break
    end
  end
  local camera = workspace.CurrentCamera
  if camera == nil or target == nil then
    return { ok = false, error = "target not found in the running session" }
  end
  local base
  if target:IsA("BasePart") then
    base = target.CFrame
  elseif target:IsA("Model") then
    base = target:GetPivot()
  end
  if base == nil then
    return { ok = false, error = "target is not a part or model" }
  end
  camera.CameraType = Enum.CameraType.Scriptable
  camera.CFrame = base * CFrame.new(0, 2, 6) * CFrame.Angles(0, math.rad(180), 0)
  return { ok = true, target = target:GetFullName() }
end

handlers.logs = function()
  local ok, history = pcall(function()
    return game:GetService("LogService"):GetLogHistory()
  end)
  if not ok or type(history) ~= "table" then
    return { ok = false, error = "no log access in this session" }
  end
  local entries = {}
  for _, entry in ipairs(history) do
    if type(entry) == "table" then
      local mtype = tostring(entry.messageType)
      if mtype == "Enum.MessageType.MessageError" or mtype == "Enum.MessageType.MessageWarning" then
        table.insert(entries, {
          type = mtype == "Enum.MessageType.MessageError" and "error" or "warning",
          message = tostring(entry.message or ""),
          timestamp = tonumber(entry.timestamp) or 0,
        })
      end
    end
  end
  return { ok = true, total = #entries, entries = entries, source = "play" }
end

-- Small command pump: between frames the driver asks the plugin for anything
-- queued for it, so input and capture feel immediate.
local function pump()
  for _, command in ipairs(readCommands()) do
    local handler = handlers[command.op]
    local ok, result = pcall(function()
      if handler == nil then
        return { ok = false, error = "unknown guest op " .. tostring(command.op) }
      end
      return handler(command.args or {})
    end)
    if not ok then
      result = { ok = false, error = tostring(result) }
    end
    if type(result) ~= "table" then
      result = { ok = false, error = "the handler returned no table" }
    end
    answer(command.id, result)
  end
end

task.spawn(function()
  while true do
    local ok = pcall(pump)
    task.wait(ok and (ROLE == "client" and 0.2 or 0.4) or 1)
  end
end)
post("hello", { ok = true, role = ROLE, play = RunService:IsRunning(), ts = os.time() })
]==]

local function buildGuestSource(role)
	local ok, source = pcall(function()
		local text = GUEST_TEMPLATE
		text = string.gsub(text, "@ROLE@", role)
		text = string.gsub(text, "@RELAY@", FIREBASE_DB)
		text = string.gsub(text, "@CHANNEL@", tostring(bridge.channel))
		return text
	end)
	if not ok then
		return nil
	end
	return source
end

-- Built when the play test starts, not when the plugin loads: the channel is
-- part of the driver's source and the channel can rotate any time.
local function guestSource(role)
	return buildGuestSource(role)
end
-- ------------------------------------------------------- play test plumbing
-- A plugin cannot see inside a running play session: play mode runs a copy of
-- the place. So Golem injects a small driver into the copy, starts a real test
-- session, and the driver talks to this plugin through the relay channel to do
-- screen capture and virtual input. The driver only exists for the length of the
-- test session.

local GuestService = {}
GuestService.clientReady = false
GuestService.serverReady = false
GuestService.sessionId = nil

-- Ask the in-game driver to do something and wait for its result. The request
-- lands on that role's lane in the relay channel; the driver polls it, runs the
-- op, and posts one reply back.
local function guestExec(role, op, args, timeoutSec)
	if bridge.channel == nil then
		return { ok = false, error = "not linked - the relay channel does not exist yet" }
	end
	local base = guestBase(role)
	local id = "g" .. randomHex(8)
	local body, encodeErr = encodeBody({
		id = id,
		op = op,
		args = args or {},
		timeoutMs = math.floor((timeoutSec or 20) * 1000),
	})
	if body == nil then
		return { ok = false, error = "could not encode the driver request: " .. tostring(encodeErr) }
	end
	local posted, postErr = request({
		url = base .. "/cmd.json",
		method = "POST",
		body = body,
		headers = { ["Content-Type"] = "application/json" },
	})
	if posted == nil then
		return { ok = false, error = "relay unreachable: " .. tostring(postErr) }
	end
	-- Grab our own push key: anything older than it cannot be our answer.
	local sinceKey = nil
	local okKey, keyData = pcall(function()
		return HttpService:JSONDecode(posted.Body or "")
	end)
	if okKey and type(keyData) == "table" and type(keyData.name) == "string" then
		sinceKey = keyData.name
	end
	local started = os.clock()
	local budget = math.min(tonumber(timeoutSec) or 20, 60)
	while os.clock() - started &lt; budget do
		local listing = request({ url = base .. "/res.json?shallow=true" })
		local keys = listing ~= nil and decodeBody(listing) or nil
		if type(keys) == "table" then
			local sorted = {}
			for key in pairs(keys) do
				table.insert(sorted, key)
			end
			table.sort(sorted)
			for _, key in ipairs(sorted) do
				if sinceKey == nil or key &gt; sinceKey then
					local entryResp = request({ url = base .. "/res/" .. key .. ".json" })
					local entry = entryResp ~= nil and decodeBody(entryResp) or nil
					if type(entry) == "table" and entry.id == id then
						pcall(function()
							request({ url = base .. "/res/" .. key .. ".json", method = "DELETE" })
						end)
						-- the driver's own payload is the result; its ok/error stay
						-- on the wrapper so every caller reads the same shape
						return { ok = entry.ok == true, error = entry.error, result = entry }
					end
				end
			end
		end
		task.wait(0.3)
	end
	return { ok = false, error = string.format("no answer from the %s driver within %d s", tostring(role), budget) }
end

-- Does the running game have a driver checking in?
local function guestStatus()
	local status = { play = RunService:IsRunning(), runMode = tostring(RunService:IsRunMode()) }
	local reply = guestExec("client", "hello", nil, 6)
	status.client = reply.ok == true and reply.result ~= nil
	if reply.ok and type(reply.result) == "table" then
		status.clientInfo = reply.result
	end
	local serverReply = guestExec("server", "hello", nil, 6)
	status.server = serverReply.ok == true and serverReply.result ~= nil
	if serverReply.ok and type(serverReply.result) == "table" then
		status.serverInfo = serverReply.result
	end
	return status
end

local DRIVER_CLIENT_NAME = "GolemPlayTestDriver"
local DRIVER_SERVER_NAME = "GolemPlayTestDriverServer"

local function removeDriver()
	for _, pair in ipairs({
		{ game:GetService("ReplicatedStorage"), DRIVER_CLIENT_NAME },
		{ game:GetService("ServerScriptService"), DRIVER_SERVER_NAME },
	}) do
		local holder = pair[1]
		local child = holder and holder:FindFirstChild(pair[2])
		if child ~= nil then
			pcall(function()
				child:Destroy()
			end)
		end
	end
end

local function installDriver()
	removeDriver()
	local client = Instance.new("Script")
	client.Name = DRIVER_CLIENT_NAME
	client.Source = guestSource("client") or ""
	client.Disabled = false
	pcall(function()
		client.RunContext = Enum.RunContext.Client
	end)
	client.Parent = game:GetService("ReplicatedStorage")

	local server = Instance.new("Script")
	server.Name = DRIVER_SERVER_NAME
	server.Source = guestSource("server") or ""
	server.Disabled = false
	pcall(function()
		server.RunContext = Enum.RunContext.Server
	end)
	server.Parent = game:GetService("ServerScriptService")
	return true
end
-- Diagnostics: everything the CLI needs to explain a broken link, in one call.
function OPS.debug()
	local report = {
		plugin = PLUGIN_TITLE,
		version = VERSION,
		studio = STUDIO_VERSION,
		transport = "relay",
		relay = FIREBASE_DB,
		channel = bridge.channel,
		deviceId = bridge.channel, -- kept for older CLI wording
		pollInterval = bridge.interval,
		lastPollMsAgo = bridge.lastPollAt &gt; 0 and math.floor((os.clock() - bridge.lastPollAt) * 1000) or nil,
		lastError = bridge.lastError,
		httpEnabled = HttpService.HttpEnabled,
		uptimeSeconds = math.floor(os.clock() - state.startedAt + 0.5),
		commandsServed = state.commandsServed,
		errors = state.errors,
		queuedResults = #pendingResults,
		publishError = state.publishError,
		place = game.Name,
		playRunning = RunService:IsRunning(),
		turn = turnNumber,
		historyEvents = #chatEvents,
		marketplace = "agent-side (npx golem-bridge search/info)",
	}

	-- Prove the relay is actually readable and writable from this Studio, not
	-- just that a URL exists. A marker goes out and has to come back.
	local marker = "debug-" .. tostring(os.clock())
	local okPost = relayDeliver({ op = "debug", v = VERSION, ts = os.time(), marker = marker })
	report.relayPublish = okPost and "ok" or "failed"
	if okPost then
		local listing = request({ url = resUrl() .. ".json?shallow=true" })
		report.relayRead = listing ~= nil and "ok" or "read failed"
	end
	if RunService:IsRunning() then
		report.driver = guestStatus()
	end
	return report
end
-- Start a real play test. Prefers Studio's own test session API so a character
-- actually spawns (F5), and falls back to Run mode only when that is asked for.
local playSessionThread = nil

function OPS.play(args)
	if RunService:IsRunning() then
		local status = guestStatus()
		return {
			playing = true,
			alreadyRunning = true,
			mode = status.runMode,
			driver = status,
			hint = status.client and "the driver is live: use `screenshot`, `click`, `input`, `logs`"
				or "no driver answered yet - restart the test with `stop` then `play` so the driver is injected",
		}
	end
	local mode = string.lower(tostring(args and args.mode or "play"))
	if mode ~= "play" and mode ~= "run" then
		error("args.mode must be play or run", 0)
	end
	installDriver()
	local started = { playing = true, mode = mode, driverInjected = true }
	state.playStartedAt = os.time()
	-- The session call yields until the test ends, so it must not block the
	-- command loop: run it on its own thread and answer immediately.
	playSessionThread = task.spawn(function()
		local testService = game:FindService("StudioTestService")
		local ok = false
		if testService ~= nil then
			if mode == "play" then
				ok = pcall(function()
					testService:ExecutePlayModeAsync("golem")
				end)
			else
				ok = pcall(function()
					testService:ExecuteRunModeAsync("golem")
				end)
			end
		end
		if not ok then
			-- older Studio builds: drive RunService directly
			if mode == "play" then
				ok = pcall(function()
					game:Play()
				end)
			end
			if not ok then
				pcall(function()
					RunService:Run()
				end)
			end
		end
	end)
	-- Watch the session lifetime and clean the driver scripts up afterwards.
	-- They must survive while the client copy is live - that copy is what
	-- answers screenshots and input - so cleanup waits for the session to end.
	task.spawn(function()
		local sawRunning = RunService:IsRunning()
		local waited = 0
		while not sawRunning and waited &lt; 20 do
			task.wait(0.5)
			waited = waited + 0.5
			sawRunning = RunService:IsRunning()
		end
		while sawRunning and waited &lt; 3600 do
			task.wait(0.5)
			waited = waited + 0.5
			sawRunning = RunService:IsRunning()
		end
		if waited &lt; 3600 then
			pcall(removeDriver)
		end
	end)
	started.hint = "the test session is starting; give it a moment, then use `screenshot` to look and `input`/`click` to play"
	return started
end

function OPS.stop()
	if not RunService:IsRunning() then
		removeDriver()
		return { playing = false, runState = "Stopped" }
	end
	local testService = game:FindService("StudioTestService")
	if testService ~= nil then
		pcall(function()
			testService:EndTest("golem-stop")
		end)
		pcall(function()
			testService:LeaveTest()
		end)
	end
	pcall(function()
		RunService:Stop()
	end)
	task.defer(function()
		pcall(removeDriver)
	end)
	return { playing = false, runState = "Stopped" }
end

local function readLogs(args)
	local filter = string.lower(tostring(args and args.filter or "errors"))
	if filter ~= "errors" and filter ~= "all" then
		error("args.filter must be errors or all", 0)
	end
	local limit = math.clamp(tonumber(args and args.limit) or 60, 1, 200)
	local since = tonumber(args and args.since) or state.playStartedAt or 0
	local ok, history = pcall(function()
		return game:GetService("LogService"):GetLogHistory()
	end)
	if not ok or type(history) ~= "table" then
		error("could not read the output log: " .. tostring(history), 0)
	end
	local entries, errorCount, warningCount = {}, 0, 0
	for _, entry in ipairs(history) do
		if type(entry) == "table" then
			local ts = tonumber(entry.timestamp) or 0
			if ts &gt;= since then
				local mtype = tostring(entry.messageType)
				local isError = mtype == "Enum.MessageType.MessageError"
				local isWarning = mtype == "Enum.MessageType.MessageWarning"
				if isError then
					errorCount = errorCount + 1
				elseif isWarning then
					warningCount = warningCount + 1
				end
				if filter == "all" or isError or isWarning then
					local msg = tostring(entry.message or "")
					if #msg &gt; 400 then
						msg = truncateBytes(msg, 400) .. "…"
					end
					table.insert(entries, {
						type = isError and "error" or (isWarning and "warning" or "info"),
						message = msg,
						timestamp = ts,
						source = type(entry.source) == "string" and entry.source or nil,
					})
				end
			end
		end
	end
	local out = {}
	for i = #entries, math.max(1, #entries - limit + 1), -1 do
		table.insert(out, entries[i])
	end
	return {
		count = #out,
		total = #entries,
		errors = errorCount,
		warnings = warningCount,
		since = since,
		entries = out,
	}
end

function OPS.logs(args)
	local play = readLogs(args)
	-- During a test the interesting log is the running copy's, not the editor's.
	if RunService:IsRunning() then
		local reply = guestExec("server", "logs", args, 20)
		if reply.ok and type(reply.result) == "table" then
			reply.result.editorLog = play
			return reply.result
		end
		play.note = "the play session's driver did not answer; these are the editor's logs"
	end
	return play
end

-- ------------------------------------------------------------ screen capture
-- Edit-mode capture. No play session exists to ask, but the plugin can capture
-- the Studio viewport itself: CaptureScreenshot hands back a content id, and
-- AssetService turns that into readable pixels.
local function captureViewport(maxWidth)
	local contentId = nil
	local done = false
	local okCall = pcall(function()
		game:GetService("CaptureService"):CaptureScreenshot(function(id)
			contentId = id
			done = true
		end)
	end)
	if not okCall then
		return nil, "this Studio build cannot capture the viewport"
	end
	local started = os.clock()
	while not done and os.clock() - started &lt; 8 do
		task.wait(0.1)
	end
	if contentId == nil then
		return nil, "Studio did not return a capture - try again once the viewport is visible"
	end
	local image = nil
	local okImage, errImage = pcall(function()
		image = game:GetService("AssetService"):CreateEditableImageAsync(contentId)
	end)
	if not okImage or image == nil then
		return nil, "could not read the capture: " .. tostring(errImage)
	end
	local size = image.Size
	local scale = math.min(1, (tonumber(maxWidth) or 900) / math.max(1, size.X))
	local width = math.max(8, math.floor(size.X * scale))
	local height = math.max(8, math.floor(size.Y * scale))
	local stepX = size.X / width
	local stepY = size.Y / height
	local points = {}
	for y = 0, height - 1 do
		for x = 0, width - 1 do
			local okPixel, px = pcall(function()
				return image:ReadPixels(Vector2.new(math.floor(x * stepX), math.floor(y * stepY)), Vector2.new(1, 1))
			end)
			if okPixel and px ~= nil and px[1] ~= nil then
				table.insert(points, string.format("%d,%d,%d,%d",
					math.floor((px[1] or 0) * 255), math.floor((px[2] or 0) * 255),
					math.floor((px[3] or 0) * 255), math.floor((px[4] or 1) * 255)))
			else
				table.insert(points, "0,0,0,0")
			end
		end
	end
	pcall(function()
		image:Destroy()
	end)
	return {
		ok = true,
		width = width,
		height = height,
		format = "rgba-csv",
		pixels = table.concat(points, ";"),
		source = "editor",
	}
end

function OPS.screenshot(args)
	local payload = {
		label = type(args) == "table" and args.label or nil,
		maxWidth = type(args) == "table" and tonumber(args.maxWidth) or nil,
	}
	local result
	if RunService:IsRunning() then
		local reply = guestExec("client", "screenshot", payload, 40)
		if not reply.ok then
			error(tostring(reply.error or "screen capture failed"), 0)
		end
		result = type(reply.result) == "table" and reply.result or {}
	else
		local captured, err = captureViewport(payload.maxWidth)
		if captured == nil then
			error(tostring(err), 0)
		end
		result = captured
		result.label = payload.label or "viewport"
	end
	result.writtenBy = "golem-bridge writes .golem/shots/"
	return result
end

-- -------------------------------------------------------------- input tools
local function requirePlaySession(name)
	if not RunService:IsRunning() then
		error(name .. " needs a running play test: run `play` first", 0)
	end
end

function OPS.click(args)
	requirePlaySession("click")
	local x = tonumber(args and args.x)
	local y = tonumber(args and args.y)
	if x == nil or y == nil then
		error("click needs args.x and args.y (viewport pixels)", 0)
	end
	local reply = guestExec("client", "click", {
		x = x,
		y = y,
		button = args.button,
		holdMs = tonumber(args.holdMs),
	}, 20)
	if not reply.ok then
		error(tostring(reply.error or "click failed"), 0)
	end
	return reply.result or { ok = true }
end

function OPS.input(args)
	requirePlaySession("input")
	local reply = guestExec("client", "input", args, 30)
	if not reply.ok then
		error(tostring(reply.error or "input failed"), 0)
	end
	return reply.result or { ok = true }
end

function OPS.look_through(args)
	local inst = resolveStrict(args and args.path)
	local camera = workspace.CurrentCamera
	if camera == nil then
		error("Studio has no camera right now", 0)
	end
	if RunService:IsRunning() then
		local reply = guestExec("client", "look_through", { path = slashPath(inst) }, 20)
		if reply.ok then
			return reply.result or { ok = true }
		end
	end
	local base
	if inst:IsA("BasePart") then
		base = inst.CFrame
	elseif inst:IsA("Model") then
		base = inst:GetPivot()
	elseif inst:IsA("Camera") then
		base = inst.CFrame
	else
		error("look_through needs a part, model, or camera", 0)
	end
	camera.CFrame = base * CFrame.new(0, 2, 6) * CFrame.Angles(0, math.rad(180), 0)
	return { ok = true, target = slashPath(inst), mode = "editor camera" }
end

-- -------------------------------------------------------------- undo/redo
function OPS.undo(args)
	local times = math.clamp(tonumber(args and args.times) or 1, 1, 50)
	local can, _ = ChangeHistoryService:GetCanUndo()
	if can == false then
		error("nothing to undo - Studio's history is empty for this place", 0)
	end
	for _ = 1, times do
		ChangeHistoryService:Undo()
		task.wait()
	end
	return { ok = true, undone = times }
end

function OPS.redo(args)
	local times = math.clamp(tonumber(args and args.times) or 1, 1, 50)
	for _ = 1, times do
		ChangeHistoryService:Redo()
		task.wait()
	end
	return { ok = true, redone = times }
end

function OPS.playstate()
	local status = guestStatus()
	status.playStartedAt = state.playStartedAt
	return status
end
function OPS.rename(args)
 local inst = resolveStrict(args.path)
 local name = args.name
 if type(name) ~= "string" or #name == 0 then
 error("args.name (the new name) is required", 0)
 end
 if string.find(name, "/", 1, true) ~= nil then
 error("names must not contain '/' (it is the path separator) - use '-' or '_'", 0)
 end
 local oldName = inst.Name
 inst.Name = name
 waypoint("rename " .. slashPath(inst))
 return { path = slashPath(inst), name = inst.Name, old = oldName }
end

function OPS.paint(args)

 local paths = args.paths
 if type(paths) ~= "table" then
 paths = { args.path }
 end
 local targets = {}
 local function collect(inst)
 if inst:IsA("BasePart") then
 table.insert(targets, inst)
 else
 for _, child in ipairs(inst:GetDescendants()) do
 if child:IsA("BasePart") then
 table.insert(targets, child)
 end
 end
 end
 end
 for _, p in ipairs(paths) do
 collect(resolveStrict(p))
 end
 if #targets == 0 then
 error("no parts found to paint", 0)
 end
 local color = nil
 if type(args.color) == "string" and #args.color &gt; 0 then
 color = hexToColor(args.color)
 end
 local material = nil
 if type(args.material) == "string" and #args.material &gt; 0 then
 local okMat, m = pcall(function()
 if string.sub(args.material, 1, 5) == "Enum." then
 return parseEnum(args.material)
 end
 return Enum.Material[args.material]
 end)
 if not okMat or m == nil then
 error(string.format("unknown material '%s' (e.g. Grass, Neon, WoodPlanks, SmoothPlastic)", tostring(args.material)), 0)
 end
 material = m
 end
 local transparency = tonumber(args.transparency)
 local reflectance = tonumber(args.reflectance)
 for _, part in ipairs(targets) do
 if color ~= nil then
 part.Color = color
 end
 if material ~= nil then
 part.Material = material
 end
 if transparency ~= nil then
 part.Transparency = math.clamp(transparency, 0, 1)
 end
 if reflectance ~= nil then
 part.Reflectance = math.clamp(reflectance, 0, 1)
 end
 end
 waypoint("paint " .. #targets .. " part(s)")
 return { count = #targets }
end

function OPS.place(args)

 local inst = resolveStrict(args.path)
 if type(args.position) ~= "table" then
 error("args.position {x,y,z} (world position) is required", 0)
 end
 local pos = Vector3.new(
 tonumber(args.position.x) or 0,
 tonumber(args.position.y) or 0,
 tonumber(args.position.z) or 0)
 local cf = CFrame.new(pos)
 if type(args.orientation) == "table" then
 cf = cf * CFrame.fromOrientation(
 math.rad(tonumber(args.orientation.x) or 0),
 math.rad(tonumber(args.orientation.y) or 0),
 math.rad(tonumber(args.orientation.z) or 0))
 end
 local okPivot, errPivot = pcall(function()
 inst:PivotTo(cf)
 end)
 if not okPivot then
 error("could not place " .. inst:GetFullName() .. " (only parts and models can be placed): " .. tostring(errPivot), 0)
 end
 waypoint("place " .. slashPath(inst))
 return { path = slashPath(inst), position = { x = pos.X, y = pos.Y, z = pos.Z } }
end

function OPS.look(args)

 local target = nil
 if type(args.path) == "string" then
 local inst = resolveStrict(args.path)
 local okPiv, pivPos = pcall(function()
 return inst:GetPivot().Position
 end)
 if not okPiv then
 error("cannot look at " .. slashPath(inst) .. " (only parts and models have a pivot position): " .. tostring(pivPos), 0)
 end
 target = pivPos
 elseif type(args.position) == "table" then
 target = Vector3.new(
 tonumber(args.position.x) or 0,
 tonumber(args.position.y) or 0,
 tonumber(args.position.z) or 0)
 else
 error("args.path or args.position {x,y,z} is required", 0)
 end
 local distance = math.clamp(tonumber(args.distance) or 30, 5, 500)
 local camera = workspace.CurrentCamera
 if camera == nil then
 error("no editor camera available", 0)
 end
 local dir = camera.CFrame.Position - target
 if dir.Magnitude &lt; 1 then
 dir = Vector3.new(0, 0.5, 1)
 end
 camera.CFrame = CFrame.lookAt(target + dir.Unit * distance, target)
 return { lookedAt = { x = target.X, y = target.Y, z = target.Z }, distance = distance }
end

function OPS.count(args)

 local scope = resolveStrict(args.scope or "game")
 local classFilter = args.class
 local n = 0
 if type(classFilter) == "string" and #classFilter &gt; 0 then
 local okClass = pcall(function()
 return scope:IsA(classFilter)
 end)
 if not okClass then
 error(string.format("unknown class '%s'", classFilter), 0)
 end
 if scope:IsA(classFilter) then
 n = n + 1
 end
 for _, inst in ipairs(scope:GetDescendants()) do
 if inst:IsA(classFilter) then
 n = n + 1
 end
 end
 else
 n = #scope:GetDescendants()
 end
 return { count = n, scope = slashPath(scope), class = classFilter }
end

function OPS.anchor(args)

 local targets = {}
 local function collect(inst)
 if inst:IsA("BasePart") then
 table.insert(targets, inst)
 else
 for _, child in ipairs(inst:GetDescendants()) do
 if child:IsA("BasePart") then
 table.insert(targets, child)
 end
 end
 end
 end
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 collect(resolveStrict(p))
 end
 elseif args.path ~= nil then
 collect(resolveStrict(args.path))
 else
 error("args.path (or args.paths) is required", 0)
 end
 if #targets == 0 then
 error("no parts found to anchor", 0)
 end
 local anchored = (args.anchored ~= false)
 for _, part in ipairs(targets) do
 part.Anchored = anchored
 end
 waypoint("anchor " .. #targets .. " part(s)")
 return { count = #targets, anchored = anchored }
end

function OPS.collide(args)

 local targets = {}
 local function collect(inst)
 if inst:IsA("BasePart") then
 table.insert(targets, inst)
 else
 for _, child in ipairs(inst:GetDescendants()) do
 if child:IsA("BasePart") then
 table.insert(targets, child)
 end
 end
 end
 end
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 collect(resolveStrict(p))
 end
 elseif args.path ~= nil then
 collect(resolveStrict(args.path))
 else
 error("args.path (or args.paths) is required", 0)
 end
 if #targets == 0 then
 error("no parts found", 0)
 end
 local canCollide = (args.canCollide ~= false)
 for _, part in ipairs(targets) do
 part.CanCollide = canCollide
 end
 waypoint("collide " .. #targets .. " part(s)")
 return { count = #targets, canCollide = canCollide }
end

function OPS.light(args)

 local inst = resolveStrict(args.path)
 if not inst:IsA("BasePart") then
 error("args.path must be a BasePart to hold the light", 0)
 end
 local kind = string.lower(tostring(args.type or "point"))
 local class
 if kind == "point" then
 class = "PointLight"
 elseif kind == "spot" then
 class = "SpotLight"
 elseif kind == "surface" then
 class = "SurfaceLight"
 else
 error('args.type must be "point", "spot", or "surface"', 0)
 end
 local light = inst:FindFirstChildOfClass(class)
 if light == nil then
 light = Instance.new(class)
 light.Name = class
 light.Parent = inst
 end
 if type(args.color) == "string" and #args.color &gt; 0 then
 light.Color = hexToColor(args.color)
 end
 if args.range ~= nil then
 light.Range = math.clamp(tonumber(args.range) or 10, 0, 60)
 end
 if args.brightness ~= nil then
 light.Brightness = math.clamp(tonumber(args.brightness) or 1, 0, 20)
 end
 if args.shadows ~= nil then
 light.Shadows = (args.shadows == true)
 end
 waypoint("light " .. slashPath(inst))
 return { path = slashPath(light), class = class, range = light.Range, brightness = light.Brightness }
end

function OPS.sound(args)

 local parent = resolveStrict(args.parent or "game.Workspace")
 local id = tostring(args.id or "")
 if #id == 0 then
 error("args.id (the audio asset id) is required", 0)
 end
 if string.find(id, "rbxassetid://", 1, true) == nil then
 id = "rbxassetid://" .. id
 end
 local snd = Instance.new("Sound")
 snd.Name = args.name or "Sound"
 snd.SoundId = id
 if args.volume ~= nil then
 snd.Volume = math.clamp(tonumber(args.volume) or 0.5, 0, 10)
 end
 if args.looped == true then
 snd.Looped = true
 end
 snd.Parent = parent
 if args.play == true then
 snd:Play()
 end
 waypoint("sound " .. slashPath(snd))
 return { path = slashPath(snd), soundId = id, playing = (args.play == true) }
end

function OPS.scatter(args)

 local tmpl = resolveStrict(args.path)
 local count = math.clamp(tonumber(args.count) or 1, 1, 200)
 local radius = math.max(0, tonumber(args.radius) or 20)
 local yJitter = math.max(0, tonumber(args.yJitter) or 0)
 local parent = (args.parent ~= nil) and resolveStrict(args.parent) or tmpl.Parent
 local cf = getPivotCFrame(tmpl)
 if cf == nil then
 error("scatter needs a BasePart or a Model", 0)
 end
 local basePos = cf.Position
 local rng = Random.new()
 local copies = {}
 for i = 1, count do
 local clone = tmpl:Clone()
 clone.Name = (args.name ~= nil) and (tostring(args.name) .. i) or (tmpl.Name .. i)
 local angle = rng:NextNumber(0, 2 * math.pi)
 local dist = math.sqrt(rng:NextNumber()) * radius
 local pos = Vector3.new(
 basePos.X + math.cos(angle) * dist,
 basePos.Y + rng:NextNumber(-yJitter, yJitter),
 basePos.Z + math.sin(angle) * dist)
 local cloneCf = getPivotCFrame(clone)
 setPivotCFrame(clone, CFrame.new(cloneCf.Position + (pos - basePos)) * cloneCf.Rotation)
 clone.Parent = parent
 if #copies &lt; 20 then
 table.insert(copies, slashPath(clone))
 end
 end
 waypoint("scatter " .. count .. "x " .. tmpl.Name)
 return { count = count, radius = radius, copies = copies }
end

function OPS.weld(args)

 local targets = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(targets, p)
 end
 elseif args.path ~= nil then
 table.insert(targets, args.path)
 else
 error("args.path (or args.paths) is required", 0)
 end
 local welded = 0
 for _, p in ipairs(targets) do
 local inst = resolveStrict(p)
 local parts = {}
 if inst:IsA("BasePart") then
 table.insert(parts, inst)
 else
 for _, child in ipairs(inst:GetDescendants()) do
 if child:IsA("BasePart") then
 table.insert(parts, child)
 end
 end
 end
 if #parts &lt; 2 then
 error(string.format("%s has fewer than 2 parts - nothing to weld", slashPath(inst)), 0)
 end
 local root = parts[1]
 local function alreadyWelded(a, b)
 for _, child in ipairs(root:GetChildren()) do
 if child:IsA("WeldConstraint") then
 local p0, p1 = child.Part0, child.Part1
 if (p0 == a and p1 == b) or (p0 == b and p1 == a) then
 return true
 end
 end
 end
 return false
 end
 for i = 2, #parts do
 if not alreadyWelded(root, parts[i]) then
 local weld = Instance.new("WeldConstraint")
 weld.Name = "GolemWeld"
 weld.Part0 = root
 weld.Part1 = parts[i]
 weld.Parent = root
 welded = welded + 1
 end
 end
 end
 waypoint("weld " .. welded .. " joint(s)")
 return { count = welded }
end

function OPS.hitbox(args)

 local inst = resolveStrict(args.path)
 local size, center
 if inst:IsA("Model") then
 size = inst:GetExtentsSize()
 center = inst:GetPivot().Position
 elseif inst:IsA("BasePart") then
 size = inst.Size
 center = inst.Position
 else
 error("hitbox needs a BasePart or a Model", 0)
 end
 local pad = math.max(0, tonumber(args.padding) or 0.5)
 local hitPart = Instance.new("Part")
 hitPart.Name = args.name or ("Hitbox_" .. inst.Name)
 hitPart.Size = size + Vector3.new(pad, pad, pad) * 2
 hitPart.CFrame = CFrame.new(center)
 hitPart.Transparency = 1
 hitPart.CanCollide = (args.canCollide == true)
 hitPart.CanTouch = true
 hitPart.CanQuery = true
 hitPart.Anchored = (args.anchored ~= false)
 hitPart.Massless = true
 hitPart.Parent = inst:IsA("Model") and inst or inst.Parent
 waypoint("hitbox " .. slashPath(hitPart))
 return { path = slashPath(hitPart), size = { x = hitPart.Size.X, y = hitPart.Size.Y, z = hitPart.Size.Z } }
end

function OPS.prompt(args)

 local inst = resolveStrict(args.path)
 if not inst:IsA("BasePart") then
 error("args.path must be a BasePart to hold the prompt", 0)
 end
 local prompt = inst:FindFirstChildOfClass("ProximityPrompt")
 if prompt == nil then
 prompt = Instance.new("ProximityPrompt")
 prompt.Parent = inst
 end
 prompt.ActionText = tostring(args.action or args.text or "Use")
 if args.object ~= nil then
 prompt.ObjectText = tostring(args.object)
 end
 prompt.HoldDuration = math.clamp(tonumber(args.hold) or 0, 0, 10)
 prompt.MaxActivationDistance = math.clamp(tonumber(args.distance) or 8, 1, 100)
 prompt.RequiresLineOfSight = false
 waypoint("prompt " .. slashPath(inst))
 return { path = slashPath(prompt), actionText = prompt.ActionText,
 holdDuration = prompt.HoldDuration }
end

local PARTICLE_PRESETS = {
 leaves = { color = Color3.fromRGB(86, 160, 62), rate = 8, lifetime = { 3, 5 }, speed = { 1, 2 },
 acceleration = Vector3.new(0, -2, 0), size = 0.4, rotSpeed = { -90, 90 } },
 sparks = { color = Color3.fromRGB(255, 200, 80), rate = 30, lifetime = { 0.3, 0.8 }, speed = { 8, 14 },
 acceleration = Vector3.new(0, -30, 0), size = 0.15, spread = { 180, 180 } },
 smoke = { color = Color3.fromRGB(160, 160, 160), rate = 6, lifetime = { 2, 4 }, speed = { 2, 4 },
 acceleration = Vector3.new(0, 3, 0), size = 1.8 },
 magic = { color = Color3.fromRGB(150, 90, 255), rate = 15, lifetime = { 1, 2 }, speed = { 3, 6 },
 acceleration = Vector3.new(0, 5, 0), size = 0.3, lightEmission = 1 },
 fire = { color = Color3.fromRGB(255, 120, 40), rate = 40, lifetime = { 0.5, 1 }, speed = { 4, 8 },
 acceleration = Vector3.new(0, 8, 0), size = 0.8, lightEmission = 1 },
 snow = { color = Color3.fromRGB(240, 248, 255), rate = 60, lifetime = { 4, 6 }, speed = { 2, 4 },
 acceleration = Vector3.new(0, -8, 0), size = 0.25 },
 rain = { color = Color3.fromRGB(150, 190, 255), rate = 120, lifetime = { 1, 1.5 }, speed = { 50, 70 },
 acceleration = Vector3.new(0, -80, 0), size = 0.08 },
 bubbles = { color = Color3.fromRGB(170, 220, 255), rate = 12, lifetime = { 2, 4 }, speed = { 2, 5 },
 acceleration = Vector3.new(0, 6, 0), size = 0.3 },
 dust = { color = Color3.fromRGB(205, 195, 165), rate = 8, lifetime = { 3, 6 }, speed = { 0.5, 1.5 },
 acceleration = Vector3.new(0, 0.4, 0), size = 0.2 },
 confetti = { color = Color3.fromRGB(255, 200, 80), rate = 25, lifetime = { 2, 3 }, speed = { 6, 10 },
 acceleration = Vector3.new(0, -12, 0), size = 0.2, rotSpeed = { -180, 180 }, spread = { 180, 0 } },
 fireflies = { color = Color3.fromRGB(190, 255, 120), rate = 6, lifetime = { 3, 5 }, speed = { 1, 2 },
 acceleration = Vector3.new(0, 0.5, 0), size = 0.15, lightEmission = 1 },
}

function OPS.particles(args)

 local inst = resolveStrict(args.path)
 if not inst:IsA("BasePart") then
 error("args.path must be a BasePart to emit particles", 0)
 end
 local presetName = string.lower(tostring(args.preset or "leaves"))
 local preset = PARTICLE_PRESETS[presetName]
 if preset == nil then
 error("args.preset must be one of: " .. table.concat(
 { "leaves", "sparks", "smoke", "magic", "fire", "snow", "rain", "bubbles", "dust", "confetti", "fireflies" }, ", "), 0)
 end
 local emitter = inst:FindFirstChildOfClass("ParticleEmitter")
 if emitter == nil then
 emitter = Instance.new("ParticleEmitter")
 emitter.Name = presetName
 emitter.Parent = inst
 end
 local color = preset.color
 if type(args.color) == "string" and #args.color &gt; 0 then
 color = hexToColor(args.color)
 end
 emitter.Color = ColorSequence.new(color)
 emitter.Rate = math.max(0, tonumber(args.rate) or preset.rate)
 emitter.Lifetime = NumberRange.new(preset.lifetime[1], preset.lifetime[2])
 emitter.Speed = NumberRange.new(preset.speed[1], preset.speed[2])
 emitter.Acceleration = preset.acceleration
 emitter.Size = NumberSequence.new(preset.size)
 if preset.rotSpeed ~= nil then
 emitter.Rotation = NumberRange.new(preset.rotSpeed[1], preset.rotSpeed[2])
 emitter.RotSpeed = NumberRange.new(preset.rotSpeed[1], preset.rotSpeed[2])
 end
 if preset.spread ~= nil then
 emitter.SpreadAngle = Vector2.new(preset.spread[1], preset.spread[2])
 end
 if preset.lightEmission ~= nil then
 emitter.LightEmission = preset.lightEmission
 end
 waypoint("particles " .. slashPath(inst))
 return { path = slashPath(emitter), preset = presetName, rate = emitter.Rate }
end

function OPS.sign(args)

 local text = args.text
 if type(text) ~= "string" or #text == 0 then
 error("args.text (what the sign says) is required", 0)
 end
 local parent = (args.parent ~= nil) and resolveStrict(args.parent) or workspace
 local board = Instance.new("Part")
 board.Name = args.name or "Sign"
 board.Anchored = true
 board.Material = Enum.Material.Wood
 board.Color = Color3.fromRGB(120, 86, 60)
 local size = { 6, 4, 0.5 }
 if type(args.size) == "table" then
 size = { tonumber(args.size.x) or 6, tonumber(args.size.y) or 4, tonumber(args.size.z) or 0.5 }
 end
 board.Size = Vector3.new(size[1], size[2], size[3])
 if type(args.position) == "table" then
 board.CFrame = CFrame.new(tonumber(args.position.x) or 0,
 tonumber(args.position.y) or 10, tonumber(args.position.z) or 0)
 else
 board.CFrame = CFrame.new(0, 10, 0)
 end
 local gui = Instance.new("SurfaceGui")
 gui.Face = Enum.NormalId.Front
 gui.Parent = board
 local signLabel = Instance.new("TextLabel")
 signLabel.Size = UDim2.fromScale(1, 1)
 signLabel.BackgroundTransparency = 1
 signLabel.Font = Enum.Font.Gotham
 signLabel.Text = text
 signLabel.TextColor3 = Color3.fromRGB(245, 235, 220)
 signLabel.TextScaled = true
 local pad = Instance.new("UIPadding")
 pad.PaddingTop = UDim.new(0, 16)
 pad.PaddingBottom = UDim.new(0, 16)
 pad.PaddingLeft = UDim.new(0, 16)
 pad.PaddingRight = UDim.new(0, 16)
 pad.Parent = signLabel
 signLabel.Parent = gui
 board.Parent = parent
 waypoint("sign " .. slashPath(board))
 return { path = slashPath(board), text = text }
end

function OPS.attributes(args)

 local inst = resolveStrict(args.path)
 if type(args.set) == "table" then
 for key, value in pairs(args.set) do
 if type(value) == "table" then
 if value["type"] ~= nil then
 value = deserializeValue(value, key)
 elseif value.x ~= nil or value.y ~= nil or value.z ~= nil then
 value = Vector3.new(tonumber(value.x) or 0, tonumber(value.y) or 0, tonumber(value.z) or 0)
 else
 error("cannot set attribute '" .. tostring(key) .. "' from a table (use {x,y,z} for Vector3 or a tagged {type=...} value)", 0)
 end
 end
 local okSet, errSet = pcall(function()
 inst:SetAttribute(key, value)
 end)
 if not okSet then
 error(string.format("cannot set attribute '%s' (allowed: string, number, boolean, Vector3 {x,y,z}, tagged {type=...}): %s",
 tostring(key), tostring(errSet)), 0)
 end
 end
 waypoint("attributes " .. slashPath(inst))
 end
 if type(args.clear) == "table" then
 for _, key in ipairs(args.clear) do
 local okClear, errClear = pcall(function()
 inst:SetAttribute(key, nil)
 end)
 if not okClear then
 error(string.format("cannot clear attribute '%s': %s", tostring(key), tostring(errClear)), 0)
 end
 end
 end
 local plain = {}
 for key, value in pairs(inst:GetAttributes()) do
 if type(value) == "number" or type(value) == "string" or type(value) == "boolean" then
 plain[key] = value
 elseif typeof(value) == "Vector3" then
 plain[key] = { x = value.X, y = value.Y, z = value.Z }
 else
 plain[key] = jsonSafe(value)
 end
 end
 return { path = slashPath(inst), attributes = plain }
end

function OPS.tag(args)

 local paths = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(paths, p)
 end
 elseif args.path ~= nil then
 table.insert(paths, args.path)
 end
 if #paths == 0 then
 error("args.path (or args.paths) is required", 0)
 end
 local add = (type(args.add) == "table") and args.add or {}
 local remove = (type(args.remove) == "table") and args.remove or {}
 local tagged = {}
 for _, p in ipairs(paths) do
 local inst = resolveStrict(p)
 for _, t in ipairs(add) do
 if type(t) ~= "string" or #t == 0 then
 error("tags must be non-empty strings", 0)
 end
 CollectionService:AddTag(inst, t)
 end
 for _, t in ipairs(remove) do
 if type(t) ~= "string" or #t == 0 then
 error("tags must be non-empty strings", 0)
 end
 CollectionService:RemoveTag(inst, t)
 end
 table.insert(tagged, { path = slashPath(inst), tags = CollectionService:GetTags(inst) })
 end
 waypoint("tag")
 return { instances = tagged }
end

function OPS.match(args)

 local from = resolveStrict(args.from)
 if not from:IsA("BasePart") then
 error("args.from must be a BasePart (the style source)", 0)
 end
 local to = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(to, p)
 end
 elseif args.to ~= nil then
 table.insert(to, args.to)
 end
 if #to == 0 then
 error("args.to or args.paths (style targets) is required", 0)
 end
 local count = 0
 for _, p in ipairs(to) do
 local inst = resolveStrict(p)
 local parts = {}
 if inst:IsA("BasePart") then
 table.insert(parts, inst)
 else
 for _, child in ipairs(inst:GetDescendants()) do
 if child:IsA("BasePart") then
 table.insert(parts, child)
 end
 end
 end
 for _, part in ipairs(parts) do
 part.Color = from.Color
 part.Material = from.Material
 part.Transparency = from.Transparency
 part.Reflectance = from.Reflectance
 count = count + 1
 end
 end
 waypoint("match " .. count .. " part(s)")
 return { count = count, from = slashPath(from) }
end

function OPS.search_assets(args)

 error("marketplace search runs agent-side - use: npx golem-bridge search &lt;query&gt; [--category model|mesh|image|audio|video|plugin] [--limit N] [--cursor C]", 0)
end

function OPS.asset_info(args)
 error("asset details run agent-side - use: npx golem-bridge info &lt;assetId&gt;", 0)
end

function OPS.insert_asset(args)
 local id = tonumber(args.id)
 if id == nil then
 error("args.id (asset id) is required", 0)
 end
 local parent = resolveStrict(args.parent or "Workspace")
 local ok, container = pcall(function()
 return game:GetService("InsertService"):LoadAsset(id)
 end)
 if not ok or container == nil then
 error(string.format(
 "InsertService could not load asset %d: %s (it may be deleted, paid or restricted - pick a FREE asset: search results show priceInRobux, free means null or 0; assets the user owns also insert)",
 id, tostring(container)), 0)
 end
 local moved = {}
 for _, child in ipairs(container:GetChildren()) do
 child.Parent = parent
 table.insert(moved, child)
 end
 container:Destroy()
 if #moved == 0 then
 error("asset loaded but contained nothing insertable", 0)
 end
 if args.name ~= nil and #moved == 1 then
 pcall(function()
 moved[1].Name = tostring(args.name)
 end)
 end
 waypoint("insert asset " .. id)
 local records = {}
 for _, inst in ipairs(moved) do
 table.insert(records, instanceRecord(inst))
 end
 return { assetId = id, parent = slashPath(parent), count = #records, inserted = records }
end

function OPS.apply_asset(args)
 local id = args.id
 if id == nil then
 error("args.id is required (asset id, or an 'rbxassetid://' string)", 0)
 end
 if args.path == nil or args.prop == nil then
 error("args.path and args.prop (e.g. 'Image', 'Texture', 'SoundId', 'MeshId') are required", 0)
 end
 local value
 if type(id) == "number" then
 value = "rbxassetid://" .. id
 elseif type(id) == "string" then
 local digits = string.match(id, "^%s*(%d+)%s*$")
 if digits ~= nil then
 value = "rbxassetid://" .. digits
 elseif string.sub(id, 1, 13) == "rbxassetid://" or string.sub(id, 1, 11) == "rbxasset://"
 or string.sub(id, 1, 8) == "https://" or string.sub(id, 1, 7) == "http://" then
 local assetParam = string.match(id, "[?&amp;]id=(%d+)")
 value = assetParam ~= nil and ("rbxassetid://" .. assetParam) or id
 else
 error("unrecognized asset id: " .. id, 0)
 end
 else
 error("args.id must be a number or a string", 0)
 end
 local inst = resolveStrict(args.path)
 local prop = tostring(args.prop)
 local ok, err = pcall(function()
 inst[prop] = value
 end)
 if not ok then
 error(string.format("could not set %s.%s = %s: %s",
 inst:GetFullName(), prop, value, tostring(err)), 0)
 end
 waypoint("apply asset")
 local record = instanceRecord(inst)
 record.appliedProperty = prop
 record.appliedValue = value
 return record
end

function OPS.selection(args)
 if args.clear == true then
 Selection:Set({})
 elseif type(args.set) == "table" then
 local objects = {}
 for _, p in ipairs(args.set) do
 table.insert(objects, resolveStrict(p))
 end
 Selection:Set(objects)
 elseif args.set ~= nil then
 Selection:Set({ resolveStrict(args.set) })
 end
 local current = Selection:Get()
 local records = {}
 for _, inst in ipairs(current) do
 table.insert(records, instanceRecord(inst))
 end
 return { count = #records, selection = records }
end

function OPS.waypoint(args)
 waypoint(args.label or "manual")
 return { ok = true }
end

OPS.ls = OPS.list
OPS.cat = OPS.read
OPS.stat = OPS.read
OPS.rm = OPS.delete
OPS.mv = OPS.move
OPS.dup = OPS.duplicate
OPS.pivot = OPS.set_pivot
OPS.rot = OPS.rotate

local OP_NAMES = {}
for name in pairs(OPS) do
 table.insert(OP_NAMES, name)
end
table.sort(OP_NAMES)

executeCommand = function(cmd)
 local startedAt = os.clock()
 local opName = tostring(cmd.op)
 local handler = OPS[opName]
 local response
 if handler == nil then
 response = {
 id = cmd.id,
 ok = false,
 error = string.format("unknown op '%s'. Available ops: %s", opName, table.concat(OP_NAMES, ", ")),
 }
 else
 -- One tool call = one undo step. Wrapping it here (rather than relying on
 -- ops to remember) is what makes Studio's Undo revert exactly what the AI
 -- just did instead of swallowing it.
 local tracked = opNeedsRecording(opName)
 if tracked then
 recordingBegin(describeArgs(opName, cmd.args))
 end
 local ok, result = pcall(handler, cmd.args)
 if tracked then
 if ok then
 recordingFinish()
 else
 recordingCancel()
 end
 end
 if ok then
  response = { id = cmd.id, ok = true, result = result }
 else
  response = { id = cmd.id, ok = false, error = tostring(result) }
 end
 end
 response.op = opName
 response.meta = {
 durationMs = math.floor((os.clock() - startedAt) * 1000 + 0.5),
 pluginVersion = VERSION,
 }
 return response
end

function http(request)
 local headers = request.Headers or {}
 if headers["Content-Type"] == nil then
 headers["Content-Type"] = "application/json"
 end
 headers["X-AIBridge-Plugin"] = VERSION
 headers["X-AIBridge-Studio"] = STUDIO_VERSION
 request.Headers = headers

 request.Compress = Enum.HttpCompression.None

 local ok, response = pcall(function()
 return HttpService:RequestAsync(request)
 end)
 if not ok then
 return nil, tostring(response)
 end
 if response.Success ~= true then
 return nil, string.format("HTTP %d from %s: %s",
 response.StatusCode, request.Url, tostring(response.Body or response.StatusMessage or ""))
 end
 return response
end

local function makeIcon(kind, size, color)

 local holder = createElement("Frame", {
 Name = "Icon_" .. kind,
 AnchorPoint = Vector2.new(0.5, 0.5),
 Position = UDim2.fromScale(0.5, 0.5),
 Size = UDim2.fromOffset(size, size),
 BackgroundTransparency = 1,
 })
 local function bar(w, h, x, y, rot)
 return createElement("Frame", {
 AnchorPoint = Vector2.new(0.5, 0.5),
 Position = UDim2.new(0.5, x, 0.5, y),
 Size = UDim2.fromOffset(w, h),
 BackgroundColor3 = color,
 BorderSizePixel = 0,
 Rotation = rot,
 }, holder)
 end
 if kind == "close" then
 local s = math.floor(size * 0.64)
 bar(2, s, 0, 0, 45)
 bar(2, s, 0, 0, -45)
 elseif kind == "chevronDown" then
 local s = math.floor(size * 0.52)
 local o = math.floor(s / 4)
 bar(2, s, -o, -o, 45)
 bar(2, s, o, -o, -45)
 end
 return holder
end

local function buildUi(widget, linkWidget)
 local function label(props, parent)
 local defaults = {
 BackgroundTransparency = 1,
 FontFace = fontMedium,
 TextSize = 12,
 TextXAlignment = Enum.TextXAlignment.Left,
 TextYAlignment = Enum.TextYAlignment.Top,
 TextColor3 = COLORS.textDim,
 Text = "",
 }
 for k, v in pairs(props) do
 defaults[k] = v
 end
 return createElement("TextLabel", defaults, parent)
 end

 local function textBox(props, parent)
 local defaults = {
 BackgroundColor3 = COLORS.inner,
 TextColor3 = COLORS.text,
 PlaceholderColor3 = COLORS.textFaint,
 ClearTextOnFocus = false,
 FontFace = fontRegular,
 TextSize = 13,
 Text = "",
 BorderSizePixel = 0,
 }
 for k, v in pairs(props) do
 defaults[k] = v
 end
 local box = Instance.new("TextBox")
 for k, v in pairs(defaults) do
 if k ~= "Parent" then
 box[k] = v
 end
 end
 box.Parent = parent
 addCorner(box, 6)
 return box
 end

 local function button(props, parent, hoverColor)
 local baseColor = props.BackgroundColor3 or COLORS.neutral
 local defaults = {
 BackgroundColor3 = COLORS.neutral,
 TextColor3 = COLORS.text,
 FontFace = fontSemibold,
 TextSize = 13,
 BorderSizePixel = 0,
 AutoButtonColor = false,
 Text = "",
 }
 for k, v in pairs(props) do
 defaults[k] = v
 end
 local btn = createElement("TextButton", defaults, parent)
 addCorner(btn, 8)
 btn.MouseEnter:Connect(function()
 tween(btn, { BackgroundColor3 = hoverColor or COLORS.cardHi }, 0.12)
 end)
 btn.MouseLeave:Connect(function()
 tween(btn, { BackgroundColor3 = baseColor }, 0.2)
 end)
 return btn
 end

 ui.root = createElement("Frame", {
 Name = "Root",
 Size = UDim2.fromScale(1, 1),
 BackgroundColor3 = COLORS.bg,
 BorderSizePixel = 0,
 }, widget)

 ui.statusDot = createElement("Frame", {
 Position = UDim2.new(0, 16, 0, 19),
 Size = UDim2.fromOffset(10, 10),
 BackgroundColor3 = COLORS.textFaint,
 BorderSizePixel = 0,
 }, ui.root)
 addCorner(ui.statusDot, 5)
 ui.statusText = createElement("TextLabel", {
 Position = UDim2.new(0, 34, 0, 15),
 Size = UDim2.new(1, -150, 0, 18),
 BackgroundTransparency = 1,
 FontFace = fontMedium,
 TextSize = 13,
 TextXAlignment = Enum.TextXAlignment.Left,
 TextTruncate = Enum.TextTruncate.AtEnd,
 TextColor3 = COLORS.textDim,
 Text = "...",
 }, ui.root)
 ui.settingsButton = button({
 AnchorPoint = Vector2.new(1, 0),
 Position = UDim2.new(1, -16, 0, 10),
 Size = UDim2.fromOffset(92, 28),
 Text = "SETTINGS",
 FontFace = fontSemibold,
 TextSize = 12,
 BackgroundColor3 = COLORS.inner,
 TextColor3 = COLORS.text,
 }, ui.root)
 createElement("Frame", {
 Name = "HeaderLine",
 Position = UDim2.new(0, 0, 0, 48),
 Size = UDim2.new(1, 0, 0, 1),
 BackgroundColor3 = COLORS.border,
 BorderSizePixel = 0,
 }, ui.root)

 ui.chatFrame = createElement("ScrollingFrame", {
 Name = "Chat",
 Position = UDim2.new(0, 16, 0, 56),
 Size = UDim2.new(1, -32, 1, -72),
 BackgroundTransparency = 1,
 BorderSizePixel = 0,
 CanvasSize = UDim2.new(0, 0, 0, 0),
 AutomaticCanvasSize = Enum.AutomaticSize.Y,
 ScrollBarThickness = 6,
 ScrollingDirection = Enum.ScrollingDirection.Y,
 }, ui.root)
 createElement("UIListLayout", {
 Padding = UDim.new(0, 6),
 SortOrder = Enum.SortOrder.LayoutOrder,
 }, ui.chatFrame)
 createElement("UIPadding", {
 PaddingTop = UDim.new(0, 2),
 PaddingBottom = UDim.new(0, 8),
 }, ui.chatFrame)

 ui.chatEmpty = createElement("TextLabel", {
 BackgroundTransparency = 1,
 AnchorPoint = Vector2.new(0.5, 0),
 Position = UDim2.new(0.5, 0, 0, 180),
 Size = UDim2.new(1, -48, 0, 60),
 FontFace = fontRegular,
 TextSize = 15,
 TextWrapped = true,
 TextColor3 = COLORS.textFaint,
 Text = "Nothing here yet.\nAsk your AI to build something — its work appears here as a clean, expandable timeline.",
 }, ui.root)
	ui.setupPopup = createElement("Frame", {
		Name = "SetupPopup",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.45, 0),
		Size = UDim2.new(1, -32, 0, 250),
		BackgroundColor3 = COLORS.card,
		BorderSizePixel = 0,
		Visible = false,
	}, ui.root)
	createElement("UISizeConstraint", {
		MaxSize = Vector2.new(392, 1000),
	}, ui.setupPopup)
	addCorner(ui.setupPopup, 12)
	label({
		Text = "Link your AI",
		Position = UDim2.new(0, 16, 0, 14),
		Size = UDim2.new(1, -60, 0, 20),
		FontFace = fontSemibold,
		TextSize = 16,
		TextColor3 = COLORS.text,
	}, ui.setupPopup)
	ui.closeButton = button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(28, 28),
		Text = "",
		BackgroundColor3 = COLORS.card,
		TextColor3 = COLORS.textFaint,
	}, ui.setupPopup)
	makeIcon("close", 12, COLORS.textFaint).Parent = ui.closeButton
	label({
		Text = "Paste this line into any AI - a terminal, a chat window, even a cloud agent with no tools installed. It ties that AI to this Studio session only.",
		Position = UDim2.new(0, 16, 0, 40),
		Size = UDim2.new(1, -32, 0, 30),
		FontFace = fontRegular,
		TextSize = 12,
		TextWrapped = true,
		TextColor3 = COLORS.textDim,
	}, ui.setupPopup)
	ui.setupBox = textBox({
		Position = UDim2.new(0, 16, 0, 76),
		Size = UDim2.new(1, -32, 0, 62),
		TextWrapped = true,
		MultiLine = true,
		FontFace = fontMono,
		TextSize = 12,
		TextColor3 = COLORS.text,
		BackgroundColor3 = COLORS.inner,
	}, ui.setupPopup)
	addCorner(ui.setupBox, 8)
	ui.copyLineButton = button({
		Position = UDim2.new(0, 16, 0, 146),
		Size = UDim2.new(1, -32, 0, 28),
		Text = "COPY THE LINE",
		BackgroundColor3 = COLORS.inner,
		TextColor3 = COLORS.text,
	}, ui.setupPopup)
	ui.askAiButton = button({
		Position = UDim2.new(0, 16, 0, 180),
		Size = UDim2.new(1, -32, 0, 28),
		Text = "ASK YOUR AI TO CONNECT",
		BackgroundColor3 = COLORS.inner,
		TextColor3 = COLORS.text,
	}, ui.setupPopup)
	label({
		Text = "The line is the key to this session. It stays the same until you end the session in Settings.",
		Position = UDim2.new(0, 16, 0, 214),
		Size = UDim2.new(1, -32, 0, 28),
		FontFace = fontRegular,
		TextSize = 11,
		TextWrapped = true,
		TextColor3 = COLORS.textFaint,
	}, ui.setupPopup)

	local copiedAt = 0
	ui.copyLineButton.Activated:Connect(function()
		ui.setupBox.Text = setupCommandText()
		ui.setupBox:CaptureFocus()
		ui.setupBox.CursorPosition = #ui.setupBox.Text + 1
		local ok, err = pcall(function()
			setclipboard(setupCommandText())
		end)
		if ok and os.clock() - copiedAt &gt; 0.4 then
			copiedAt = os.clock()
			ui.copyLineButton.Text = "COPIED - PRESS CTRL+C IF IT IS NOT ON YOUR CLIPBOARD"
			task.delay(2.5, function()
				if ui.copyLineButton ~= nil then
					ui.copyLineButton.Text = "COPY THE LINE"
				end
			end)
		elseif not ok then
			ui.copyLineButton.Text = "FOCUSED - PRESS CTRL+C TO COPY"
			task.delay(3, function()
				if ui.copyLineButton ~= nil then
					ui.copyLineButton.Text = "COPY THE LINE"
				end
			end)
		end
	end)
	ui.askAiButton.Activated:Connect(function()
		-- The line is the whole capability and it dies with this Studio session,
		-- so pasting it into a chat (even a public one) is safe by design.
		if ui.chatBox == nil then
			return
		end
		ui.chatBox.Text = setupCommandText()
		ui.hideSetupPopup()
		ui.chatBox:CaptureFocus()
	end)

	ui.setupPopupToken = 0
	ui.showSetupPopup = function()
		if ui.setupPopup == nil or ui.setupPopup.Visible then
			return
		end
		ui.setupPopupToken = ui.setupPopupToken + 1
		if ui.chatEmpty ~= nil then
			ui.chatEmpty.Visible = false
		end
		ui.setupPopup.Visible = true
		ui.setupPopup.Position = UDim2.new(0.5, 0, 0.45, 10)
		tween(ui.setupPopup, { Position = UDim2.new(0.5, 0, 0.45, 0) }, 0.2)
	end
	ui.hideSetupPopup = function()
		if ui.setupPopup == nil or not ui.setupPopup.Visible then
			return
		end
		ui.setupPopupToken = ui.setupPopupToken + 1
		local myToken = ui.setupPopupToken
		tween(ui.setupPopup, { Position = UDim2.new(0.5, 0, 0.45, -8) }, 0.16)
		task.delay(0.16, function()
			if ui.setupPopup ~= nil and ui.setupPopupToken == myToken then
				ui.setupPopup.Visible = false
				if ui.chatEmpty ~= nil and #chatQueue == 0 then
					ui.chatEmpty.Visible = true
				end
			end
		end)
	end
 ui.setupPill = button({
