 task.spawn(function()
 while true do
 if quotesActive and ui.workBanner ~= nil and ui.workBanner.Visible
 and ui.workDot.BackgroundTransparency &lt; 0.5 then
 tween(ui.workDot, { BackgroundTransparency = 0.55 }, 0.55)
 task.wait(0.55)
 tween(ui.workDot, { BackgroundTransparency = 0 }, 0.55)
 task.wait(0.55)
 else
 task.wait(0.25)
 end
 end
 end)

 ui.linkRoot = createElement("Frame", {
 Name = "LinkRoot",
 Size = UDim2.fromScale(1, 1),
 BackgroundColor3 = COLORS.bg,
 BorderSizePixel = 0,
 }, linkWidget)

	local settingsScroll = createElement("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
	}, ui.linkRoot)
	local settingsList = createElement("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, settingsScroll)
	createElement("UIListLayout", {
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, settingsList)
	createElement("UIPadding", {
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
	}, settingsList)

	local setupCard = createElement("Frame", {
		Size = UDim2.new(1, 0, 0, 116),
		BackgroundColor3 = COLORS.card,
		BorderSizePixel = 0,
		LayoutOrder = 1,
	}, settingsList)
	addCorner(setupCard, 10)
	label({ Text = "SET UP YOUR AI", Position = UDim2.new(0, 14, 0, 10), Size = UDim2.new(1, -28, 0, 12) }, setupCard)
	label({
		Text = "Paste this line into your AI - anywhere it runs. It names this Studio session, and it stops working when the session ends.",
		Position = UDim2.new(0, 14, 0, 26),
		Size = UDim2.new(1, -28, 0, 26),
		FontFace = fontRegular,
		TextSize = 11,
		TextWrapped = true,
		TextColor3 = COLORS.textDim,
	}, setupCard)
	ui.settingsSetupBox = textBox({
		Position = UDim2.new(0, 14, 0, 54),
		Size = UDim2.new(1, -28, 0, 50),
		TextWrapped = true,
		MultiLine = true,
		FontFace = fontMono,
		TextSize = 12,
		TextColor3 = COLORS.text,
		BackgroundColor3 = COLORS.inner,
	}, setupCard)
	addCorner(ui.settingsSetupBox, 6)

	local linkStatusLabel = label({
		Text = "",
		Position = UDim2.new(0, 14, 0, 110),
		Size = UDim2.new(1, -28, 0, 14),
		FontFace = fontRegular,
		TextSize = 11,
		TextColor3 = COLORS.textFaint,
	}, setupCard)
	setupCard.Size = UDim2.new(1, 0, 0, 132)

	local function endSessionNow()
		-- Mint a brand-new channel and wipe the old one: the line pasted into the
		-- chat stops answering from this moment.
		local old = bridge.channel
		rotateChannel()
		relayRetireChannel(old)
		generation = generation + 1
		state.running = false
		setConnected(false, "session ended")
		ensureHttpEnabled()
		bridge.skipBefore = os.time() - 45
		bridge.lastMessageKey = nil
		bridge.mode = "relay"
		task.spawn(relayLoop, generation)
		relayBeacon("hello", { place = game.PlaceId })
		if ui.setupBox ~= nil then
			ui.setupBox.Text = setupCommandText()
		end
		if ui.settingsSetupBox ~= nil then
			ui.settingsSetupBox.Text = setupCommandText()
		end
		updateStatus()
		if ui.refreshSettings ~= nil then
			ui.refreshSettings()
		end
		log("Session ended: this Studio is on a new channel. The old setup line no longer works.")
	end

	local sessionCard = createElement("Frame", {
		Size = UDim2.new(1, 0, 0, 124),
		BackgroundColor3 = COLORS.card,
		BorderSizePixel = 0,
		LayoutOrder = 2,
	}, settingsList)
	addCorner(sessionCard, 10)
	label({ Text = "SESSION", Position = UDim2.new(0, 14, 0, 10), Size = UDim2.new(1, -28, 0, 12) }, sessionCard)
	local sessionInfo = label({
		Text = "",
		Position = UDim2.new(0, 14, 0, 26),
		Size = UDim2.new(1, -28, 0, 40),
		FontFace = fontRegular,
		TextSize = 11,
		TextWrapped = true,
		TextColor3 = COLORS.textFaint,
	}, sessionCard)
	local END_SESSION_TEXT = "END SESSION AND ISSUE A NEW KEY"
	ui.endSessionButton = button({
		Position = UDim2.new(0, 14, 0, 72),
		Size = UDim2.new(1, -28, 0, 30),
		Text = END_SESSION_TEXT,
		BackgroundColor3 = COLORS.inner,
		TextColor3 = COLORS.text,
	}, sessionCard, COLORS.dangerHi)
	ui.endSessionButton.Activated:Connect(function()
		if ui.endSessionButton.Text == END_SESSION_TEXT then
			ui.endSessionButton.Text = "CLICK AGAIN TO CONFIRM"
			task.delay(4, function()
				if ui.endSessionButton ~= nil and ui.endSessionButton.Text ~= END_SESSION_TEXT then
					ui.endSessionButton.Text = END_SESSION_TEXT
				end
			end)
		else
			ui.endSessionButton.Text = END_SESSION_TEXT
			endSessionNow()
		end
	end)

	addCorner(historyCard, 10)
	label({ Text = "TOOL HISTORY (THIS PLACE)", Position = UDim2.new(0, 14, 0, 10), Size = UDim2.new(1, -28, 0, 12) }, historyCard)
	local historyInfo = label({
		Text = "",
		Position = UDim2.new(0, 14, 0, 26),
		Size = UDim2.new(1, -28, 0, 26),
		FontFace = fontRegular,
		TextSize = 11,
		TextWrapped = true,
		TextColor3 = COLORS.textFaint,
	}, historyCard)
	local CLEAR_HISTORY_TEXT = "CLEAR TOOL HISTORY FOR THIS PLACE"
	ui.clearHistoryButton = button({
		Position = UDim2.new(0, 14, 0, 58),
		Size = UDim2.new(1, -28, 0, 28),
		Text = CLEAR_HISTORY_TEXT,
		BackgroundColor3 = COLORS.inner,
		TextColor3 = COLORS.text,
	}, historyCard, COLORS.dangerHi)

	ui.settingsButton.Activated:Connect(function()
		linkWidget.Enabled = not linkWidget.Enabled
	end)

	ui.clearHistoryButton.Activated:Connect(function()
		if ui.clearHistoryButton.Text == CLEAR_HISTORY_TEXT then
			ui.clearHistoryButton.Text = "CLICK AGAIN TO CONFIRM"
			task.delay(4, function()
				if ui.clearHistoryButton ~= nil then
					ui.clearHistoryButton.Text = CLEAR_HISTORY_TEXT
				end
			end)
		else
			ui.clearHistoryButton.Text = CLEAR_HISTORY_TEXT
			clearHistory()
			log("Tool history cleared for this place.")
		end
	end)

	-- Keep the static settings text current without rebuilding the panel.
	ui.refreshSettings = function()
		local transport = "waiting for the relay"
		if state.connected then
			transport = "relay is answering - an AI can drive this Studio"
		elseif state.connectError ~= nil and #tostring(state.connectError) &gt; 0 then
			transport = "relay unreachable: " .. tostring(state.connectError)
		end
		linkStatusLabel.Text = transport
		sessionInfo.Text = string.format(
			"This Studio is on channel %s. End the session if that line leaked: a new channel is minted, the old one is wiped, and the pasted line dies immediately. State: %s.",
			tostring(bridge.channel), transport)
		historyInfo.Text = string.format(
			"Saved per place. %d event%s, currently at Turn: %d. The newest %d are restored on reopen.",
			#chatEvents, #chatEvents == 1 and "" or "s", turnNumber, RESTORE_MAX_EVENTS)
	end
	ui.refreshSettings()
end
local toolbar = plugin:CreateToolbar("Golem")
local toolbarButton = toolbar:CreateButton("Golem", "Your AI builder - links an AI agent straight to this Studio session", "")
toolbarButton.ClickableWhenViewportHidden = true

local widget = plugin:CreateDockWidgetPluginGui("GolemWidget", DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Float,
	false,
	false,
	560, 760,
	480, 360
))
widget.Title = PLUGIN_TITLE .. " v" .. VERSION

local linkWidget = plugin:CreateDockWidgetPluginGui("GolemSettingsWidget", DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Float,
	false,
	false,
	600, 700,
	520, 560
))
linkWidget.Title = "Golem - Settings"

toolbarButton.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

local okUi, uiErr = pcall(buildUi, widget, linkWidget)
if not okUi then
	warn("[Golem] the window failed to build: " .. tostring(uiErr) .. " (the link still runs - please report this)")
end
pcall(chatRestore)
if ui.setupBox ~= nil then
	ui.setupBox.Text = setupCommandText()
end
if ui.settingsSetupBox ~= nil then
	ui.settingsSetupBox.Text = setupCommandText()
end
if ui.refreshSettings ~= nil then
	ui.refreshSettings()
end
pcall(startBridge)
updateStatus()

plugin.Unloading:Connect(function()
	generation = generation + 1
	state.running = false
	pcall(saveNow)
	pcall(removeDriver)
end)

log("Golem v" .. VERSION .. " loaded.")

if ui.setupPill ~= nil and ui.chatEmpty ~= nil and #chatEvents == 0 then
	ui.setupPill.Visible = true
	-- first run: open the linking window straight away, no extra click needed
	if ui.showSetupPopup ~= nil then
		ui.showSetupPopup()
	end
end
