 }, settingsList)
 addCorner(historyCard, 10)
 label({ Text = "TOOL HISTORY (THIS PLACE)", Position = UDim2.new(0, 14, 0, 10), Size = UDim2.new(1, -28, 0, 12) }, historyCard)
 label({
