<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><External>null</External><External>nil</External><Item class="Script" referent="RBX0"><Properties><string name="Name">Golem</string><bool name="Disabled">false</bool><ProtectedString name="Source">-- Golem: lets an AI agent build in this Studio session.
-- Install: put Golem.rbxmx in Studio's Plugins folder, restart Studio.
-- v4.0.0: relay transport (works with a cloud AI), real play-testing with screen
-- capture and virtual input, turn counter, undo-safe edits.

if plugin == nil then
	warn("[Golem] This script must run as a Roblox Studio plugin.")
	return
end

local PLUGIN_TITLE = "Golem"
local VERSION = "4.0.0"

-- Studio can only make outgoing HTTP calls, and the AI running golem-bridge is
-- usually a cloud sandbox that cannot reach this computer at all. So both sides
-- meet at a small Firebase Realtime Database: the CLI pushes a command, this
-- plugin polls for it and pushes the result back. The database only stores JSON.
local FIREBASE_DB = "https://roblox-golem-default-rtdb.firebaseio.com"

local HttpService = game:GetService("HttpService")
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local Selection = game:GetService("Selection")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local STUDIO_VERSION = "unknown"
do
	local ok, v = pcall(version)
	if ok and v ~= nil then
		STUDIO_VERSION = tostring(v)
	end
end

local function getSetting(key, default)
	local value = plugin:GetSetting(key)
	if value == nil then
		return default
	end
	return value
end

local state = {
	connected = false,
	running = false,
	commandsServed = 0,
	errors = 0,
	connectError = "",
	workingCount = nil,
	startedAt = os.clock(),
	playStartedAt = nil,
	publishError = nil,
}

-- Everything about the wire protocol lives in this table.
local bridge = {
	mode = "none", -- "relay" once the channel exists
	-- The channel id IS the capability: 16 random hex chars, minted fresh for
	-- every Studio session and never written to disk. A setup line pasted into a
	-- chat ties an AI to this session and to nothing beyond it.
	channel = nil,
	previousChannel = nil,
	interval = 2,
	okStreak = 0,
	skipBefore = 0,
	lastMessageKey = nil,
	lastPollAt = 0,
	lastError = nil,
	beaconSentAt = 0,
}

local ui = {}

local function makeRef(inst)
 refCounter = refCounter + 1
 refs[refCounter] = inst
 return "I:" .. refCounter
end

local function slashPath(inst)
 if inst == game then
 return "game"
 end
 local parts = {}
 local current = inst
 while current ~= nil and current ~= game do
 table.insert(parts, 1, current.Name)
 current = current.Parent
 end
 return table.concat(parts, "/")
end

local function resolvePath(path)
 if type(path) ~= "string" or #path == 0 then
 return nil, "path must be a non-empty string"
 end
 if path == "game" then
 return game
 end

 if string.sub(path, 1, 2) == "I:" then
 local n = tonumber(string.sub(path, 3))
 local inst = n and refs[n] or nil
 if inst ~= nil and (inst.Parent ~= nil or inst == game) then
 return inst
 end
 return nil, string.format("stale or unknown ref '%s' (the instance may be destroyed; use its path instead)", path)
 end

 local rest = path
 if string.sub(rest, 1, 5) == "game." then
 rest = string.sub(rest, 6)
 elseif string.sub(rest, 1, 1) == "/" then
 rest = string.sub(rest, 2)
 end
 if rest == "game" then
 rest = ""
 elseif string.sub(rest, 1, 5) == "game/" then
 rest = string.sub(rest, 6)
 end
 if rest == "" then
 return game
 end

 local sep = "/"
 if string.find(rest, "/", 1, true) == nil then
 sep = "."
 end

 local current = game
 for segment in string.gmatch(rest, "[^" .. sep .. "]+") do
 local child = nil
 if current == game then
 child = game:FindService(segment)
 if child == nil then
 local service = nil
 local ok = pcall(function()
 service = game:GetService(segment)
 end)
 if ok then
 child = service
 end
 end
 else
 child = current:FindFirstChild(segment)
 end
 if child == nil then
 local where = (current == game) and "game" or current:GetFullName()
 return nil, string.format("could not resolve '%s' under %s (from path '%s')", segment, where, path)
 end
 current = child
 end
 return current
end

local function resolveStrict(path)
 local inst, err = resolvePath(path)
 if inst == nil then
 error(tostring(err or ("could not resolve path: " .. tostring(path))), 0)
 end
 return inst
end


