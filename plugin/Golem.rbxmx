local STUDIO_VERSION = "unknown"
do
 local ok, v = pcall(version)
 if ok and v ~= nil then
 STUDIO_VERSION = tostring(v)
 end
end

local refCounter = 0
local refs = setmetatable({}, { __mode = "v" })

local function makeRef(inst)
 refCounter = refCounter + 1
 refs[refCounter] = inst
 return "I:" .. refCounter
end

local function slashPath(inst)
 if inst == game then
 return "game"
 end
 local parts = {}
 local current = inst
 while current ~= nil and current ~= game do
 table.insert(parts, 1, current.Name)
 current = current.Parent
 end
 return table.concat(parts, "/")
end

local function resolvePath(path)
 if type(path) ~= "string" or #path == 0 then
 return nil, "path must be a non-empty string"
 end
 if path == "game" then
 return game
 end

 if string.sub(path, 1, 2) == "I:" then
 local n = tonumber(string.sub(path, 3))
 local inst = n and refs[n] or nil
 if inst ~= nil and (inst.Parent ~= nil or inst == game) then
 return inst
 end
 return nil, string.format("stale or unknown ref '%s' (the instance may be destroyed; use its path instead)", path)
 end

 local rest = path
 if string.sub(rest, 1, 5) == "game." then
 rest = string.sub(rest, 6)
 elseif string.sub(rest, 1, 1) == "/" then
 rest = string.sub(rest, 2)
 end
 if rest == "game" then
 rest = ""
 elseif string.sub(rest, 1, 5) == "game/" then
 rest = string.sub(rest, 6)
 end
 if rest == "" then
 return game
 end

 local sep = "/"
 if string.find(rest, "/", 1, true) == nil then
 sep = "."
 end

 local current = game
 for segment in string.gmatch(rest, "[^" .. sep .. "]+") do
 local child = nil
 if current == game then
 child = game:FindService(segment)
 if child == nil then
 local service = nil
 local ok = pcall(function()
 service = game:GetService(segment)
 end)
 if ok then
 child = service
 end
 end
 else
 child = current:FindFirstChild(segment)
 end
 if child == nil then
 local where = (current == game) and "game" or current:GetFullName()
 return nil, string.format("could not resolve '%s' under %s (from path '%s')", segment, where, path)
 end
 current = child
 end
 return current
end

local function resolveStrict(path)
 local inst, err = resolvePath(path)
 if inst == nil then
 error(tostring(err or ("could not resolve path: " .. tostring(path))), 0)
 end
 return inst
end

