local function describeArgs(op, args)
 local function s(value)
 return tostring(value or "")
 end
 if op == "read" or op == "cat" or op == "stat" or op == "write" or op == "rotate"
 or op == "rot" or op == "face" or op == "shift" or op == "scale"
 or op == "duplicate" or op == "dup" or op == "set_pivot" or op == "pivot" then
 return s(args.path)
 elseif op == "list" or op == "ls" or op == "tree" then
 return s(args.path == nil and "game" or args.path)
 elseif op == "grep" then
 return "\"" .. s(args.pattern) .. "\""
 elseif op == "find" then
 return "\"" .. s(args.query) .. "\""
 elseif op == "create" then
 return s(args.class) .. (args.parent ~= nil and (" in " .. s(args.parent)) or "")
 elseif op == "script" then
 return s(args.class or "Script") .. " " .. s(args.parent) .. "/" .. s(args.name)
 elseif op == "rename" then
 return s(args.path) .. " → " .. s(args.name)
 elseif op == "paint" then
 if type(args.paths) == "table" then
 return table.concat(args.paths, ", ")
 end
 return s(args.path)
 elseif op == "place" then
 return s(args.path)
 elseif op == "look" then
 return s(args.path)
 elseif op == "count" then
 return s(args.scope == nil and "game" or args.scope) .. (args.class ~= nil and (" · " .. s(args.class)) or "")
 elseif op == "debug" then
 return "connection + marketplace"
 elseif op == "undo" then
 return "last change"
 elseif op == "anchor" or op == "collide" then
 if type(args.paths) == "table" then
 return table.concat(args.paths, ", ")
 end
 return s(args.path)
 elseif op == "light" then
 return s(args.path)
 elseif op == "sound" then
 return s(args.parent) .. "/" .. s(args.name or "Sound")
 elseif op == "scatter" then
 return s(args.path) .. " × " .. s(args.count)
 elseif op == "weld" or op == "tag" or op == "match" then
 if type(args.paths) == "table" then
 return table.concat(args.paths, ", ")
 end
 return s(args.path or args.from)
 elseif op == "hitbox" or op == "prompt" or op == "particles" or op == "attributes"
 or op == "trail" or op == "ui_list" then
 return s(args.path or args.parent)
 elseif op == "beam" then
 return s(args.from) .. " -&gt; " .. s(args.to)
 elseif op == "explosion" then
 return "boom"
 elseif op == "ui_screen" or op == "ui_frame" or op == "ui_label" or op == "ui_button"
 or op == "ui_input" or op == "ui_image" then
 return s(args.name)
 elseif op == "play" or op == "stop" then
 return ""
 elseif op == "logs" then
 return s(args.filter or "errors")
 elseif op == "sign" then
 return truncateBytes(s(args.text), 32)
 elseif op == "delete" or op == "rm" then
 if type(args.paths) == "table" then
 return table.concat(args.paths, ", ")
 end
 return s(args.path)
 elseif op == "move" or op == "mv" then
 if args.parent == nil then
 return s(args.path)
 end
 return s(args.path) .. " → " .. s(args.parent)
 elseif op == "group" then
 if type(args.paths) == "table" then
 return table.concat(args.paths, ", ")
 end
 return ""
 elseif op == "duplicate" or op == "dup" then
 return s(args.path) .. " × " .. tostring(tonumber(args.count) or 1)
 elseif op == "terrain" then
 return s(args.material or args.action)
 elseif op == "run" or op == "eval" or op == "exec" then
 return (type(args.code) == "string") and ("Lua · " .. tostring(#args.code) .. " chars") or "Lua"
 elseif op == "search_assets" then
 return "\"" .. s(args.query or args.keyword) .. "\""
 elseif op == "asset_info" then
 return "asset " .. s(args.id)
 elseif op == "insert_asset" then
 return "asset " .. s(args.id) .. " → " .. s(args.parent == nil and "Workspace" or args.parent)
 elseif op == "apply_asset" then
 return "asset " .. s(args.id) .. " on " .. s(args.path)
 elseif op == "ping" then
 return "the connection"
 end
 return ""
end

local function richEscape(s)
 s = string.gsub(tostring(s), "&amp;", "&amp;amp;")
 s = string.gsub(s, "&lt;", "&amp;lt;")
 s = string.gsub(s, "&gt;", "&amp;gt;")
 return s
end

local activeDotSets = {}
local dotsPhase = 0.0
local dotsConn = nil

local function dotsHeartbeat(dt)
 dotsPhase = (dotsPhase + dt * 2.2) % (math.pi * 2)
 for _, set in ipairs(activeDotSets) do
 for i, dot in ipairs(set) do
 local phase = (dotsPhase - (i - 1) * 0.55) % (math.pi * 2)
 local s = (math.sin(phase) + 1) / 2
 dot.BackgroundTransparency = 0.15 + 0.65 * (1 - s)
 dot.Size = UDim2.fromOffset(4 + 4 * s, 4 + 4 * s)
 end
 end
end

local function dotsAttach(set)
 table.insert(activeDotSets, set)
 if dotsConn == nil then
 dotsConn = RunService.Heartbeat:Connect(dotsHeartbeat)
 end
end

local function dotsDetach(set)
 for i, existing in ipairs(activeDotSets) do
 if existing == set then
 table.remove(activeDotSets, i)
 break
 end
 end
 for _, dot in ipairs(set) do
 dot.BackgroundTransparency = 1
 end
 if #activeDotSets == 0 and dotsConn ~= nil then
 dotsConn:Disconnect()
 dotsConn = nil
 end
end

local function flashChip(chip, color)
 chip.BackgroundColor3 = color
 task.delay(0.35, function()
 if chip.Parent ~= nil then
 tween(chip, { BackgroundColor3 = COLORS.cardHi }, 0.4)
 end
 end)
end

local function selectInstanceByPath(path, chip)
 local inst = resolvePath(path)
 if inst ~= nil then
 Selection:Set({ inst })
 if chip ~= nil then
 flashChip(chip, COLORS.live)
 end
 log("Highlighted " .. slashPath(inst))
 else
 if chip ~= nil then
 flashChip(chip, COLORS.err)
 end
 log("Could not highlight '" .. tostring(path) .. "' (no longer exists?)", "err")
 end
end

local function extractPaths(args, envelope)
 local paths = {}
 local function add(p)
 if type(p) ~= "string" or #p == 0 or string.sub(p, 1, 2) == "I:" then
 return
 end
 for _, existing in ipairs(paths) do
 if existing == p then
 return
 end
 end
 if #paths &lt; 10 then
 table.insert(paths, p)
 end
 end
 if type(args) == "table" then
 add(args.path)
 add(args.parent)
 add(args.scope)
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 add(p)
 end
 end
 if type(args.set) == "table" then
 for _, p in ipairs(args.set) do
 add(p)
 end
 end
 end
 local result = (envelope ~= nil) and envelope.result or nil
 if type(result) == "table" then
 add(result.path)
 if type(result.deleted) == "table" then
 for _, p in ipairs(result.deleted) do
 add(p)
 end
 end
 if type(result.inserted) == "table" then
 for _, r in ipairs(result.inserted) do
 if type(r) == "table" then
 add(r.path)
 end
 end
 end
 if type(result.results) == "table" then
 for _, r in ipairs(result.results) do
 if type(r) == "table" then
 add(r.path)
 end
 end
 end
 if type(result.rotated) == "table" then
 for _, r in ipairs(result.rotated) do
 if type(r) == "table" then
 add(r.path)
 end
 end
 end
 if type(result.copies) == "table" then
 for _, r in ipairs(result.copies) do
 if type(r) == "table" then
 add(r.path)
 end
 end
 end
 if type(result.moved) == "table" then
 for _, p in ipairs(result.moved) do
 add(p)
 end
 end
 if type(result.selection) == "table" then
 for _, r in ipairs(result.selection) do
 if type(r) == "table" then
 add(r.path)
 end
 end
 end
 end
 return paths
end

local chatHistory = {}
local chatPersistScheduled = false
local CHAT_HISTORY_MAX = 40
local RESTORE_MAX_ENTRIES = 60

local function chatPlaceKey()
 if game.PlaceId ~= nil and game.PlaceId ~= 0 then
 return "AIBridge_Chat_" .. tostring(game.PlaceId)
 end
 local name = string.gsub(tostring(game.Name), "[^%w-_]", "_")
 return "AIBridge_Chat_local_" .. name
end

function chatPersistNow()
 local ok, encoded = pcall(function()
 return HttpService:JSONEncode(chatHistory)
 end)
 if ok then
 pcall(function()
 plugin:SetSetting(chatPlaceKey(), encoded)
 end)
 end
end

local function chatPersist()
 if chatPersistScheduled then
 return
 end
 chatPersistScheduled = true
 task.delay(1.5, function()
 chatPersistScheduled = false
 chatPersistNow()
 end)
end

local function chatPush(entry)
 table.insert(chatHistory, entry)
 while #chatHistory &gt; CHAT_HISTORY_MAX * 4 do
 table.remove(chatHistory, 1)
 end
 chatPersist()
end

function chatRestore()
 local stored = getSetting(chatPlaceKey(), nil)
 if type(stored) ~= "string" or #stored == 0 then
 return
 end
 local ok, data = pcall(function()
 return HttpService:JSONDecode(stored)
 end)
 if not ok or type(data) ~= "table" then
 return
 end

 local total = #data
 local skipped = math.max(0, total - RESTORE_MAX_ENTRIES)
 if skipped &gt; 0 then
 local tail = table.create(RESTORE_MAX_ENTRIES)
 for i = skipped + 1, total do
 table.insert(tail, data[i])
 end
 data = tail
 end
 chatHistory = data
 if skipped &gt; 0 then
 chatPersistNow()
 end
 for _, entry in ipairs(data) do
 if type(entry) == "table" then
 if entry.k == "m" and type(entry.t) == "string" then
 addChatMessage(entry.t, false)
 elseif entry.k == "c" and type(entry.op) == "string" then
 addChatCommand(entry.op, nil, entry)
 end
 end
 end
 chatFlushTurn()
 if skipped &gt; 0 then
 log(string.format("Restored the newest %d of %d saved entries (older history unloaded).", #data, total))
 else
 log("Restored chat history for this place.")
 end
end

local scrollTween = nil

local function chatMaxScroll()
 local frame = ui.chatFrame
 if frame == nil then
 return 0
 end
 return math.max(0, frame.AbsoluteCanvasSize.Y - frame.AbsoluteWindowSize.Y)
end

local function isPinned()
 return (chatMaxScroll() - (ui.chatFrame.CanvasPosition.Y)) &lt;= 100
end

local function smoothScrollToBottom()
 local frame = ui.chatFrame
 if frame == nil then
 return
 end
 local target = chatMaxScroll()
 if target &lt;= 0 then
 return
 end
 if scrollTween ~= nil then
 scrollTween:Cancel()
 end
 scrollTween = tween(frame, { CanvasPosition = Vector2.new(0, target) }, 0.22)
end

local function chatFollowRaw()
 if ui.chatFrame ~= nil and isPinned() then
 ui.chatFrame.CanvasPosition = Vector2.new(0, chatMaxScroll())
 end
end

local function chatUpdatePill()
 if ui.jumpPill == nil or ui.chatFrame == nil then
 return
 end
 local shouldShow = chatMaxScroll() &gt; 140 and not isPinned()
 if shouldShow ~= ui.jumpPill.Visible then
 ui.jumpPill.Visible = shouldShow
 if shouldShow then
 ui.jumpPill.BackgroundTransparency = 0.5
 ui.jumpPill.TextTransparency = 0.5
 tween(ui.jumpPill, { BackgroundTransparency = 0, TextTransparency = 0 }, 0.18)
 end
 end
end

local function chatScroll(force)
 if ui.chatFrame == nil then
 return
 end
 if force or isPinned() then
 task.defer(smoothScrollToBottom)
 task.defer(chatUpdatePill)
 else
 chatUpdatePill()
 end
end

local function typeOutRow(row, buildText, totalChars, onDone)
 task.spawn(function()
 if totalChars &lt;= 0 then
 row.Text = buildText(0, true)
 if onDone then
 onDone()
 end
 return
 end
 local steps = math.clamp(math.ceil(totalChars / 2), 14, 40)
 for i = 0, steps do
 local reveal = math.floor(totalChars * i / steps)
 row.Text = buildText(reveal, i == steps)
 chatFollowRaw()
 if i &lt; steps then
 task.wait(0.03)
 end
 end
 if onDone then
 onDone()
 end
 end)
end

local function streamLabel(label, full)
 task.spawn(function()
 local total = utf8Len(full)
 if total &lt;= 0 then
 label.Text = full
 return
 end
 local steps = math.clamp(math.ceil(total / 24), 1, 40)
 for i = 0, steps do
 label.Text = utf8Head(full, math.floor(total * i / steps))
 chatFollowRaw()
 if i &lt; steps then
 task.wait(0.025)
 end
 end
 end)
end

local function heightSize(clip, h)
 local x = clip.Size.X
 return UDim2.new(x.Scale, x.Offset, 0, h)
end

local function expandContainer(clip, content, onDone)
 clip.Visible = true
 clip.Size = heightSize(clip, 0)
 if clip:IsA("CanvasGroup") then
 clip.GroupTransparency = 1
 end
 task.defer(function()
 local t = tween(clip, { Size = heightSize(clip, math.ceil(content.AbsoluteSize.Y)) }, 0.3, Enum.EasingStyle.Quint)
 if clip:IsA("CanvasGroup") then
 tween(clip, { GroupTransparency = 0 }, 0.25)
 end
 t.Completed:Connect(function(playback)

 if playback == Enum.PlaybackState.Completed then
 local now = math.ceil(content.AbsoluteSize.Y)
 if math.abs(clip.Size.Y.Offset - now) &gt; 1 then
 tween(clip, { Size = heightSize(clip, now) }, 0.15)
 end
 end
 if onDone then
 onDone()
 end
 end)
 end)
end

local function collapseContainer(clip, onDone)
 local t = tween(clip, { Size = heightSize(clip, 0) }, 0.24, Enum.EasingStyle.Quint)
 if clip:IsA("CanvasGroup") then
 tween(clip, { GroupTransparency = 1 }, 0.2)
 end
 t.Completed:Connect(function()
 clip.Visible = false
 if clip:IsA("CanvasGroup") then
 clip.GroupTransparency = 0
 end
 if onDone then
 onDone()
 end
 end)
end

local TURN_AUTO_IDLE_SECONDS = 120
local TURN_EXPLICIT_IDLE_SECONDS = 300
local chatOrder = 0
local chatQueue = {}
local currentTurn = nil
local abandonedTurn = nil

local refreshWorking

local function chatTrim(holder)
 table.insert(chatQueue, holder)
 local liveHolder = currentTurn and currentTurn.holder or nil
 while #chatQueue &gt; CHAT_HISTORY_MAX do
 local oldest = table.remove(chatQueue, 1)
 if oldest ~= nil and oldest ~= liveHolder then
 oldest:Destroy()
 end
 end
end

local function chatHideEmpty()
 if ui.chatEmpty ~= nil and ui.chatEmpty.Visible then
 ui.chatEmpty.Visible = false
 end

 if ui.setupPill ~= nil and ui.setupPill.Visible then
 ui.setupPill.Visible = false
 end
 if ui.setupPopup ~= nil and ui.setupPopup.Visible and ui.hideSetupPopup ~= nil then
 ui.hideSetupPopup()
 end
end

local function turnSummaryText(turn, expanded)
 local meta = ""
 if turn.clockText ~= nil then
 meta = string.format(' &lt;font color="%s"&gt;· %s · %s&lt;/font&gt;',
 COLORS_HEX.faint, turn.elapsedText or "?", turn.clockText)
 end
 return string.format('&lt;font color="%s"&gt;Tool Used: %d&lt;/font&gt;%s &lt;font color="%s"&gt;%s&lt;/font&gt;',
 COLORS_HEX.dim, turn.count, meta, COLORS_HEX.faint, expanded and "∨" or "›")
end

local function collapseTurn(turn)
 if turn == nil or turn.collapsed then
 return
 end
 turn.elapsedText = string.format("%ds",
 math.max(1, math.floor(os.clock() - (turn.startedAt or os.clock()))))
 turn.clockText = os.date("%H:%M")
 if turn.count == 0 then

 if currentTurn == turn then
 currentTurn = nil
 end
 turn.holder:Destroy()
 if refreshWorking ~= nil then
 refreshWorking()
 end
 chatScroll()
 return
 end
 turn.collapsed = true
 turn.expanded = false
 if currentTurn == turn then
 currentTurn = nil
 end
 local summary = createElement("TextButton", {
 Size = UDim2.new(1, 0, 0, 22),
 BackgroundTransparency = 1,
 BorderSizePixel = 0,
 AutoButtonColor = false,
 RichText = true,
 FontFace = fontMedium,
 TextSize = 13,
 TextXAlignment = Enum.TextXAlignment.Left,
 Text = turnSummaryText(turn, false),
 TextTransparency = 1,
 LayoutOrder = 1,
 }, turn.holder)
 summary.Activated:Connect(function()
 if turn.expanded then
 turn.expanded = false
 collapseContainer(turn.clip)
 summary.Text = turnSummaryText(turn, false)
 else
 turn.expanded = true
 expandContainer(turn.clip, turn.rows, chatScroll)
 summary.Text = turnSummaryText(turn, true)
 end
 chatScroll()
 end)
 tween(summary, { TextTransparency = 0 }, 0.25)
 collapseContainer(turn.clip)
 chatScroll()
 if refreshWorking ~= nil then
 refreshWorking()
 end
end

function chatFlushTurn()
 if currentTurn ~= nil then
 collapseTurn(currentTurn)
 end
end

local function scheduleCollapse(turn)
 turn.gen = (turn.gen or 0) + 1
 local myGen = turn.gen
 local idle = turn.explicit and TURN_EXPLICIT_IDLE_SECONDS or TURN_AUTO_IDLE_SECONDS
 task.delay(idle, function()
 if currentTurn == turn and turn.gen == myGen and not turn.collapsed then
 if turn.count &gt; 0 then
 abandonedTurn = { count = turn.count }
 end
 collapseTurn(turn)
 end
 end)
end

local function beginTurn()
 if currentTurn ~= nil then
 currentTurn.gen = (currentTurn.gen or 0) + 1
 return currentTurn
 end
 chatOrder = chatOrder + 1
 local turnHolder = createElement("Frame", {
 Size = UDim2.new(1, 0, 0, 0),
 AutomaticSize = Enum.AutomaticSize.Y,
 BackgroundTransparency = 1,
 LayoutOrder = chatOrder,
 }, ui.chatFrame)
 createElement("UIListLayout", {
 Padding = UDim.new(0, 2),
 SortOrder = Enum.SortOrder.LayoutOrder,
 }, turnHolder)

 local clip = createElement("CanvasGroup", {
 Size = UDim2.new(1, 0, 0, 0),
 BackgroundTransparency = 1,
 BorderSizePixel = 0,
 ClipsDescendants = true,
 GroupTransparency = 0,
 LayoutOrder = 2,
 }, turnHolder)
 local rowsFrame = createElement("Frame", {
 Size = UDim2.new(1, 0, 0, 0),
 AutomaticSize = Enum.AutomaticSize.Y,
 BackgroundTransparency = 1,
 }, clip)
 createElement("UIListLayout", {
 Padding = UDim.new(0, 4),
 SortOrder = Enum.SortOrder.LayoutOrder,
 }, rowsFrame)
 local turn = {
 holder = turnHolder, clip = clip, rows = rowsFrame,
 count = 0, gen = 0, collapsed = false, expanded = true,
 startedAt = os.clock(),
 }

 rowsFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
 if turn.expanded then
 tween(clip, { Size = heightSize(clip, math.ceil(rowsFrame.AbsoluteSize.Y)) }, 0.14)
 end
 end)
 currentTurn = turn
 if refreshWorking ~= nil then
 refreshWorking()
 end
 chatTrim(turnHolder)
 return turn
end

local bannerShown = false
refreshWorking = function()

 local working = (currentTurn ~= nil and not currentTurn.collapsed)
 if working then
 state.workingCount = currentTurn.count
 else
 state.workingCount = nil
 end
 if ui.workBanner ~= nil and ui.chatFrame ~= nil then
 local n = state.workingCount or 0
 ui.workCount.Text = string.format("%d TOOL%s", n, n == 1 and "" or "S")

 if working and not bannerShown then
 bannerShown = true
 if not ui.workBanner.Visible then
 ui.workBanner.Visible = true
 ui.workBanner.BackgroundTransparency = 1
 ui.workText.TextTransparency = 1
 ui.workCount.TextTransparency = 1
 ui.workDot.BackgroundTransparency = 1
 end
 tween(ui.workBanner, { BackgroundTransparency = 0 }, 0.25)
 tween(ui.workText, { TextTransparency = 0 }, 0.25)
 tween(ui.workCount, { TextTransparency = 0.25 }, 0.25)
 tween(ui.workDot, { BackgroundTransparency = 0 }, 0.25)
 tween(ui.chatFrame, { Position = UDim2.new(0, 16, 0, 96), Size = UDim2.new(1, -32, 1, -112) }, 0.28)
 elseif not working and bannerShown then
 bannerShown = false
 tween(ui.workBanner, { BackgroundTransparency = 1 }, 0.25)
 tween(ui.workText, { TextTransparency = 1 }, 0.25)
 tween(ui.workCount, { TextTransparency = 1 }, 0.25)
 tween(ui.workDot, { BackgroundTransparency = 1 }, 0.25)
 tween(ui.chatFrame, { Position = UDim2.new(0, 16, 0, 56), Size = UDim2.new(1, -32, 1, -72) }, 0.28)
 task.delay(0.26, function()
 if ui.workBanner ~= nil and state.workingCount == nil then
 ui.workBanner.Visible = false
 end
 end)
 end
 end
 updateStatus()
end

function addChatMessage(text, animate, closeTurn)

 if ui.chatFrame == nil then
 return
 end
 local isLive = (animate ~= false)
 local close = (closeTurn ~= false)
 local turn = currentTurn

 local holder
 local noteOrder = 3

 if turn ~= nil and (turn.count &gt; 0 or not close) then
 holder = turn.holder
 if close then
 collapseTurn(turn)
 else

 turn.notes = (turn.notes or 0) + 1
 noteOrder = 10000 + turn.notes
 turn.gen = (turn.gen or 0) + 1
 scheduleCollapse(turn)
 end
 else
 if turn ~= nil then
 currentTurn = nil
 turn.holder:Destroy()
 end
 chatOrder = chatOrder + 1
 holder = createElement("Frame", {
 Size = UDim2.new(1, 0, 0, 0),
 AutomaticSize = Enum.AutomaticSize.Y,
 BackgroundTransparency = 1,
 LayoutOrder = chatOrder,
 }, ui.chatFrame)
 chatTrim(holder)
 end

 local full = tostring(text)

 local message = createElement("TextBox", {
 Size = UDim2.new(1, 0, 0, 0),
 AutomaticSize = Enum.AutomaticSize.Y,
 BackgroundTransparency = 1,
 RichText = true,
 FontFace = fontRegular,
 TextSize = 14,
 TextWrapped = true,
 MultiLine = true,
 TextEditable = false,
 ClearTextOnFocus = false,
 TextXAlignment = Enum.TextXAlignment.Left,
 TextYAlignment = Enum.TextYAlignment.Top,
 TextColor3 = COLORS.text,
 Text = richEscape(full),
 TextTransparency = isLive and 1 or 0,
 LayoutOrder = noteOrder,
 }, holder)
 createElement("UIPadding", {
 PaddingLeft = UDim.new(0, 4),
 PaddingRight = UDim.new(0, 4),
 PaddingTop = UDim.new(0, 2),
 PaddingBottom = UDim.new(0, 2),
 }, message)
 if isLive then

 task.spawn(function()
 local total = utf8Len(full)
 local steps = math.clamp(math.ceil(total / 3), 12, 48)
 for i = 0, steps do
 local partial = utf8Head(full, math.floor(total * i / steps))
 message.Text = richEscape(partial)
 message.TextTransparency = 0
 chatFollowRaw()
 if i &lt; steps then
 task.wait(0.025)
 end
 end
 end)
 chatPush({ k = "m", t = full })
 end
 if refreshWorking ~= nil then
 refreshWorking()
 end
 chatHideEmpty()
 chatScroll()
end

function addChatCommand(opName, args, replay)
 if ui.chatFrame == nil then
 return nil
 end
 if opName == "turn_begin" or opName == "turn_end" then

 return nil
 end
 local turn = beginTurn()
 turn.count = turn.count + 1
 if refreshWorking ~= nil then
 refreshWorking()
 end
 local descText = (replay ~= nil) and tostring(replay.d or "") or describeArgs(opName, args)
 if #descText &gt; 48 then
 descText = truncateBytes(descText, 46) .. "…"
 end

 local holder = createElement("Frame", {
 Size = UDim2.new(1, 0, 0, 0),
 AutomaticSize = Enum.AutomaticSize.Y,
 BackgroundTransparency = 1,
 LayoutOrder = turn.count,
 }, turn.rows)

 local row = createElement("TextButton", {
 Size = UDim2.new(1, 0, 0, 26),
 BackgroundColor3 = COLORS.card,
 BackgroundTransparency = 1,
 BorderSizePixel = 0,
 AutoButtonColor = false,
 RichText = true,
 FontFace = fontRegular,
 TextSize = 14,
 TextXAlignment = Enum.TextXAlignment.Left,
 TextColor3 = COLORS.textDim,
 Text = "",
 TextTransparency = (replay == nil) and 1 or 0,
 }, holder)
 row.MouseEnter:Connect(function()
 tween(row, { BackgroundTransparency = 0.88 }, 0.12)
 end)
 row.MouseLeave:Connect(function()
 tween(row, { BackgroundTransparency = 1 }, 0.2)
 end)

 local dotsFrame = createElement("Frame", {
 BackgroundTransparency = 1,
 AnchorPoint = Vector2.new(1, 0.5),
 Position = UDim2.new(1, -10, 0.5, 0),
 Size = UDim2.fromOffset(42, 16),
 }, row)
 createElement("UIListLayout", {
 FillDirection = Enum.FillDirection.Horizontal,
 Padding = UDim.new(0, 6),
 SortOrder = Enum.SortOrder.LayoutOrder,
 VerticalAlignment = Enum.VerticalAlignment.Center,
 HorizontalAlignment = Enum.HorizontalAlignment.Right,
 }, dotsFrame)
 local dots = {}
 for i = 1, 3 do
 local dot = createElement("Frame", {
 Size = UDim2.fromOffset(5, 5),
 BackgroundColor3 = COLORS.accent,
 BorderSizePixel = 0,
 BackgroundTransparency = 1,
 LayoutOrder = i,
 }, dotsFrame)
 addCorner(dot, 4)
 dots[i] = dot
 end

 local detail = createElement("Frame", {
 Position = UDim2.new(0, 10, 0, 26),
 Size = UDim2.new(1, -10, 0, 0),
 BackgroundColor3 = COLORS.inner,
 BorderSizePixel = 0,
 ClipsDescendants = true,
 Visible = false,
 }, holder)
 addCorner(detail, 6)
 local detailInner = createElement("Frame", {
 Size = UDim2.new(1, 0, 0, 0),
 AutomaticSize = Enum.AutomaticSize.Y,
 BackgroundTransparency = 1,
 }, detail)
 createElement("UIListLayout", {
 Padding = UDim.new(0, 6),
 SortOrder = Enum.SortOrder.LayoutOrder,
 }, detailInner)
 createElement("UIPadding", {
 PaddingTop = UDim.new(0, 10),
 PaddingBottom = UDim.new(0, 10),
 PaddingLeft = UDim.new(0, 12),
 PaddingRight = UDim.new(0, 12),
 }, detailInner)

 local function detailLabel(order, text, color)
 return createElement("TextLabel", {
 Size = UDim2.new(1, 0, 0, 0),
 AutomaticSize = Enum.AutomaticSize.Y,
 BackgroundTransparency = 1,
 FontFace = fontMono,
 TextSize = 13,
 TextXAlignment = Enum.TextXAlignment.Left,
 TextYAlignment = Enum.TextYAlignment.Top,
 TextWrapped = true,
 TextColor3 = color or COLORS.textDim,
 Text = text,
 LayoutOrder = order,
 }, detailInner)
 end

 createElement("TextLabel", {
 Size = UDim2.new(1, 0, 0, 12),
 BackgroundTransparency = 1,
 FontFace = fontSemibold,
 TextSize = 11,
 TextXAlignment = Enum.TextXAlignment.Left,
 TextColor3 = COLORS.textFaint,
 Text = "REQUEST",
 LayoutOrder = 1,
 }, detailInner)
 local argsLabel = detailLabel(2, "{}")
 createElement("TextLabel", {
 Size = UDim2.new(1, 0, 0, 12),
 BackgroundTransparency = 1,
 FontFace = fontSemibold,
 TextSize = 11,
 TextXAlignment = Enum.TextXAlignment.Left,
 TextColor3 = COLORS.textFaint,
 Text = "RESULT",
 LayoutOrder = 3,
 }, detailInner)
 local resultLabel = detailLabel(4, "…")

 local chipsHolder = createElement("Frame", {
 Size = UDim2.new(1, 0, 0, 0),
 AutomaticSize = Enum.AutomaticSize.Y,
 BackgroundTransparency = 1,
 LayoutOrder = 5,
 }, detailInner)
 createElement("UIListLayout", {
 Padding = UDim.new(0, 4),
 SortOrder = Enum.SortOrder.LayoutOrder,
 }, chipsHolder)

 local function addChip(p)
 local chip = createElement("TextButton", {
 Size = UDim2.new(1, 0, 0, 22),
 BackgroundColor3 = COLORS.cardHi,
 BorderSizePixel = 0,
 AutoButtonColor = false,
 FontFace = fontMono,
 TextSize = 13,
 TextXAlignment = Enum.TextXAlignment.Left,
 TextColor3 = COLORS.text,
 Text = "» " .. p,
 }, chipsHolder)
 addCorner(chip, 5)
 chip.MouseEnter:Connect(function()
 tween(chip, { BackgroundColor3 = COLORS.inner }, 0.12)
 end)
 chip.MouseLeave:Connect(function()
 tween(chip, { BackgroundColor3 = COLORS.cardHi }, 0.2)
 end)
 chip.Activated:Connect(function()
 selectInstanceByPath(p, chip)
 end)
 end

 local function rowText(glyph, glyphHex, desc, msText)
 local verb = OP_LABELS[opName] or tostring(opName)
 local text = string.format('&lt;font color="%s"&gt;%s&lt;/font&gt; &lt;font color="%s"&gt;%s&lt;/font&gt;',
 glyphHex, glyph, COLORS_HEX.dim, richEscape(verb))
 if desc ~= nil and #desc &gt; 0 then
 text = text .. string.format(' &lt;font color="%s"&gt;%s&lt;/font&gt;', COLORS_HEX.text, richEscape(desc))
 end
 if msText ~= nil then
 text = text .. string.format(' &lt;font color="%s"&gt;· %s&lt;/font&gt;', COLORS_HEX.faint, msText)
 end
 return text
 end

 local detailOpen = false
 local function openDetail()
 detailOpen = true
 expandContainer(detail, detailInner, chatScroll)
 end
 local function closeDetail()
 detailOpen = false
 collapseContainer(detail)
 end

 detailInner:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
 if detailOpen and detail.Visible then
 tween(detail, { Size = heightSize(detail, math.ceil(detailInner.AbsoluteSize.Y)) }, 0.12)
 end
 end)

 row.Activated:Connect(function()
 if detailOpen then
 closeDetail()
 else
 openDetail()
 end
 chatScroll()
 end)

 if replay ~= nil then

 local ok = replay.ok ~= false
 row.Text = rowText(ok and "•" or "•", ok and COLORS_HEX.live or COLORS_HEX.err,
 descText, (tostring(tonumber(replay.ms) or 0)) .. " ms")
 argsLabel.Text = tostring(replay.a or "{}")
 resultLabel.Text = tostring(replay.r or "")
 if not ok then
 resultLabel.TextColor3 = COLORS.err
 end
 if type(replay.p) == "table" then
 for _, p in ipairs(replay.p) do
 if type(p) == "string" then
 addChip(p)
 end
 end
 end
 chatHideEmpty()
 return nil
 end

 dotsAttach(dots)
 row.Text = rowText("●", COLORS_HEX.warn, "", nil)
 tween(row, { TextTransparency = 0 }, 0.2)
 typeOutRow(row, function(reveal, done)
 return rowText("●", COLORS_HEX.warn, utf8Head(descText, reveal), nil)
 end, utf8Len(descText))
 chatHideEmpty()
 chatScroll()

 local argsJson = "{}"
 pcall(function()
 argsJson = HttpService:JSONEncode(type(args) == "table" and args or {})
 end)
 if #argsJson &gt; 600 then
 argsJson = truncateBytes(argsJson, 600) .. "…"
 end
 argsLabel.Text = argsJson

 local handle = {}

 function handle.finish(envelope)
 local ms = tonumber(envelope.meta and envelope.meta.durationMs) or 0
 local resultText
 if envelope.ok then
 resultText = "{}"
 pcall(function()
 resultText = HttpService:JSONEncode(envelope.result)
 end)
 if #resultText &gt; 900 then
 resultText = truncateBytes(resultText, 900) .. "\n… (truncated — ask the AI or narrow the query)"
 end
 if detailOpen then
 streamLabel(resultLabel, resultText)
 else
 resultLabel.Text = resultText
 end

 typeOutRow(row, function(reveal, done)
 return rowText("•", COLORS_HEX.live, utf8Head(descText, reveal),
 done and (tostring(ms) .. " ms") or nil)
 end, utf8Len(descText), function()
 dotsDetach(dots)
 end)
 else
 resultText = tostring(envelope.error or "")
 if #resultText &gt; 700 then
 resultText = truncateBytes(resultText, 700) .. "…"
 end
 resultLabel.TextColor3 = COLORS.err
 openDetail()
 streamLabel(resultLabel, resultText)
 typeOutRow(row, function(reveal, done)
 return rowText("•", COLORS_HEX.err, utf8Head(descText, reveal), nil)
 end, utf8Len(descText), function()
 dotsDetach(dots)
 end)
 end
 local paths = extractPaths(args, envelope)
 for _, p in ipairs(paths) do
 addChip(p)
 end
 chatPush({
 k = "c", op = tostring(opName), d = descText, a = argsJson,
 r = resultText, ok = envelope.ok, ms = ms, p = paths,
 })
 scheduleCollapse(turn)
 chatScroll()
 end

 return handle
end

local MAX_JSON_DEPTH = 8
local MAX_JSON_ITEMS = 300

local instanceRecord

function instanceRecord(inst)
 local record = nil
 local ok = pcall(function()
 record = {
 type = "Instance",
 ref = makeRef(inst),
 name = inst.Name,
 className = inst.ClassName,
 path = slashPath(inst),
 fullName = inst:GetFullName(),
 children = #inst:GetChildren(),
 }
 end)
 if ok and record ~= nil then
 return record
 end
 return { type = "Instance", name = tostring(inst) }
end

local function jsonSafe(value, depth)
 depth = depth or 1
 local t = typeof(value)
 if value == nil then
 return nil
 end
 if t == "boolean" then
 return value
 end
 if t == "number" then
 if value ~= value or value == math.huge or value == -math.huge then
 return { type = "number", value = tostring(value) }
 end
 return value
 end
 if t == "string" then
 return value
 end
 if t == "Instance" then
 return instanceRecord(value)
 end
 if t == "table" then
 if depth &gt; MAX_JSON_DEPTH then
 return { ["__truncated"] = "max depth reached" }
 end
 local count = 0
 for _ in pairs(value) do
 count = count + 1
 end
 local out = {}
 if count &gt; 0 and #value == count then

 for i, item in ipairs(value) do
 if i &gt; MAX_JSON_ITEMS then
 out[i] = { ["__truncated"] = true }
 break
 end
 local safe = jsonSafe(item, depth + 1)
 if safe ~= nil then
 out[i] = safe
 end
 end
 else

 local inserted = 0
 for key, item in pairs(value) do
 if inserted &gt;= MAX_JSON_ITEMS then
 out["__truncated"] = true
 break
 end
 local safeKey = (type(key) == "string") and key or tostring(key)
 local safe = jsonSafe(item, depth + 1)
 if safe ~= nil then
 out[safeKey] = safe
 inserted = inserted + 1
 end
 end
 end
 return out
 end
 if t == "Vector3" then
 return { type = "Vector3", x = value.X, y = value.Y, z = value.Z }
 end
 if t == "Vector2" then
 return { type = "Vector2", x = value.X, y = value.Y }
 end
 if t == "CFrame" then
 local ok, comps = pcall(function()
 return { value:GetComponents() }
 end)
 if ok and type(comps) == "table" then
 return { type = "CFrame", components = comps }
 end
 return { type = "CFrame", position = { x = value.X, y = value.Y, z = value.Z } }
 end
 if t == "Color3" then
 return {
 type = "Color3",
 r = value.R, g = value.G, b = value.B,
 hex = string.format("#%02X%02X%02X",
 math.floor(value.R * 255 + 0.5),
 math.floor(value.G * 255 + 0.5),
 math.floor(value.B * 255 + 0.5)),
 }
 end
 if t == "UDim" then
 return { type = "UDim", scale = value.Scale, offset = value.Offset }
 end
 if t == "UDim2" then
 return { type = "UDim2", xScale = value.X.Scale, xOffset = value.X.Offset, yScale = value.Y.Scale, yOffset = value.Y.Offset }
 end
 if t == "EnumItem" then
 return { type = "EnumItem", enum = tostring(value.EnumType), name = value.Name, value = value.Value }
 end
 if t == "BrickColor" then
 return { type = "BrickColor", name = value.Name }
 end
 if t == "NumberRange" then
 return { type = "NumberRange", min = value.Min, max = value.Max }
 end
 if t == "NumberSequence" then
 local keypoints = {}
 for i, kp in ipairs(value.Keypoints) do
 keypoints[i] = { time = kp.Time, value = kp.Value, envelope = kp.Envelope }
 end
 return { type = "NumberSequence", keypoints = keypoints }
 end
 if t == "ColorSequence" then
 local keypoints = {}
 for i, kp in ipairs(value.Keypoints) do
 keypoints[i] = { time = kp.Time, color = { r = kp.Value.R, g = kp.Value.G, b = kp.Value.B } }
 end
 return { type = "ColorSequence", keypoints = keypoints }
 end
 if t == "Rect" then
 return { type = "Rect", minX = value.Min.X, minY = value.Min.Y, maxX = value.Max.X, maxY = value.Max.Y }
 end
 if t == "Ray" then
 return { type = "Ray", origin = { x = value.Origin.X, y = value.Origin.Y, z = value.Origin.Z }, direction = { x = value.Direction.X, y = value.Direction.Y, z = value.Direction.Z } }
 end
 if t == "DateTime" then
 return { type = "DateTime", unix = value.UnixTimestamp }
 end
 if t == "PhysicalProperties" then
 return {
 type = "PhysicalProperties",
 density = value.Density, friction = value.Friction,
 elasticity = value.Elasticity, frictionWeight = value.FrictionWeight,
 elasticityWeight = value.ElasticityWeight,
 }
 end
 if t == "Font" then
 return { type = "Font", family = value.Family, weight = tostring(value.Weight), style = tostring(value.Style) }
 end

 local ok, s = pcall(tostring, value)
 return { type = t, value = ok and s or "&lt;unprintable&gt;" }
end

local function parseEnum(s)
 local category, name = string.match(tostring(s), "^Enum%.([%w_]+)%.([%w_]+)$")
 if category == nil then
 category, name = string.match(tostring(s), "^([%w_]+)%.([%w_]+)$")
 end
 if category ~= nil and name ~= nil then
 local ok, result = pcall(function()
 return Enum[category][name]
 end)
 if ok then
 return result
 end
 end
 return nil, "invalid enum reference: " .. tostring(s)
end

local function deserializeValue(v, keyName)
 local t = typeof(v)
 if t == "table" then
 local tag = v["type"]
 if tag == nil then
 return v
 elseif tag == "Instance" then
 return resolveStrict(v.ref or v.path or v.fullName)
 elseif tag == "Vector3" then
 return Vector3.new(v.x or 0, v.y or 0, v.z or 0)
 elseif tag == "Vector2" then
 return Vector2.new(v.x or 0, v.y or 0)
 elseif tag == "Color3" then
 if type(v.hex) == "string" then
 local r, g, b = string.match(v.hex, "^#?(%x%x)(%x%x)(%x%x)$")
 if r ~= nil then
 return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
 end
 end
 return Color3.new(v.r or 0, v.g or 0, v.b or 0)
 elseif tag == "CFrame" then
 if type(v.components) == "table" then
 return CFrame.new(table.unpack(v.components))
 end
 local pos = nil
 if type(v.position) == "table" then
 pos = Vector3.new(v.position.x or 0, v.position.y or 0, v.position.z or 0)
 end

 local ori = v.orientation or v.rotation
 if type(ori) == "table" then
 local rot = CFrame.fromOrientation(math.rad(ori.x or 0), math.rad(ori.y or 0), math.rad(ori.z or 0))
 if pos ~= nil then
 return CFrame.new(pos) * rot
 end
 return rot
 end
 if pos ~= nil and type(v.lookAt) == "table" then
 return CFrame.lookAt(pos,
 Vector3.new(v.lookAt.x or 0, v.lookAt.y or 0, v.lookAt.z or 0))
 end
 if pos ~= nil then
 return CFrame.new(pos)
 end
 return CFrame.new(v.x or 0, v.y or 0, v.z or 0)
 elseif tag == "UDim" then
 return UDim.new(v.scale or 0, v.offset or 0)
 elseif tag == "UDim2" then
 return UDim2.new(v.xScale or 0, v.xOffset or 0, v.yScale or 0, v.yOffset or 0)
 elseif tag == "Enum" or tag == "EnumItem" then
 local e = parseEnum(v.name or v.enum)
 if e == nil and type(v.enum) == "string" and type(v.name) == "string" then
 e = parseEnum(v.enum .. "." .. v.name)
 end
 if e == nil then
 error("invalid enum value for property " .. tostring(keyName), 0)
 end
 return e
 elseif tag == "NumberRange" then
 return NumberRange.new(v.min or 0, v.max or 0)
 elseif tag == "NumberSequence" then
 if type(v.keypoints) == "table" then
 local kps = {}
 for i, kp in ipairs(v.keypoints) do
 kps[i] = NumberSequenceKeypoint.new(kp.time or 0, kp.value or 0, kp.envelope or 0)
 end
 return NumberSequence.new(kps)
 end
 return NumberSequence.new(v.value or 0)
 elseif tag == "ColorSequence" then
 if type(v.keypoints) == "table" then
 local kps = {}
 for i, kp in ipairs(v.keypoints) do
 local c = kp.color or {}
 kps[i] = ColorSequenceKeypoint.new(kp.time or 0, Color3.new(c.r or 0, c.g or 0, c.b or 0))
 end
 return ColorSequence.new(kps)
 end
 return ColorSequence.new(Color3.new(1, 1, 1))
 elseif tag == "Rect" then
 return Rect.new(v.minX or 0, v.minY or 0, v.maxX or 0, v.maxY or 0)
 elseif tag == "BrickColor" then
 return BrickColor.new(tostring(v.name or "Medium stone grey"))
 elseif tag == "Ray" then
 return Ray.new(
 Vector3.new((v.origin or {}).x or 0, (v.origin or {}).y or 0, (v.origin or {}).z or 0),
 Vector3.new((v.direction or {}).x or 0, (v.direction or {}).y or 0, (v.direction or {}).z or 0)
 )
 elseif tag == "DateTime" then
 return DateTime.fromUnixTimestamp(v.unix or 0)
 elseif tag == "PhysicalProperties" then
 return PhysicalProperties.new(v.density or 0.7, v.friction or 0.3, v.elasticity or 0.5, v.frictionWeight or 1, v.elasticityWeight or 1)
 end
 error(string.format("unsupported type '%s' for property '%s' (the marker key is \"type\" - keys starting with $ cannot travel through the relay)", tostring(tag), tostring(keyName)), 0)
 elseif t == "string" then
 if string.sub(v, 1, 5) == "Enum." then
 local e, err = parseEnum(v)
 if e == nil then
 error(tostring(err), 0)
 end
 return e
 end
 if string.sub(v, 1, 2) == "I:" or string.sub(v, 1, 4) == "ref:" then
 local p = (string.sub(v, 1, 4) == "ref:") and string.sub(v, 5) or v
 return resolveStrict(p)
 end
 if keyName == "Color" or keyName == "Color3" or keyName == "BackgroundColor3" or keyName == "TextColor3" then
 local r, g, b = string.match(v, "^#?(%x%x)(%x%x)(%x%x)$")
 if r == nil then
 local s1, s2, s3 = string.match(v, "^#?(%x)(%x)(%x)$")
 if s1 ~= nil then
 r, g, b = s1 .. s1, s2 .. s2, s3 .. s3
 end
 end
 if r ~= nil then
 return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
 end
 end
 return v
 end
 return v
end

local function setProps(inst, props)
 if type(props) ~= "table" then
 error("props must be a table of {propertyName = value}", 0)
 end

 local ORDER = { "Size", "CFrame", "Position", "Orientation", "Rotation" }
 local pending = {}
 for key, value in pairs(props) do
 pending[tostring(key)] = value
 end
 local applied = {}
 local function apply(name)
 local rawValue = pending[name]
 if rawValue == nil then
 return
 end
 pending[name] = nil
 local value = deserializeValue(rawValue, name)
 local ok, err = pcall(function()
 inst[name] = value
 end)
 if not ok then
 error(string.format("failed to set %s.%s = %s: %s",
 inst:GetFullName(), name, tostring(rawValue), tostring(err)), 0)
 end
 table.insert(applied, name)
 end
 for _, name in ipairs(ORDER) do
 apply(name)
 end
 local rest = {}
 for name in pairs(pending) do
 table.insert(rest, name)
 end
 table.sort(rest)
 for _, name in ipairs(rest) do
 apply(name)
 end
 return applied
end

local COMMON_PROPERTIES = {
 "Name", "ClassName", "Parent",
 "Anchored", "CanCollide", "CanTouch", "CanQuery", "CastShadow", "Massless",
 "Material", "Transparency", "Reflectance", "Size", "Position", "CFrame",
 "Color", "Shape", "CollisionGroup", "TopSurface", "BottomSurface",
 "PrimaryPart", "ModelStreamingMode", "LevelOfDetail",
 "Orientation", "Rotation", "PivotOffset",
 "Value",
 "Text", "RichText", "Font", "TextSize", "TextColor3", "TextTransparency",
 "TextWrapped", "TextXAlignment", "BackgroundColor3", "BackgroundTransparency",
 "BorderSizePixel", "Visible", "ZIndex", "ClipsDescendants",
 "Image", "ImageColor3", "ImageTransparency", "ScaleType",
 "SoundId", "Volume", "Looped", "PlaybackSpeed", "TimePosition", "Playing",
 "WalkSpeed", "JumpPower", "JumpHeight", "Health", "MaxHealth", "DisplayName", "HipHeight",
 "RunContext", "Enabled", "Disabled",
 "MeshId", "TextureId", "Scale", "VertexColor",
 "AssetId", "Tags",
}

local function readProperties(inst, requested)
 local names = {}
 for _, n in ipairs(COMMON_PROPERTIES) do
 table.insert(names, n)
 end
 if type(requested) == "table" then
 for _, n in ipairs(requested) do
 table.insert(names, tostring(n))
 end
 end
 local out = {}
 for _, name in ipairs(names) do
 if name ~= "Source" then
 local value = nil
 local ok = pcall(function()
 value = inst[name]
 end)
 if ok and value ~= nil then
 out[name] = jsonSafe(value)
 end
 end
 end
 local okTags, tags = pcall(function()
 return inst:GetTags()
 end)
 if okTags and type(tags) == "table" then
 out.tags = tags
 end
 return out
end

local function getScriptSource(inst)
 if not inst:IsA("LuaSourceContainer") then
 return nil, nil
 end
 local ok, source = pcall(function()
 return inst.Source
 end)
 if not ok then
 return nil, tostring(source)
 end
 return source, nil
end

local function waypoint(label)
 pcall(function()
 ChangeHistoryService:SetWaypoint("Golem: " .. tostring(label))
 end)
end

local http

local OPS = {}

function OPS.ping()
 return {
 ok = true,
 plugin = PLUGIN_TITLE,
 version = VERSION,
 studio = STUDIO_VERSION,
 uptimeSeconds = math.floor(os.clock() - state.startedAt + 0.5),
 placeName = game.Name,
 placeId = game.PlaceId,
 gameId = game.GameId,
 features = { marketplace = false },
 }
end

function OPS.setup()
 error("the 'setup' op was retired: this plugin (v3+) no longer serves files over the relay - your golem-bridge CLI is too old. Ask the user to re-send the setup line and run it fresh so npx pulls golem-bridge v3+.", 0)
end

local function getPivotCFrame(inst)
 if inst:IsA("BasePart") then
 return inst.CFrame
 elseif inst:IsA("Model") then
 return inst:GetPivot()
 end
 return nil
end

local function setPivotCFrame(inst, cf)
 if inst:IsA("BasePart") then
 inst.CFrame = cf
 elseif inst:IsA("Model") then
 inst:PivotTo(cf)
 end
end

function OPS.rotate(args)
 local targets = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(targets, p)
 end
 elseif args.path ~= nil then
 table.insert(targets, args.path)
 end
 if #targets == 0 then
 error("args.path (or args.paths) is required", 0)
 end

 local function rotatedRecords()
 local out = {}
 for _, p in ipairs(targets) do
 local inst = resolveStrict(p)
 table.insert(out, { path = slashPath(inst), className = inst.ClassName })
 end
 return out
 end

 local function notRotatable(inst)
 return string.format("%s is a %s - rotation needs a BasePart or a Model",
 inst:GetFullName(), inst.ClassName)
 end

 local setTo = args.orientation or args.set
 if setTo ~= nil then
 if type(setTo) ~= "table" then
 error("args.orientation must be {x=,y=,z=} in degrees", 0)
 end
 local rx = tonumber(setTo.x) or 0
 local ry = tonumber(setTo.y) or 0
 local rz = tonumber(setTo.z) or 0
 for _, p in ipairs(targets) do
 local inst = resolveStrict(p)
 local cf = getPivotCFrame(inst)
 if cf == nil then
 error(notRotatable(inst), 0)
 end
 setPivotCFrame(inst, CFrame.new(cf.Position)
 * CFrame.fromOrientation(math.rad(rx), math.rad(ry), math.rad(rz)))
 end
 waypoint("rotate")
 return { rotated = rotatedRecords(), count = #targets, mode = "set",
 orientation = { x = rx, y = ry, z = rz } }
 end

 local space = string.lower(tostring(args.space or "world"))
 if space ~= "world" and space ~= "local" then
 error("args.space must be 'world' (default) or 'local'", 0)
 end
 local degrees = tonumber(args.degrees) or tonumber(args.angle)
 if degrees == nil then
 error("provide args.degrees + args.axis (relative) or args.orientation (absolute)", 0)
 end
 local axis = args.axis
 local axisVec, axisLabel
 if type(axis) == "string" then
 local name = string.lower(axis)
 if name == "x" or name == "right" then
 axisVec, axisLabel = Vector3.new(1, 0, 0), name
 elseif name == "y" or name == "up" then
 axisVec, axisLabel = Vector3.new(0, 1, 0), name
 elseif name == "z" or name == "forward" or name == "look" then
 axisVec, axisLabel = Vector3.new(0, 0, -1), name
 end
 elseif type(axis) == "table" then
 axisVec = Vector3.new(tonumber(axis.x) or 0, tonumber(axis.y) or 0, tonumber(axis.z) or 0)
 axisLabel = string.format("{%.2f,%.2f,%.2f}", axisVec.X, axisVec.Y, axisVec.Z)
 end
 if axisVec == nil or axisVec.Magnitude == 0 then
 error('args.axis is required: "x"/"y"/"z"/"up"/"right"/"forward" or {x=,y=,z=}', 0)
 end
 axisVec = axisVec.Unit
 for _, p in ipairs(targets) do
 local inst = resolveStrict(p)
 local cf = getPivotCFrame(inst)
 if cf == nil then
 error(notRotatable(inst), 0)
 end
 local rot = CFrame.fromAxisAngle(axisVec, math.rad(degrees))
 if space == "local" then

 setPivotCFrame(inst, cf * rot)
 else

 local pos = cf.Position
 setPivotCFrame(inst, CFrame.new(pos) * rot * CFrame.new(-pos) * cf)
 end
 end
 waypoint("rotate")
 return { rotated = rotatedRecords(), count = #targets, mode = "add",
 space = space, axis = axisLabel, degrees = degrees }
end

function OPS.face(args)
 local inst = resolveStrict(args.path)
 local cf = getPivotCFrame(inst)
 if cf == nil then
 error(string.format("%s is a %s - face needs a BasePart or a Model",
 inst:GetFullName(), inst.ClassName), 0)
 end
 local axisName = string.lower(tostring(args.axis or "forward"))
 if axisName == "forward" or axisName == "look" or axisName == "z" then
 axisName = "forward"
 elseif axisName == "up" or axisName == "y" then
 axisName = "up"
 elseif axisName == "right" or axisName == "x" then
 axisName = "right"
 else
 error('args.axis must be "forward" (default), "up" or "right"', 0)
 end
 local dir
 if type(args.target) == "table" then
 dir = Vector3.new(tonumber(args.target.x) or 0, tonumber(args.target.y) or 0, tonumber(args.target.z) or 0) - cf.Position
 elseif type(args.direction) == "table" then
 dir = Vector3.new(tonumber(args.direction.x) or 0, tonumber(args.direction.y) or 0, tonumber(args.direction.z) or 0)
 else
 error("args.target {x,y,z} (a world point) or args.direction {x,y,z} is required", 0)
 end
 if dir.Magnitude &lt; 1e-6 then
 error("direction is zero-length", 0)
 end
 dir = dir.Unit
 local base = CFrame.lookAt(cf.Position, cf.Position + dir)
 local newCf = base
 if axisName == "up" then
 newCf = base * CFrame.Angles(math.rad(-90), 0, 0)
 elseif axisName == "right" then
 newCf = base * CFrame.Angles(0, math.rad(90), 0)
 end
 setPivotCFrame(inst, newCf)
 waypoint("face")
 return { path = slashPath(inst), axis = axisName,
 facing = { x = dir.X, y = dir.Y, z = dir.Z } }
end

function OPS.shift(args)
 local targets = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(targets, p)
 end
 elseif args.path ~= nil then
 table.insert(targets, args.path)
 end
 if #targets == 0 then
 error("args.path (or args.paths) is required", 0)
 end
 local off = args.offset
 if type(off) ~= "table" then
 error("args.offset {x=,y=,z} is required (studs)", 0)
 end
 local v = Vector3.new(tonumber(off.x) or 0, tonumber(off.y) or 0, tonumber(off.z) or 0)
 if v.Magnitude == 0 then
 error("offset is zero", 0)
 end
 local space = string.lower(tostring(args.space or "world"))
 if space ~= "world" and space ~= "local" then
 error("args.space must be 'world' (default) or 'local'", 0)
 end
 local moved = {}
 for _, p in ipairs(targets) do
 local inst = resolveStrict(p)
 local cf = getPivotCFrame(inst)
 if cf == nil then
 error(string.format("%s is a %s - shift needs a BasePart or a Model",
 inst:GetFullName(), inst.ClassName), 0)
 end
 local delta = (space == "local") and cf:VectorToWorldSpace(v) or v
 setPivotCFrame(inst, cf + delta)
 table.insert(moved, slashPath(inst))
 end
 waypoint("shift")
 return { moved = moved, count = #moved, offset = { x = v.X, y = v.Y, z = v.Z }, space = space }
end

function OPS.scale(args)
 local factor = tonumber(args.factor)
 if factor == nil or factor &lt;= 0 then
 error("args.factor (a positive number, relative multiplier) is required", 0)
 end
 local inst = resolveStrict(args.path)
 if inst:IsA("Model") then
 local current = 1
 pcall(function()
 current = inst:GetScale()
 end)
 inst:ScaleTo(current * factor)
 elseif inst:IsA("BasePart") then
 inst.Size = inst.Size * factor
 else
 error(string.format("%s is a %s - scale needs a BasePart or a Model",
 inst:GetFullName(), inst.ClassName), 0)
 end
 waypoint("scale")
 return { path = slashPath(inst), factor = factor }
end

function OPS.duplicate(args)
 local inst = resolveStrict(args.path)
 local count = math.clamp(tonumber(args.count) or 1, 1, 200)
 local offset = Vector3.zero
 if type(args.offset) == "table" then
 offset = Vector3.new(tonumber(args.offset.x) or 0, tonumber(args.offset.y) or 0, tonumber(args.offset.z) or 0)
 end
 local parent = (args.parent ~= nil) and resolveStrict(args.parent) or inst.Parent
 local baseName = tostring(args.name or inst.Name)
 local copies = {}
 for i = 1, count do
 local clone = inst:Clone()
 clone.Name = (count &gt; 1) and (baseName .. " " .. tostring(i)) or baseName
 if offset.Magnitude &gt; 0 then
 local cf = getPivotCFrame(inst)
 if cf ~= nil then
 setPivotCFrame(clone, cf + offset * i)
 end
 end
 clone.Parent = parent
 table.insert(copies, instanceRecord(clone))
 end
 waypoint("duplicate")
 return { count = count, copies = copies, parent = slashPath(parent) }
end

function OPS.group(args)
 if type(args.paths) ~= "table" or #args.paths == 0 then
 error("args.paths (an array of paths/refs) is required", 0)
 end
 local first = resolveStrict(args.paths[1])
 local parent = (args.parent ~= nil) and resolveStrict(args.parent) or first.Parent
 if args.parent ~= nil then
 for _, p in ipairs(args.paths) do
 local member = resolveStrict(p)
 if parent == member or parent:IsDescendantOf(member) then
 error("args.parent must not be one of the grouped instances or inside one of them", 0)
 end
 end
 end
 local model = Instance.new("Model")
 model.Name = tostring(args.name or "Group")
 local members = {}
 for _, p in ipairs(args.paths) do
 local inst = resolveStrict(p)
 table.insert(members, slashPath(inst))
 inst.Parent = model
 end
 model.Parent = parent
 pcall(function()
 model.WorldPivot = model:GetBoundingBox()
 end)
 waypoint("group")
 local record = instanceRecord(model)
 record.members = members
 return record
end

function OPS.set_pivot(args)
 local inst = resolveStrict(args.path)
 local current
 local okRead = pcall(function()
 current = inst.WorldPivot
 end)
 if not okRead or current == nil then
 error(inst:GetFullName() .. " has no pivot", 0)
 end
 local pos, ori = args.position, args.orientation
 if pos == nil and ori == nil then
 error("args.position and/or args.orientation {x,y,z} required (orientation in degrees)", 0)
 end
 local newCf
 if type(pos) == "table" then
 newCf = CFrame.new(tonumber(pos.x) or 0, tonumber(pos.y) or 0, tonumber(pos.z) or 0)
 else
 newCf = CFrame.new(current.Position)
 end
 if type(ori) == "table" then
 newCf = newCf * CFrame.fromOrientation(
 math.rad(tonumber(ori.x) or 0),
 math.rad(tonumber(ori.y) or 0),
 math.rad(tonumber(ori.z) or 0))
 else
 newCf = newCf * (current - current.Position)
 end
 local ok, err = pcall(function()
 inst.WorldPivot = newCf
 end)
 if not ok then
 error("could not set pivot: " .. tostring(err), 0)
 end
 waypoint("pivot " .. slashPath(inst))
 return { path = slashPath(inst),
 pivot = { position = { x = newCf.Position.X, y = newCf.Position.Y, z = newCf.Position.Z } } }
end

function OPS.terrain(args)
 local terrain = workspace.Terrain
 local action = string.lower(tostring(args.action or "fill"))
 if action ~= "fill" and action ~= "clear" then
 error('args.action must be "fill" or "clear" (clear = fill with Air)', 0)
 end
 local shape = string.lower(tostring(args.shape or "block"))
 local pos = args.position or args.center
 if type(pos) ~= "table" then
 error("args.position {x,y,z} is required", 0)
 end
 local center = Vector3.new(tonumber(pos.x) or 0, tonumber(pos.y) or 0, tonumber(pos.z) or 0)
 local material = Enum.Material.Air
 if action == "fill" then
 local matName = tostring(args.material or "Grass")
 local parsed = parseEnum(matName)
 if parsed == nil then
 parsed = parseEnum("Enum.Material." .. matName)
 end
 if parsed == nil then
 error("unknown material '" .. matName .. "' (e.g. Grass, Rock, Sand, Water, Wood)", 0)
 end
 material = parsed
 end
 if shape == "block" then
 local size = args.size
 if type(size) ~= "table" then
 error("args.size {x,y,z} is required for shape=block", 0)
 end
 terrain:FillBlock(center,
 Vector3.new(tonumber(size.x) or 1, tonumber(size.y) or 1, tonumber(size.z) or 1), material)
 elseif shape == "ball" then
 local radius = tonumber(args.radius)
 if radius == nil then
 error("args.radius is required for shape=ball", 0)
 end
 terrain:FillBall(center, radius, material)
 else
 error('args.shape must be "block" or "ball"', 0)
 end
 waypoint("terrain " .. action .. " " .. shape)
 return { action = action, shape = shape, material = tostring(material),
 position = { x = center.X, y = center.Y, z = center.Z } }
end

function OPS.say(args)
 local text = args.text or args.message
 if type(text) ~= "string" or #text == 0 then
 error("args.text (a short message for the user) is required", 0)
 end

 abandonedTurn = nil
 addChatMessage(text)
 return { ok = true, delivered = true }
end

function OPS.turn_begin(args)
 if currentTurn ~= nil then
 error(string.format("a turn is already open (%d tools). End it first: turn end --note \"your reply\"", currentTurn.count), 0)
 end
 local turn = beginTurn()
 turn.explicit = true
 scheduleCollapse(turn)
 return { ok = true, begun = true }
end

function OPS.turn_end(args)
 local note = (type(args) == "table" and type(args.note) == "string") and args.note or nil
 if note == nil or #note == 0 then
 error('a closing note is required - end the turn with: turn end --note "your reply to the user"', 0)
 end
 if currentTurn ~= nil then
 local count = currentTurn.count
 addChatMessage(note, true, true)
 return { ok = true, ended = true, tools = count }
 end
 if abandonedTurn ~= nil then
 local count = abandonedTurn.count
 abandonedTurn = nil
 addChatMessage(note, true, true)
 return { ok = true, ended = true, tools = count, late = true }
 end
 addChatMessage(note, true, true)
 return { ok = true, ended = true, tools = 0 }
end

function OPS.run(args)
 if loadstring == nil then
 error("loadstring is not available in this context", 0)
 end
 local code = args.code
 if type(code) ~= "string" or #code == 0 then
 error("args.code (a string of Lua) is required", 0)
 end
 local chunk, compileError = loadstring(code, "=ai-bridge-run")
 if chunk == nil then
 error("Lua compile error: " .. tostring(compileError), 0)
 end
 local results = table.pack(pcall(chunk))
 if results[1] ~= true then
 error("runtime error: " .. tostring(results[2]), 0)
 end
 local returned = results.n - 1
 local values = {}
 for i = 1, math.min(returned, 12) do
 local safe = jsonSafe(results[i + 1])
 if safe == nil then
 safe = { type = "nil" }
 end
 table.insert(values, safe)
 end
 if returned &gt; 12 then
 table.insert(values, { ["__note"] = string.format("...%d more return values truncated", returned - 12) })
 end
 return { returnCount = returned, values = values }
end

function OPS.list(args)
 local inst = resolveStrict(args.path or "game")
 local record = instanceRecord(inst)
 if args.recursive == true then
 local max = math.min(tonumber(args.max) or 500, 5000)
 local all = inst:GetDescendants()
 local descendants = {}
 for i = 1, math.min(#all, max) do
 table.insert(descendants, instanceRecord(all[i]))
 end
 record.descendantCount = #all
 record.truncated = (#all &gt; max)
 record.descendants = descendants
 else
 local children = {}
 for _, child in ipairs(inst:GetChildren()) do
 table.insert(children, instanceRecord(child))
 end
 record.children = children
 end
 return record
end

function OPS.tree(args)
 local rootInst = resolveStrict(args.path or "game")
 local depth = math.clamp(tonumber(args.depth) or 2, 0, 12)
 local maxChildren = math.clamp(tonumber(args.maxChildren) or 50, 1, 500)
 local maxNodes = math.clamp(tonumber(args.maxNodes) or 600, 1, 5000)
 local nodeCount = 0
 local truncated = false

 local function build(inst, remainingDepth)
 nodeCount = nodeCount + 1
 local node = instanceRecord(inst)
 if remainingDepth &gt; 0 then
 local children = inst:GetChildren()
 if #children &gt; maxChildren then
 node.childCount = #children
 end
 node.children = {}
 for i, child in ipairs(children) do
 if i &gt; maxChildren or nodeCount &gt;= maxNodes then
 truncated = true
 break
 end
 table.insert(node.children, build(child, remainingDepth - 1))
 end
 end
 return node
 end

 local tree = build(rootInst, depth)
 return { path = slashPath(rootInst), depth = depth, truncated = truncated, nodeCount = nodeCount, tree = tree }
end

function OPS.read(args)
 local inst = resolveStrict(args.path)
 local record = instanceRecord(inst)
 local source, sourceErr = getScriptSource(inst)
 if source ~= nil then
 record.source = source
 record.sourceLineCount = select(2, string.gsub(source, "\n", "")) + 1
 elseif sourceErr ~= nil then
 record.sourceError = sourceErr
 end
 local okAttrs, attrs = pcall(inst.GetAttributes, inst)
 if okAttrs and type(attrs) == "table" then
 local safe = {}
 for k, v in pairs(attrs) do
 safe[tostring(k)] = jsonSafe(v)
 end
 record.attributes = safe
 end
 record.properties = readProperties(inst, args.props)
 return record
end

function OPS.create(args)
 local class = args.class
 if type(class) ~= "string" or #class == 0 then
 error("args.class is required (e.g. 'Script', 'ModuleScript', 'Folder', 'Part')", 0)
 end
 if args.parent == nil then
 error("args.parent is required (path or ref of the parent, e.g. 'ServerStorage')", 0)
 end
 local okNew, instOrErr = pcall(Instance.new, class)
 if not okNew or instOrErr == nil then
 error(string.format("cannot create Instance of class '%s': %s", class, tostring(instOrErr)), 0)
 end
 local inst = instOrErr
 if args.name ~= nil then
 if string.find(tostring(args.name), "/", 1, true) ~= nil then
 error("names must not contain '/' (it is the path separator)", 0)
 end
 inst.Name = tostring(args.name)
 end
 if args.source ~= nil then
 local okSrc, errSrc = pcall(function()
 inst.Source = tostring(args.source)
 end)
 if not okSrc then
 error(string.format(
 "failed to set Source on the new %s (only Script/LocalScript/ModuleScript have Source): %s",
 class, tostring(errSrc)), 0)
 end
 end
 if args.props ~= nil then
 setProps(inst, args.props)
 end
 if type(args.position) == "table" then
 local okPos, errPos = pcall(function()
 inst.Position = Vector3.new(
 tonumber(args.position.x) or 0,
 tonumber(args.position.y) or 0,
 tonumber(args.position.z) or 0)
 end)
 if not okPos then
 error("could not set position on a " .. class .. ": " .. tostring(errPos), 0)
 end
 end
 if type(args.orientation) == "table" then

 local okOri, errOri = pcall(function()
 inst.Orientation = Vector3.new(
 tonumber(args.orientation.x) or 0,
 tonumber(args.orientation.y) or 0,
 tonumber(args.orientation.z) or 0)
 end)
 if not okOri then
 error("could not set orientation on a " .. class .. " (parts/models only): " .. tostring(errOri), 0)
 end
 end
 inst.Parent = resolveStrict(args.parent)
 waypoint("create " .. class .. " " .. inst.Name)
 local record = instanceRecord(inst)
 record.created = true
 return record
end

function OPS.write(args)
 local inst = resolveStrict(args.path)
 if args.source ~= nil then
 local okSrc, errSrc = pcall(function()
 inst.Source = tostring(args.source)
 end)
 if not okSrc then
 error(string.format("failed to set Source on %s (%s): %s",
 inst:GetFullName(), inst.ClassName, tostring(errSrc)), 0)
 end
 end
 local applied = {}
 if args.props ~= nil then
 applied = setProps(inst, args.props)
 end
 waypoint("write " .. inst:GetFullName())
 local record = instanceRecord(inst)
 record.updated = true
 record.propertiesApplied = applied
 return record
end

function OPS.script(args)

 local parentInst = resolveStrict(args.parent or "game")
 local name = args.name
 if type(name) ~= "string" or #name == 0 then
 error("args.name is required (the script's name)", 0)
 end
 if string.find(name, "/", 1, true) ~= nil then
 error("names must not contain '/' (it is the path separator)", 0)
 end
 local class = args.class or "Script"
 if class ~= "Script" and class ~= "LocalScript" and class ~= "ModuleScript" then
 error("args.class must be Script, LocalScript, or ModuleScript", 0)
 end
 local mode = args.mode or "create"
 if mode ~= "create" and mode ~= "update" and mode ~= "replace" then
 error("args.mode must be create, update, or replace", 0)
 end
 if type(args.source) ~= "string" then
 error("args.source (the full Lua source) is required", 0)
 end
 local existing = parentInst:FindFirstChild(name)
 if existing ~= nil and mode == "create" then
 error(string.format("'%s' already exists under %s (use mode=update or mode=replace)",
 name, slashPath(parentInst)), 0)
 end
 local inst
 local created = true
 if existing ~= nil and mode == "update" then
 if not (existing:IsA("Script") or existing:IsA("LocalScript") or existing:IsA("ModuleScript")) then
 error(string.format("%s is a %s, not a script", slashPath(existing), existing.ClassName), 0)
 end
 inst = existing
 created = false
 else
 if existing ~= nil then
 existing:Destroy()
 end
 inst = Instance.new(class)
 inst.Name = name
 inst.Parent = parentInst
 end
 local okSrc, errSrc = pcall(function()
 inst.Source = args.source
 end)
 if not okSrc then
 error(string.format("failed to set Source on %s: %s", slashPath(inst), tostring(errSrc)), 0)
 end
 waypoint("script " .. slashPath(inst))
 local record = instanceRecord(inst)
 record.created = created
 record.mode = mode
 return record
end

function OPS.delete(args)
 local targets = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(targets, p)
 end
 elseif args.path ~= nil then
 table.insert(targets, args.path)
 end
 if #targets == 0 then
 error("provide args.path (string) or args.paths (array of paths/refs)", 0)
 end
 local doomed = {}
 for _, p in ipairs(targets) do
 table.insert(doomed, resolveStrict(p))
 end
 local deleted = {}
 for _, inst in ipairs(doomed) do
 table.insert(deleted, inst:GetFullName())
 inst:Destroy()
 end
 waypoint("delete")
 return { deleted = deleted, count = #deleted }
end

function OPS.move(args)
 if args.path == nil or args.parent == nil then
 error("args.path and args.parent are both required", 0)
 end
 local inst = resolveStrict(args.path)
 local parent = resolveStrict(args.parent)
 inst.Parent = parent
 waypoint("move " .. inst.Name)
 local record = instanceRecord(inst)
 record.moved = true
 return record
end

function OPS.find(args)
 if type(args.tag) == "string" and #args.tag &gt; 0 then

 local scope = resolveStrict(args.scope or "game")
 local scopeRoot = slashPath(scope)
 local prefix = scopeRoot .. "/"
 local max = math.min(tonumber(args.max) or 200, 2000)
 local matches = {}
 local tagTruncated = false
 for _, inst in ipairs(CollectionService:GetTagged(args.tag)) do
 local p = slashPath(inst)
 if p == scopeRoot or string.sub(p, 1, #prefix) == prefix then
 table.insert(matches, { path = p, className = inst.ClassName })
 if #matches &gt;= max then
 tagTruncated = true
 break
 end
 end
 end
 return { query = "#" .. args.tag, scope = scopeRoot, count = #matches, truncated = tagTruncated, results = matches }
 end
 local query = args.query
 if type(query) ~= "string" or #query == 0 then
 error("args.query is required (substring of an instance name)", 0)
 end
 local scope = resolveStrict(args.scope or "game")
 local classFilter = args.class
 if type(classFilter) == "string" and #classFilter &gt; 0 then
 local okClass = pcall(function()
 return scope:IsA(classFilter)
 end)
 if not okClass then
 error(string.format("unknown class '%s'", classFilter), 0)
 end
 end
 local max = math.min(tonumber(args.max) or 200, 2000)
 local exact = args.exact == true
 local caseSensitive = args.caseSensitive == true
 local needle = caseSensitive and query or string.lower(query)

 local function nameMatches(name)
 local n = caseSensitive and name or string.lower(name)
 if exact then
 return n == needle
 end
 return string.find(n, needle, 1, true) ~= nil
 end

 local matches = {}
 local truncated = false
 for _, desc in ipairs(scope:GetDescendants()) do
 if nameMatches(desc.Name) then
 local classOk = true
 if classFilter ~= nil then
 local ok = false
 pcall(function()
 ok = desc:IsA(classFilter)
 end)
 classOk = ok
 end
 if classOk then
 table.insert(matches, instanceRecord(desc))
 if #matches &gt;= max then
 truncated = true
 break
 end
 end
 end
 end
 return { query = query, scope = slashPath(scope), count = #matches, truncated = truncated, results = matches }
end

function OPS.grep(args)
 local pattern = args.pattern
 if type(pattern) ~= "string" or #pattern == 0 then
 error("args.pattern is required", 0)
 end
 local plain = args.plain ~= false
 local caseSensitive = args.caseSensitive ~= false
 local scope = resolveStrict(args.scope or "game")
 local max = math.min(tonumber(args.max) or 100, 1000)
 local needle = caseSensitive and pattern or string.lower(pattern)

 local function lineMatches(line)
 local hay = caseSensitive and line or string.lower(line)
 if plain then
 return string.find(hay, needle, 1, true) ~= nil
 end
 return string.find(hay, needle) ~= nil
 end

 local matches = {}
 local truncated = false
 for _, desc in ipairs(scope:GetDescendants()) do
 if truncated then
 break
 end
 local isScript = false
 pcall(function()
 isScript = desc:IsA("LuaSourceContainer")
 end)
 if isScript then
 local okSrc, source = pcall(function()
 return desc.Source
 end)
 if okSrc and type(source) == "string" then
 local lineNo = 0
 local text = source
 if string.sub(text, -1) ~= "\n" then
 text = text .. "\n"
 end
 for line in string.gmatch(text, "(.-)\r?\n") do
 lineNo = lineNo + 1
 if lineMatches(line) then
 table.insert(matches, {
 path = slashPath(desc),
 fullName = desc:GetFullName(),
 name = desc.Name,
 line = lineNo,
 text = line,
 })
 if #matches &gt;= max then
 truncated = true
 break
 end
 end
 end
 end
 end
 end
 return { pattern = pattern, scope = slashPath(scope), count = #matches, truncated = truncated, matches = matches }
end

local function hexToColor(value)

 local hex = string.gsub(tostring(value), "^#", "")
 if #hex == 3 then
 hex = string.sub(hex, 1, 1) .. string.sub(hex, 1, 1)
 .. string.sub(hex, 2, 2) .. string.sub(hex, 2, 2)
 .. string.sub(hex, 3, 3) .. string.sub(hex, 3, 3)
 end
 if #hex ~= 6 or string.match(hex, "%X") ~= nil then
 error(string.format("bad color '%s' - use #RRGGBB", tostring(value)), 0)
 end
 return Color3.fromRGB(
 tonumber(string.sub(hex, 1, 2), 16),
 tonumber(string.sub(hex, 3, 4), 16),
 tonumber(string.sub(hex, 5, 6), 16))
end

local function vfxColor(value, fallback)
 if type(value) == "string" and #value &gt; 0 then
 return hexToColor(value)
 end
 return fallback
end

function OPS.beam(args)

 local fromInst = resolveStrict(args.from)
 local toInst = resolveStrict(args.to)
 if not fromInst:IsA("BasePart") or not toInst:IsA("BasePart") then
 error("args.from and args.to must both be parts", 0)
 end
 local color = vfxColor(args.color, Color3.fromRGB(120, 180, 255))
 local width = tonumber(args.width) or 0.4
 local a0 = fromInst:FindFirstChild("BeamAttachment0")
 if a0 == nil or not a0:IsA("Attachment") then
 a0 = Instance.new("Attachment")
 a0.Name = "BeamAttachment0"
 a0.Parent = fromInst
 end
 local a1 = toInst:FindFirstChild("BeamAttachment1")
 if a1 == nil or not a1:IsA("Attachment") then
 a1 = Instance.new("Attachment")
 a1.Name = "BeamAttachment1"
 a1.Parent = toInst
 end
 local beam = fromInst:FindFirstChild(args.name or "Beam")
 if beam == nil or not beam:IsA("Beam") then
 beam = Instance.new("Beam")
 beam.Name = args.name or "Beam"
 beam.Parent = fromInst
 end
 beam.Attachment0 = a0
 beam.Attachment1 = a1
 beam.Color = ColorSequence.new(color)
 beam.Width0 = width
 beam.Width1 = width
 beam.Transparency = NumberSequence.new(0.2)
 beam.LightEmission = 1
 beam.FaceCamera = true
 beam.Segments = 12
 local curve = tonumber(args.curve) or 0
 beam.CurveSize0 = curve
 beam.CurveSize1 = curve
 beam.Parent = fromInst
 waypoint("beam " .. slashPath(fromInst))
 return { beam = slashPath(beam), from = slashPath(fromInst), to = slashPath(toInst), width = width }
end

function OPS.trail(args)

 local inst = resolveStrict(args.path)
 if not inst:IsA("BasePart") then
 error("args.path must be a BasePart to trail behind", 0)
 end
 local color = vfxColor(args.color, Color3.fromRGB(255, 255, 255))
 local lifetime = tonumber(args.lifetime) or 0.6
 local half = math.max(inst.Size.Y, inst.Size.Z) / 2
 local a0 = inst:FindFirstChild("TrailAttachment0")
 if a0 == nil or not a0:IsA("Attachment") then
 a0 = Instance.new("Attachment")
 a0.Name = "TrailAttachment0"
 a0.Parent = inst
 end
 a0.Position = Vector3.new(0, half, 0)
 local a1 = inst:FindFirstChild("TrailAttachment1")
 if a1 == nil or not a1:IsA("Attachment") then
 a1 = Instance.new("Attachment")
 a1.Name = "TrailAttachment1"
 a1.Parent = inst
 end
 a1.Position = Vector3.new(0, -half, 0)
 local trail = inst:FindFirstChild(args.name or "Trail")
 if trail == nil or not trail:IsA("Trail") then
 trail = Instance.new("Trail")
 trail.Name = args.name or "Trail"
 trail.Parent = inst
 end
 trail.Attachment0 = a0
 trail.Attachment1 = a1
 trail.Lifetime = lifetime
 trail.Color = ColorSequence.new(color)
 trail.LightEmission = 0.8
 trail.FaceCamera = true
 trail.Transparency = NumberSequence.new({
 NumberSequenceKeypoint.new(0, 0.3),
 NumberSequenceKeypoint.new(1, 1),
 })
 trail.Parent = inst
 waypoint("trail " .. slashPath(inst))
 return { trail = slashPath(trail), path = slashPath(inst), lifetime = lifetime }
end

function OPS.explosion(args)

 local pos = Vector3.new(0, 10, 0)
 if type(args.position) == "table" then
 pos = Vector3.new(tonumber(args.position.x) or 0,
 tonumber(args.position.y) or 10, tonumber(args.position.z) or 0)
 end
 local boom = Instance.new("Explosion")
 boom.Position = pos
 boom.BlastRadius = tonumber(args.radius) or 8
 boom.BlastPressure = 0
 boom.DestroyJointRadiusPercent = 0
 boom.Parent = workspace
 task.delay(2, function()
 if boom ~= nil and boom.Parent ~= nil then
 boom:Destroy()
 end
 end)
 waypoint("explosion")
 return { position = { x = pos.X, y = pos.Y, z = pos.Z }, radius = boom.BlastRadius, harmless = true }
end

local UI_FONTS = {
 regular = Enum.Font.Gotham,
 medium = Enum.Font.GothamMedium,
 semibold = Enum.Font.GothamBold,
 bold = Enum.Font.GothamBold,
 mono = Enum.Font.Code,
}

local function uiName(args)
 local n = args.name
 if type(n) ~= "string" or #n == 0 then
 error("args.name is required", 0)
 end
 if string.find(n, "/", 1, true) then
 error("names cannot contain '/' (it would break Golem paths)", 0)
 end
 return n
end

local function parseUDim2Arg(value, fallback)
 if value == nil then
 return fallback
 end
 local parts = {}
 for token in string.gmatch(tostring(value), "[^,]+") do
 table.insert(parts, tonumber(token))
 end
 if #parts ~= 4 or parts[1] == nil or parts[2] == nil or parts[3] == nil or parts[4] == nil then
 error(string.format("bad UDim2 '%s' - use 'xscale,xoffset,yscale,yoffset', e.g. 0.5,0,0.5,0", tostring(value)), 0)
 end
 return UDim2.new(parts[1], parts[2], parts[3], parts[4])
end

local function parseAnchor(value)
 if value == nil then
 return Vector2.new(0, 0)
 end
 local ax, ay = string.match(tostring(value), "^%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)%s*$")
 if ax == nil then
 error(string.format("bad anchor '%s' - use 'x,y', e.g. 0.5,0.5", tostring(value)), 0)
 end
 local nx, ny = tonumber(ax), tonumber(ay)
 if nx == nil or ny == nil then
 error(string.format("bad anchor '%s' - use 'x,y', e.g. 0.5,0.5", tostring(value)), 0)
 end
 return Vector2.new(nx, ny)
end

function OPS.ui_screen(args)

 local name = uiName(args)
 local parent
 if args.parent ~= nil then
 parent = resolveStrict(args.parent)
 else
 parent = game:GetService("StarterGui")
 end
 local guiInst = Instance.new("ScreenGui")
 guiInst.Name = name
 guiInst.ResetOnSpawn = false
 guiInst.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
 guiInst.DisplayOrder = tonumber(args.order) or 0
 guiInst.Parent = parent
 waypoint("ui_screen " .. name)
 return { screen = slashPath(guiInst), parent = slashPath(parent) }
end

function OPS.ui_frame(args)

 local parent = resolveStrict(args.parent)
 local name = uiName(args)
 local frameInst = Instance.new("Frame")
 frameInst.Name = name
 frameInst.BackgroundColor3 = vfxColor(args.color, Color3.fromRGB(28, 30, 38))
 frameInst.BorderSizePixel = 0
 frameInst.BackgroundTransparency = tonumber(args.transparency) or 0
 frameInst.Position = parseUDim2Arg(args.position, UDim2.new(0, 0, 0, 0))
 frameInst.Size = parseUDim2Arg(args.size, UDim2.new(1, 0, 1, 0))
 frameInst.AnchorPoint = parseAnchor(args.anchor)
 frameInst.ClipsDescendants = (args.clip == true)
 local corner = Instance.new("UICorner")
 corner.CornerRadius = UDim.new(0, tonumber(args.radius) or 8)
 corner.Parent = frameInst
 frameInst.Parent = parent
 waypoint("ui_frame " .. slashPath(frameInst))
 return { frame = slashPath(frameInst), parent = slashPath(parent) }
end

function OPS.ui_label(args)

 local parent = resolveStrict(args.parent)
 local name = uiName(args)
 local labelInst = Instance.new("TextLabel")
 labelInst.Name = name
 labelInst.BackgroundTransparency = 1
 labelInst.Font = UI_FONTS[string.lower(tostring(args.font or "medium"))] or Enum.Font.GothamMedium
 labelInst.Text = tostring(args.text or "")
 labelInst.TextSize = tonumber(args.text_size) or 16
 labelInst.TextColor3 = vfxColor(args.color, Color3.fromRGB(242, 242, 247))
 local align = string.lower(tostring(args.align or "left"))
 if align == "center" or align == "centre" then
 labelInst.TextXAlignment = Enum.TextXAlignment.Center
 elseif align == "right" then
 labelInst.TextXAlignment = Enum.TextXAlignment.Right
 end
 labelInst.TextWrapped = (args.wrap == true)
 if args.wrap == true then
 labelInst.AutomaticSize = Enum.AutomaticSize.Y
 end
 labelInst.Position = parseUDim2Arg(args.position, UDim2.new(0, 0, 0, 0))
 labelInst.Size = parseUDim2Arg(args.size, UDim2.new(1, 0, 0, 20))
 labelInst.Parent = parent
 waypoint("ui_label " .. slashPath(labelInst))
 return { label = slashPath(labelInst) }
end

function OPS.ui_button(args)

 local parent = resolveStrict(args.parent)
 local name = uiName(args)
 local buttonInst = Instance.new("TextButton")
 buttonInst.Name = name
 buttonInst.Font = UI_FONTS[string.lower(tostring(args.font or "semibold"))] or Enum.Font.GothamBold
 buttonInst.Text = tostring(args.text or "Button")
 buttonInst.TextSize = tonumber(args.text_size) or 16
 buttonInst.TextColor3 = vfxColor(args.text_color, Color3.fromRGB(255, 255, 255))
 buttonInst.BackgroundColor3 = vfxColor(args.color, Color3.fromRGB(64, 72, 92))
 buttonInst.BorderSizePixel = 0
 buttonInst.AutoButtonColor = true
 buttonInst.Position = parseUDim2Arg(args.position, UDim2.new(0, 0, 0, 0))
 buttonInst.Size = parseUDim2Arg(args.size, UDim2.new(1, 0, 0, 40))
 buttonInst.AnchorPoint = parseAnchor(args.anchor)
 local corner = Instance.new("UICorner")
 corner.CornerRadius = UDim.new(0, tonumber(args.radius) or 8)
 corner.Parent = buttonInst
 buttonInst.Parent = parent
 waypoint("ui_button " .. slashPath(buttonInst))
 return { button = slashPath(buttonInst) }
end

function OPS.ui_input(args)

 local parent = resolveStrict(args.parent)
 local name = uiName(args)
 local inputInst = Instance.new("TextBox")
 inputInst.Name = name
 inputInst.Font = Enum.Font.Gotham
 inputInst.Text = tostring(args.text or "")
 inputInst.PlaceholderText = tostring(args.placeholder or "")
 inputInst.PlaceholderColor3 = Color3.fromRGB(140, 140, 150)
 inputInst.TextSize = tonumber(args.text_size) or 16
 inputInst.TextColor3 = vfxColor(args.color, Color3.fromRGB(242, 242, 247))
 inputInst.BackgroundColor3 = vfxColor(args.background, Color3.fromRGB(18, 19, 24))
 inputInst.BorderSizePixel = 0
 inputInst.ClearTextOnFocus = false
 inputInst.TextXAlignment = Enum.TextXAlignment.Left
 inputInst.Position = parseUDim2Arg(args.position, UDim2.new(0, 0, 0, 0))
 inputInst.Size = parseUDim2Arg(args.size, UDim2.new(1, 0, 0, 36))
 local corner = Instance.new("UICorner")
 corner.CornerRadius = UDim.new(0, tonumber(args.radius) or 8)
 corner.Parent = inputInst
 inputInst.Parent = parent
 waypoint("ui_input " .. slashPath(inputInst))
 return { input = slashPath(inputInst) }
end

function OPS.ui_image(args)

 local parent = resolveStrict(args.parent)
 local name = uiName(args)
 local id = tonumber(args.asset) or tonumber(string.match(tostring(args.asset or ""), "(%d+)"))
 if id == nil then
 error("args.asset (the asset id, e.g. 487667385) is required", 0)
 end
 local imageInst = Instance.new("ImageLabel")
 imageInst.Name = name
 imageInst.BackgroundTransparency = 1
 imageInst.Image = "rbxassetid://" .. id
 local scaleTypes = {
 fit = Enum.ScaleType.Fit,
 stretch = Enum.ScaleType.Stretch,
 tile = Enum.ScaleType.Tile,
 crop = Enum.ScaleType.Crop,
 slice = Enum.ScaleType.Slice,
 }
 local scaleName = string.lower(tostring(args.scale or "fit"))
 if scaleTypes[scaleName] == nil then
 error('args.scale must be one of: fit, stretch, tile, crop, slice (got "' .. tostring(args.scale) .. '")', 0)
 end
 imageInst.ScaleType = scaleTypes[scaleName]
 imageInst.Position = parseUDim2Arg(args.position, UDim2.new(0, 0, 0, 0))
 imageInst.Size = parseUDim2Arg(args.size, UDim2.new(1, 0, 1, 0))
 imageInst.Parent = parent
 waypoint("ui_image " .. slashPath(imageInst))
 return { image = slashPath(imageInst), asset = id }
end

function OPS.ui_list(args)

 local parent = resolveStrict(args.parent)
 local listLayout = parent:FindFirstChild("UIListLayout")
 if listLayout == nil then
 listLayout = Instance.new("UIListLayout")
 end
 listLayout.Name = "UIListLayout"
 listLayout.SortOrder = Enum.SortOrder.LayoutOrder
 listLayout.FillDirection = (string.lower(tostring(args.direction or "vertical")) == "horizontal")
 and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
 listLayout.Padding = UDim.new(0, tonumber(args.padding) or 8)
 local h = string.lower(tostring(args.halign or ""))
 if h == "center" or h == "centre" then
 listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
 elseif h == "right" then
 listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
 end
 local v = string.lower(tostring(args.valign or ""))
 if v == "middle" or v == "center" then
 listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
 elseif v == "bottom" then
 listLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
 end
 listLayout.Parent = parent
 waypoint("ui_list " .. slashPath(parent))
 return { layout = slashPath(listLayout), parent = slashPath(parent) }
end

function OPS.play(args)

 if RunService:IsRunning() then
 error("a play test is already running - stop it first with `stop`", 0)
 end
 local mode = string.lower(tostring(args.mode or "play"))
 if mode ~= "play" and mode ~= "run" then
 error("args.mode must be play or run", 0)
 end
 local started = nil
 if mode == "play" then
 local ok = pcall(function()
 game:Play()
 end)
 if ok then
 started = "play"
 end
 end
 if started == nil then
 RunService:Run()
 started = "run"
 end
 state.playStartedAt = os.time()
 return { playing = true, mode = started, startedAt = state.playStartedAt }
end

function OPS.stop()

 if not RunService:IsRunning() then
 return { playing = false, runState = "Stopped", note = "no play test was running" }
 end
 RunService:Stop()
 return { playing = false, runState = "Stopped" }
end

function OPS.logs(args)

 local filter = string.lower(tostring(args.filter or "errors"))
 if filter ~= "errors" and filter ~= "all" then
 error("args.filter must be errors or all", 0)
 end
 local limit = math.clamp(tonumber(args.limit) or 50, 1, 200)
 local since = tonumber(args.since) or state.playStartedAt or 0
 local ok, history = pcall(function()
 return game:GetService("LogService"):GetLogHistory()
 end)
 if not ok or type(history) ~= "table" then
 error("could not read the output log: " .. tostring(history), 0)
 end
 local entries = {}
 local errorCount, warningCount = 0, 0
 for _, entry in ipairs(history) do
 if type(entry) == "table" then
 local ts = tonumber(entry.timestamp) or 0
 if ts &gt;= since then

 local mtype = tostring(entry.messageType)
 local isError = (mtype == "Enum.MessageType.MessageError")
 local isWarning = (mtype == "Enum.MessageType.MessageWarning")
 if isError then
 errorCount = errorCount + 1
 elseif isWarning then
 warningCount = warningCount + 1
 end
 if filter == "all" or isError or isWarning then
 local msg = tostring(entry.message or "")
 if #msg &gt; 400 then
 msg = truncateBytes(msg, 400) .. "…"
 end
 local rec = {
 type = isError and "error" or (isWarning and "warning" or "info"),
 message = msg,
 timestamp = ts,
 }
 if type(entry.source) == "string" and #entry.source &gt; 0 then
 rec.source = entry.source
 end
 table.insert(entries, rec)
 end
 end
 end
 end
 local out = {}
 local from = math.max(1, #entries - limit + 1)
 for i = #entries, from, -1 do
 table.insert(out, entries[i])
 end
 return {
 count = #out,
 total = #entries,
 errors = errorCount,
 warnings = warningCount,
 since = since,
 entries = out,
 }
end

function OPS.undo(args)

 if not RunService:IsEdit() then
 error("undo only works in edit mode", 0)
 end
 local ok, err = pcall(function()
 ChangeHistoryService:Undo()
 end)
 if not ok then
 error("Studio refused undo: " .. tostring(err), 0)
 end
 return { ok = true, undone = true }
end

function OPS.rename(args)
 local inst = resolveStrict(args.path)
 local name = args.name
 if type(name) ~= "string" or #name == 0 then
 error("args.name (the new name) is required", 0)
 end
 if string.find(name, "/", 1, true) ~= nil then
 error("names must not contain '/' (it is the path separator) - use '-' or '_'", 0)
 end
 local oldName = inst.Name
 inst.Name = name
 waypoint("rename " .. slashPath(inst))
 return { path = slashPath(inst), name = inst.Name, old = oldName }
end

function OPS.paint(args)

 local paths = args.paths
 if type(paths) ~= "table" then
 paths = { args.path }
 end
 local targets = {}
 local function collect(inst)
 if inst:IsA("BasePart") then
 table.insert(targets, inst)
 else
 for _, child in ipairs(inst:GetDescendants()) do
 if child:IsA("BasePart") then
 table.insert(targets, child)
 end
 end
 end
 end
 for _, p in ipairs(paths) do
 collect(resolveStrict(p))
 end
 if #targets == 0 then
 error("no parts found to paint", 0)
 end
 local color = nil
 if type(args.color) == "string" and #args.color &gt; 0 then
 color = hexToColor(args.color)
 end
 local material = nil
 if type(args.material) == "string" and #args.material &gt; 0 then
 local okMat, m = pcall(function()
 if string.sub(args.material, 1, 5) == "Enum." then
 return parseEnum(args.material)
 end
 return Enum.Material[args.material]
 end)
 if not okMat or m == nil then
 error(string.format("unknown material '%s' (e.g. Grass, Neon, WoodPlanks, SmoothPlastic)", tostring(args.material)), 0)
 end
 material = m
 end
 local transparency = tonumber(args.transparency)
 local reflectance = tonumber(args.reflectance)
 for _, part in ipairs(targets) do
 if color ~= nil then
 part.Color = color
 end
 if material ~= nil then
 part.Material = material
 end
 if transparency ~= nil then
 part.Transparency = math.clamp(transparency, 0, 1)
 end
 if reflectance ~= nil then
 part.Reflectance = math.clamp(reflectance, 0, 1)
 end
 end
 waypoint("paint " .. #targets .. " part(s)")
 return { count = #targets }
end

function OPS.place(args)

 local inst = resolveStrict(args.path)
 if type(args.position) ~= "table" then
 error("args.position {x,y,z} (world position) is required", 0)
 end
 local pos = Vector3.new(
 tonumber(args.position.x) or 0,
 tonumber(args.position.y) or 0,
 tonumber(args.position.z) or 0)
 local cf = CFrame.new(pos)
 if type(args.orientation) == "table" then
 cf = cf * CFrame.fromOrientation(
 math.rad(tonumber(args.orientation.x) or 0),
 math.rad(tonumber(args.orientation.y) or 0),
 math.rad(tonumber(args.orientation.z) or 0))
 end
 local okPivot, errPivot = pcall(function()
 inst:PivotTo(cf)
 end)
 if not okPivot then
 error("could not place " .. inst:GetFullName() .. " (only parts and models can be placed): " .. tostring(errPivot), 0)
 end
 waypoint("place " .. slashPath(inst))
 return { path = slashPath(inst), position = { x = pos.X, y = pos.Y, z = pos.Z } }
end

function OPS.look(args)

 local target = nil
 if type(args.path) == "string" then
 local inst = resolveStrict(args.path)
 local okPiv, pivPos = pcall(function()
 return inst:GetPivot().Position
 end)
 if not okPiv then
 error("cannot look at " .. slashPath(inst) .. " (only parts and models have a pivot position): " .. tostring(pivPos), 0)
 end
 target = pivPos
 elseif type(args.position) == "table" then
 target = Vector3.new(
 tonumber(args.position.x) or 0,
 tonumber(args.position.y) or 0,
 tonumber(args.position.z) or 0)
 else
 error("args.path or args.position {x,y,z} is required", 0)
 end
 local distance = math.clamp(tonumber(args.distance) or 30, 5, 500)
 local camera = workspace.CurrentCamera
 if camera == nil then
 error("no editor camera available", 0)
 end
 local dir = camera.CFrame.Position - target
 if dir.Magnitude &lt; 1 then
 dir = Vector3.new(0, 0.5, 1)
 end
 camera.CFrame = CFrame.lookAt(target + dir.Unit * distance, target)
 return { lookedAt = { x = target.X, y = target.Y, z = target.Z }, distance = distance }
end

function OPS.count(args)

 local scope = resolveStrict(args.scope or "game")
 local classFilter = args.class
 local n = 0
 if type(classFilter) == "string" and #classFilter &gt; 0 then
 local okClass = pcall(function()
 return scope:IsA(classFilter)
 end)
 if not okClass then
 error(string.format("unknown class '%s'", classFilter), 0)
 end
 if scope:IsA(classFilter) then
 n = n + 1
 end
 for _, inst in ipairs(scope:GetDescendants()) do
 if inst:IsA(classFilter) then
 n = n + 1
 end
 end
 else
 n = #scope:GetDescendants()
 end
 return { count = n, scope = slashPath(scope), class = classFilter }
end

function OPS.anchor(args)

 local targets = {}
 local function collect(inst)
 if inst:IsA("BasePart") then
 table.insert(targets, inst)
 else
 for _, child in ipairs(inst:GetDescendants()) do
 if child:IsA("BasePart") then
 table.insert(targets, child)
 end
 end
 end
 end
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 collect(resolveStrict(p))
 end
 elseif args.path ~= nil then
 collect(resolveStrict(args.path))
 else
 error("args.path (or args.paths) is required", 0)
 end
 if #targets == 0 then
 error("no parts found to anchor", 0)
 end
 local anchored = (args.anchored ~= false)
 for _, part in ipairs(targets) do
 part.Anchored = anchored
 end
 waypoint("anchor " .. #targets .. " part(s)")
 return { count = #targets, anchored = anchored }
end

function OPS.collide(args)

 local targets = {}
 local function collect(inst)
 if inst:IsA("BasePart") then
 table.insert(targets, inst)
 else
 for _, child in ipairs(inst:GetDescendants()) do
 if child:IsA("BasePart") then
 table.insert(targets, child)
 end
 end
 end
 end
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 collect(resolveStrict(p))
 end
 elseif args.path ~= nil then
 collect(resolveStrict(args.path))
 else
 error("args.path (or args.paths) is required", 0)
 end
 if #targets == 0 then
 error("no parts found", 0)
 end
 local canCollide = (args.canCollide ~= false)
 for _, part in ipairs(targets) do
 part.CanCollide = canCollide
 end
 waypoint("collide " .. #targets .. " part(s)")
 return { count = #targets, canCollide = canCollide }
end

function OPS.light(args)

 local inst = resolveStrict(args.path)
 if not inst:IsA("BasePart") then
 error("args.path must be a BasePart to hold the light", 0)
 end
 local kind = string.lower(tostring(args.type or "point"))
 local class
 if kind == "point" then
 class = "PointLight"
 elseif kind == "spot" then
 class = "SpotLight"
 elseif kind == "surface" then
 class = "SurfaceLight"
 else
 error('args.type must be "point", "spot", or "surface"', 0)
 end
 local light = inst:FindFirstChildOfClass(class)
 if light == nil then
 light = Instance.new(class)
 light.Name = class
 light.Parent = inst
 end
 if type(args.color) == "string" and #args.color &gt; 0 then
 light.Color = hexToColor(args.color)
 end
 if args.range ~= nil then
 light.Range = math.clamp(tonumber(args.range) or 10, 0, 60)
 end
 if args.brightness ~= nil then
 light.Brightness = math.clamp(tonumber(args.brightness) or 1, 0, 20)
 end
 if args.shadows ~= nil then
 light.Shadows = (args.shadows == true)
 end
 waypoint("light " .. slashPath(inst))
 return { path = slashPath(light), class = class, range = light.Range, brightness = light.Brightness }
end

function OPS.sound(args)

 local parent = resolveStrict(args.parent or "game.Workspace")
 local id = tostring(args.id or "")
 if #id == 0 then
 error("args.id (the audio asset id) is required", 0)
 end
 if string.find(id, "rbxassetid://", 1, true) == nil then
 id = "rbxassetid://" .. id
 end
 local snd = Instance.new("Sound")
 snd.Name = args.name or "Sound"
 snd.SoundId = id
 if args.volume ~= nil then
 snd.Volume = math.clamp(tonumber(args.volume) or 0.5, 0, 10)
 end
 if args.looped == true then
 snd.Looped = true
 end
 snd.Parent = parent
 if args.play == true then
 snd:Play()
 end
 waypoint("sound " .. slashPath(snd))
 return { path = slashPath(snd), soundId = id, playing = (args.play == true) }
end

function OPS.scatter(args)

 local tmpl = resolveStrict(args.path)
 local count = math.clamp(tonumber(args.count) or 1, 1, 200)
 local radius = math.max(0, tonumber(args.radius) or 20)
 local yJitter = math.max(0, tonumber(args.yJitter) or 0)
 local parent = (args.parent ~= nil) and resolveStrict(args.parent) or tmpl.Parent
 local cf = getPivotCFrame(tmpl)
 if cf == nil then
 error("scatter needs a BasePart or a Model", 0)
 end
 local basePos = cf.Position
 local rng = Random.new()
 local copies = {}
 for i = 1, count do
 local clone = tmpl:Clone()
 clone.Name = (args.name ~= nil) and (tostring(args.name) .. i) or (tmpl.Name .. i)
 local angle = rng:NextNumber(0, 2 * math.pi)
 local dist = math.sqrt(rng:NextNumber()) * radius
 local pos = Vector3.new(
 basePos.X + math.cos(angle) * dist,
 basePos.Y + rng:NextNumber(-yJitter, yJitter),
 basePos.Z + math.sin(angle) * dist)
 local cloneCf = getPivotCFrame(clone)
 setPivotCFrame(clone, CFrame.new(cloneCf.Position + (pos - basePos)) * cloneCf.Rotation)
 clone.Parent = parent
 if #copies &lt; 20 then
 table.insert(copies, slashPath(clone))
 end
 end
 waypoint("scatter " .. count .. "x " .. tmpl.Name)
 return { count = count, radius = radius, copies = copies }
end

function OPS.weld(args)

 local targets = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(targets, p)
 end
 elseif args.path ~= nil then
 table.insert(targets, args.path)
 else
 error("args.path (or args.paths) is required", 0)
 end
 local welded = 0
 for _, p in ipairs(targets) do
 local inst = resolveStrict(p)
 local parts = {}
 if inst:IsA("BasePart") then
 table.insert(parts, inst)
 else
 for _, child in ipairs(inst:GetDescendants()) do
 if child:IsA("BasePart") then
 table.insert(parts, child)
 end
 end
 end
 if #parts &lt; 2 then
 error(string.format("%s has fewer than 2 parts - nothing to weld", slashPath(inst)), 0)
 end
 local root = parts[1]
 local function alreadyWelded(a, b)
 for _, child in ipairs(root:GetChildren()) do
 if child:IsA("WeldConstraint") then
 local p0, p1 = child.Part0, child.Part1
 if (p0 == a and p1 == b) or (p0 == b and p1 == a) then
 return true
 end
 end
 end
 return false
 end
 for i = 2, #parts do
 if not alreadyWelded(root, parts[i]) then
 local weld = Instance.new("WeldConstraint")
 weld.Name = "GolemWeld"
 weld.Part0 = root
 weld.Part1 = parts[i]
 weld.Parent = root
 welded = welded + 1
 end
 end
 end
 waypoint("weld " .. welded .. " joint(s)")
 return { count = welded }
end

function OPS.hitbox(args)

 local inst = resolveStrict(args.path)
 local size, center
 if inst:IsA("Model") then
 size = inst:GetExtentsSize()
 center = inst:GetPivot().Position
 elseif inst:IsA("BasePart") then
 size = inst.Size
 center = inst.Position
 else
 error("hitbox needs a BasePart or a Model", 0)
 end
 local pad = math.max(0, tonumber(args.padding) or 0.5)
 local hitPart = Instance.new("Part")
 hitPart.Name = args.name or ("Hitbox_" .. inst.Name)
 hitPart.Size = size + Vector3.new(pad, pad, pad) * 2
 hitPart.CFrame = CFrame.new(center)
 hitPart.Transparency = 1
 hitPart.CanCollide = (args.canCollide == true)
 hitPart.CanTouch = true
 hitPart.CanQuery = true
 hitPart.Anchored = (args.anchored ~= false)
 hitPart.Massless = true
 hitPart.Parent = inst:IsA("Model") and inst or inst.Parent
 waypoint("hitbox " .. slashPath(hitPart))
 return { path = slashPath(hitPart), size = { x = hitPart.Size.X, y = hitPart.Size.Y, z = hitPart.Size.Z } }
end

function OPS.prompt(args)

 local inst = resolveStrict(args.path)
 if not inst:IsA("BasePart") then
 error("args.path must be a BasePart to hold the prompt", 0)
 end
 local prompt = inst:FindFirstChildOfClass("ProximityPrompt")
 if prompt == nil then
 prompt = Instance.new("ProximityPrompt")
 prompt.Parent = inst
 end
 prompt.ActionText = tostring(args.action or args.text or "Use")
 if args.object ~= nil then
 prompt.ObjectText = tostring(args.object)
 end
 prompt.HoldDuration = math.clamp(tonumber(args.hold) or 0, 0, 10)
 prompt.MaxActivationDistance = math.clamp(tonumber(args.distance) or 8, 1, 100)
 prompt.RequiresLineOfSight = false
 waypoint("prompt " .. slashPath(inst))
 return { path = slashPath(prompt), actionText = prompt.ActionText,
 holdDuration = prompt.HoldDuration }
end

local PARTICLE_PRESETS = {
 leaves = { color = Color3.fromRGB(86, 160, 62), rate = 8, lifetime = { 3, 5 }, speed = { 1, 2 },
 acceleration = Vector3.new(0, -2, 0), size = 0.4, rotSpeed = { -90, 90 } },
 sparks = { color = Color3.fromRGB(255, 200, 80), rate = 30, lifetime = { 0.3, 0.8 }, speed = { 8, 14 },
 acceleration = Vector3.new(0, -30, 0), size = 0.15, spread = { 180, 180 } },
 smoke = { color = Color3.fromRGB(160, 160, 160), rate = 6, lifetime = { 2, 4 }, speed = { 2, 4 },
 acceleration = Vector3.new(0, 3, 0), size = 1.8 },
 magic = { color = Color3.fromRGB(150, 90, 255), rate = 15, lifetime = { 1, 2 }, speed = { 3, 6 },
 acceleration = Vector3.new(0, 5, 0), size = 0.3, lightEmission = 1 },
 fire = { color = Color3.fromRGB(255, 120, 40), rate = 40, lifetime = { 0.5, 1 }, speed = { 4, 8 },
 acceleration = Vector3.new(0, 8, 0), size = 0.8, lightEmission = 1 },
 snow = { color = Color3.fromRGB(240, 248, 255), rate = 60, lifetime = { 4, 6 }, speed = { 2, 4 },
 acceleration = Vector3.new(0, -8, 0), size = 0.25 },
 rain = { color = Color3.fromRGB(150, 190, 255), rate = 120, lifetime = { 1, 1.5 }, speed = { 50, 70 },
 acceleration = Vector3.new(0, -80, 0), size = 0.08 },
 bubbles = { color = Color3.fromRGB(170, 220, 255), rate = 12, lifetime = { 2, 4 }, speed = { 2, 5 },
 acceleration = Vector3.new(0, 6, 0), size = 0.3 },
 dust = { color = Color3.fromRGB(205, 195, 165), rate = 8, lifetime = { 3, 6 }, speed = { 0.5, 1.5 },
 acceleration = Vector3.new(0, 0.4, 0), size = 0.2 },
 confetti = { color = Color3.fromRGB(255, 200, 80), rate = 25, lifetime = { 2, 3 }, speed = { 6, 10 },
 acceleration = Vector3.new(0, -12, 0), size = 0.2, rotSpeed = { -180, 180 }, spread = { 180, 0 } },
 fireflies = { color = Color3.fromRGB(190, 255, 120), rate = 6, lifetime = { 3, 5 }, speed = { 1, 2 },
 acceleration = Vector3.new(0, 0.5, 0), size = 0.15, lightEmission = 1 },
}

function OPS.particles(args)

 local inst = resolveStrict(args.path)
 if not inst:IsA("BasePart") then
 error("args.path must be a BasePart to emit particles", 0)
 end
 local presetName = string.lower(tostring(args.preset or "leaves"))
 local preset = PARTICLE_PRESETS[presetName]
 if preset == nil then
 error("args.preset must be one of: " .. table.concat(
 { "leaves", "sparks", "smoke", "magic", "fire", "snow", "rain", "bubbles", "dust", "confetti", "fireflies" }, ", "), 0)
 end
 local emitter = inst:FindFirstChildOfClass("ParticleEmitter")
 if emitter == nil then
 emitter = Instance.new("ParticleEmitter")
 emitter.Name = presetName
 emitter.Parent = inst
 end
 local color = preset.color
 if type(args.color) == "string" and #args.color &gt; 0 then
 color = hexToColor(args.color)
 end
 emitter.Color = ColorSequence.new(color)
 emitter.Rate = math.max(0, tonumber(args.rate) or preset.rate)
 emitter.Lifetime = NumberRange.new(preset.lifetime[1], preset.lifetime[2])
 emitter.Speed = NumberRange.new(preset.speed[1], preset.speed[2])
 emitter.Acceleration = preset.acceleration
 emitter.Size = NumberSequence.new(preset.size)
 if preset.rotSpeed ~= nil then
 emitter.Rotation = NumberRange.new(preset.rotSpeed[1], preset.rotSpeed[2])
 emitter.RotSpeed = NumberRange.new(preset.rotSpeed[1], preset.rotSpeed[2])
 end
 if preset.spread ~= nil then
 emitter.SpreadAngle = Vector2.new(preset.spread[1], preset.spread[2])
 end
 if preset.lightEmission ~= nil then
 emitter.LightEmission = preset.lightEmission
 end
 waypoint("particles " .. slashPath(inst))
 return { path = slashPath(emitter), preset = presetName, rate = emitter.Rate }
end

function OPS.sign(args)

 local text = args.text
 if type(text) ~= "string" or #text == 0 then
 error("args.text (what the sign says) is required", 0)
 end
 local parent = (args.parent ~= nil) and resolveStrict(args.parent) or workspace
 local board = Instance.new("Part")
 board.Name = args.name or "Sign"
 board.Anchored = true
 board.Material = Enum.Material.Wood
 board.Color = Color3.fromRGB(120, 86, 60)
 local size = { 6, 4, 0.5 }
 if type(args.size) == "table" then
 size = { tonumber(args.size.x) or 6, tonumber(args.size.y) or 4, tonumber(args.size.z) or 0.5 }
 end
 board.Size = Vector3.new(size[1], size[2], size[3])
 if type(args.position) == "table" then
 board.CFrame = CFrame.new(tonumber(args.position.x) or 0,
 tonumber(args.position.y) or 10, tonumber(args.position.z) or 0)
 else
 board.CFrame = CFrame.new(0, 10, 0)
 end
 local gui = Instance.new("SurfaceGui")
 gui.Face = Enum.NormalId.Front
 gui.Parent = board
 local signLabel = Instance.new("TextLabel")
 signLabel.Size = UDim2.fromScale(1, 1)
 signLabel.BackgroundTransparency = 1
 signLabel.Font = Enum.Font.Gotham
 signLabel.Text = text
 signLabel.TextColor3 = Color3.fromRGB(245, 235, 220)
 signLabel.TextScaled = true
 local pad = Instance.new("UIPadding")
 pad.PaddingTop = UDim.new(0, 16)
 pad.PaddingBottom = UDim.new(0, 16)
 pad.PaddingLeft = UDim.new(0, 16)
 pad.PaddingRight = UDim.new(0, 16)
 pad.Parent = signLabel
 signLabel.Parent = gui
 board.Parent = parent
 waypoint("sign " .. slashPath(board))
 return { path = slashPath(board), text = text }
end

function OPS.attributes(args)

 local inst = resolveStrict(args.path)
 if type(args.set) == "table" then
 for key, value in pairs(args.set) do
 if type(value) == "table" then
 if value["type"] ~= nil then
 value = deserializeValue(value, key)
 elseif value.x ~= nil or value.y ~= nil or value.z ~= nil then
 value = Vector3.new(tonumber(value.x) or 0, tonumber(value.y) or 0, tonumber(value.z) or 0)
 else
 error("cannot set attribute '" .. tostring(key) .. "' from a table (use {x,y,z} for Vector3 or a tagged {type=...} value)", 0)
 end
 end
 local okSet, errSet = pcall(function()
 inst:SetAttribute(key, value)
 end)
 if not okSet then
 error(string.format("cannot set attribute '%s' (allowed: string, number, boolean, Vector3 {x,y,z}, tagged {type=...}): %s",
 tostring(key), tostring(errSet)), 0)
 end
 end
 waypoint("attributes " .. slashPath(inst))
 end
 if type(args.clear) == "table" then
 for _, key in ipairs(args.clear) do
 local okClear, errClear = pcall(function()
 inst:SetAttribute(key, nil)
 end)
 if not okClear then
 error(string.format("cannot clear attribute '%s': %s", tostring(key), tostring(errClear)), 0)
 end
 end
 end
 local plain = {}
 for key, value in pairs(inst:GetAttributes()) do
 if type(value) == "number" or type(value) == "string" or type(value) == "boolean" then
 plain[key] = value
 elseif typeof(value) == "Vector3" then
 plain[key] = { x = value.X, y = value.Y, z = value.Z }
 else
 plain[key] = jsonSafe(value)
 end
 end
 return { path = slashPath(inst), attributes = plain }
end

function OPS.tag(args)

 local paths = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(paths, p)
 end
 elseif args.path ~= nil then
 table.insert(paths, args.path)
 end
 if #paths == 0 then
 error("args.path (or args.paths) is required", 0)
 end
 local add = (type(args.add) == "table") and args.add or {}
 local remove = (type(args.remove) == "table") and args.remove or {}
 local tagged = {}
 for _, p in ipairs(paths) do
 local inst = resolveStrict(p)
 for _, t in ipairs(add) do
 if type(t) ~= "string" or #t == 0 then
 error("tags must be non-empty strings", 0)
 end
 CollectionService:AddTag(inst, t)
 end
 for _, t in ipairs(remove) do
 if type(t) ~= "string" or #t == 0 then
 error("tags must be non-empty strings", 0)
 end
 CollectionService:RemoveTag(inst, t)
 end
 table.insert(tagged, { path = slashPath(inst), tags = CollectionService:GetTags(inst) })
 end
 waypoint("tag")
 return { instances = tagged }
end

function OPS.match(args)

 local from = resolveStrict(args.from)
 if not from:IsA("BasePart") then
 error("args.from must be a BasePart (the style source)", 0)
 end
 local to = {}
 if type(args.paths) == "table" then
 for _, p in ipairs(args.paths) do
 table.insert(to, p)
 end
 elseif args.to ~= nil then
 table.insert(to, args.to)
 end
 if #to == 0 then
 error("args.to or args.paths (style targets) is required", 0)
 end
 local count = 0
 for _, p in ipairs(to) do
 local inst = resolveStrict(p)
 local parts = {}
 if inst:IsA("BasePart") then
 table.insert(parts, inst)
 else
 for _, child in ipairs(inst:GetDescendants()) do
 if child:IsA("BasePart") then
 table.insert(parts, child)
 end
 end
 end
 for _, part in ipairs(parts) do
 part.Color = from.Color
 part.Material = from.Material
 part.Transparency = from.Transparency
 part.Reflectance = from.Reflectance
 count = count + 1
 end
 end
 waypoint("match " .. count .. " part(s)")
 return { count = count, from = slashPath(from) }
end

function OPS.search_assets(args)

 error("marketplace search runs agent-side - use: npx golem-bridge search &lt;query&gt; [--category model|mesh|image|audio|video|plugin] [--limit N] [--cursor C]", 0)
end

function OPS.asset_info(args)
 error("asset details run agent-side - use: npx golem-bridge info &lt;assetId&gt;", 0)
end

function OPS.insert_asset(args)
 local id = tonumber(args.id)
 if id == nil then
 error("args.id (asset id) is required", 0)
 end
 local parent = resolveStrict(args.parent or "Workspace")
 local ok, container = pcall(function()
 return game:GetService("InsertService"):LoadAsset(id)
 end)
 if not ok or container == nil then
 error(string.format(
 "InsertService could not load asset %d: %s (it may be deleted, paid or restricted - pick a FREE asset: search results show priceInRobux, free means null or 0; assets the user owns also insert)",
 id, tostring(container)), 0)
 end
 local moved = {}
 for _, child in ipairs(container:GetChildren()) do
 child.Parent = parent
 table.insert(moved, child)
 end
 container:Destroy()
 if #moved == 0 then
 error("asset loaded but contained nothing insertable", 0)
 end
 if args.name ~= nil and #moved == 1 then
 pcall(function()
 moved[1].Name = tostring(args.name)
 end)
 end
 waypoint("insert asset " .. id)
 local records = {}
 for _, inst in ipairs(moved) do
 table.insert(records, instanceRecord(inst))
 end
 return { assetId = id, parent = slashPath(parent), count = #records, inserted = records }
end

function OPS.apply_asset(args)
 local id = args.id
 if id == nil then
 error("args.id is required (asset id, or an 'rbxassetid://' string)", 0)
 end
 if args.path == nil or args.prop == nil then
 error("args.path and args.prop (e.g. 'Image', 'Texture', 'SoundId', 'MeshId') are required", 0)
 end
 local value
 if type(id) == "number" then
 value = "rbxassetid://" .. id
 elseif type(id) == "string" then
 local digits = string.match(id, "^%s*(%d+)%s*$")
 if digits ~= nil then
 value = "rbxassetid://" .. digits
 elseif string.sub(id, 1, 13) == "rbxassetid://" or string.sub(id, 1, 11) == "rbxasset://"
 or string.sub(id, 1, 8) == "https://" or string.sub(id, 1, 7) == "http://" then
 local assetParam = string.match(id, "[?&amp;]id=(%d+)")
 value = assetParam ~= nil and ("rbxassetid://" .. assetParam) or id
 else
 error("unrecognized asset id: " .. id, 0)
 end
 else
 error("args.id must be a number or a string", 0)
 end
 local inst = resolveStrict(args.path)
 local prop = tostring(args.prop)
 local ok, err = pcall(function()
 inst[prop] = value
 end)
 if not ok then
 error(string.format("could not set %s.%s = %s: %s",
 inst:GetFullName(), prop, value, tostring(err)), 0)
 end
 waypoint("apply asset")
 local record = instanceRecord(inst)
 record.appliedProperty = prop
 record.appliedValue = value
 return record
end

function OPS.selection(args)
 if args.clear == true then
 Selection:Set({})
 elseif type(args.set) == "table" then
 local objects = {}
 for _, p in ipairs(args.set) do
 table.insert(objects, resolveStrict(p))
 end
 Selection:Set(objects)
 elseif args.set ~= nil then
 Selection:Set({ resolveStrict(args.set) })
 end
 local current = Selection:Get()
 local records = {}
 for _, inst in ipairs(current) do
 table.insert(records, instanceRecord(inst))
 end
 return { count = #records, selection = records }
end

function OPS.waypoint(args)
 waypoint(args.label or "manual")
 return { ok = true }
end

OPS.ls = OPS.list
OPS.cat = OPS.read
OPS.stat = OPS.read
OPS.rm = OPS.delete
OPS.mv = OPS.move
OPS.dup = OPS.duplicate
OPS.pivot = OPS.set_pivot
OPS.rot = OPS.rotate

local OP_NAMES = {}
for name in pairs(OPS) do
 table.insert(OP_NAMES, name)
end
table.sort(OP_NAMES)

local function executeCommand(cmd)
 local startedAt = os.clock()
 local opName = tostring(cmd.op)
 local handler = OPS[opName]
 local response
 if handler == nil then
 response = {
 id = cmd.id,
 ok = false,
 error = string.format("unknown op '%s'. Available ops: %s", opName, table.concat(OP_NAMES, ", ")),
 }
 else
 local ok, result = pcall(handler, cmd.args)
 if ok then
 response = { id = cmd.id, ok = true, result = result }
 else
 response = { id = cmd.id, ok = false, error = tostring(result) }
 end
 end
 response.op = opName
 response.meta = {
 durationMs = math.floor((os.clock() - startedAt) * 1000 + 0.5),
 pluginVersion = VERSION,
 }
 return response
end

local httpNoticeShown = false
local function ensureHttpEnabled()
 local enabled = false
 local okRead = pcall(function()
 enabled = HttpService.HttpEnabled
 end)
 if okRead and enabled then
 return
 end
 local okSet = pcall(function()
 HttpService.HttpEnabled = true
 end)
 if okSet then
 if not httpNoticeShown then
 httpNoticeShown = true
 log("HttpService.HttpEnabled was off - the plugin turned it on (Game Settings -&gt; Security).")
 end
 elseif not httpNoticeShown then
 httpNoticeShown = true
 log("WARNING: could not enable HttpService (also fails while a play session is running - it keeps retrying). Enable 'Allow HTTP Requests' in Game Settings -&gt; Security.")
 end
end

function http(request)
 local headers = request.Headers or {}
 if headers["Content-Type"] == nil then
 headers["Content-Type"] = "application/json"
 end
 headers["X-AIBridge-Plugin"] = VERSION
 headers["X-AIBridge-Studio"] = STUDIO_VERSION
 request.Headers = headers

 request.Compress = Enum.HttpCompression.None

 local ok, response = pcall(function()
 return HttpService:RequestAsync(request)
 end)
 if not ok then
 return nil, tostring(response)
 end
 if response.Success ~= true then
 return nil, string.format("HTTP %d from %s: %s",
 response.StatusCode, request.Url, tostring(response.Body or response.StatusMessage or ""))
 end
 return response
end

local generation = 0

local function jsonSafe(s)
 if type(s) ~= "string" then
 return s
 end
 local n = #s
 local out = table.create(n)
 local i = 1
 while i &lt;= n do
 local b = string.byte(s, i)
 if b == 10 or b == 9 then
 table.insert(out, string.sub(s, i, i))
 i = i + 1
 elseif b &lt; 0x20 or b == 0x7F then
 if b ~= 13 then
 table.insert(out, " ")
 end
 i = i + 1
 elseif b &lt; 0x80 then
 table.insert(out, string.sub(s, i, i))
 i = i + 1
 else

 local len = 0
 if b &gt;= 0xF0 and b &lt;= 0xF4 then
 len = 4
 elseif b &gt;= 0xE0 and b &lt;= 0xEF then
 len = 3
 elseif b &gt;= 0xC2 and b &lt;= 0xDF then
 len = 2
 end
 local valid = len &gt;= 2
 if valid then
 local lo, hi = 0x80, 0xBF
 if b == 0xE0 then
 lo = 0xA0
 elseif b == 0xED then
 hi = 0x9F
 elseif b == 0xF0 then
 lo = 0x90
 elseif b == 0xF4 then
 hi = 0x8F
 end
 for j = i + 1, i + len - 1 do
 local cb = string.byte(s, j)
 local jLo = (j == i + 1) and lo or 0x80
 local jHi = (j == i + 1) and hi or 0xBF
 if cb == nil or cb &lt; jLo or cb &gt; jHi then
 valid = false
 break
 end
 end
 end
 if valid then
 table.insert(out, string.sub(s, i, i + len - 1))
 i = i + len
 else
 table.insert(out, "?")
 i = i + 1
 end
 end
 end
 return table.concat(out)
end

local function sanitizeEnvelope(value, depth)
 if depth &gt; 64 then
 return tostring(value)
 end
 local kind = type(value)
 if kind == "string" then
 return jsonSafe(value)
 elseif kind == "table" then
 local out = {}
 for key, item in pairs(value) do
 if type(key) == "string" then
 local safeKey = jsonSafe(key)
 if string.sub(safeKey, 1, 1) == "$" then
 safeKey = "__" .. string.sub(safeKey, 2)
 end
 out[safeKey] = sanitizeEnvelope(item, depth + 1)
 else
 out[key] = sanitizeEnvelope(item, depth + 1)
 end
 end
 return out
 else
 return value
 end
end

local function encodeEnvelope(env)
 local body = HttpService:JSONEncode(sanitizeEnvelope(env, 0))

 if string.find(body, "\t", 1, true) then
 body = string.gsub(body, "\t", "\\t")
 end
 return body
end

local RELAY_MAX_RESULT = 900000
local RELAY_CMD_TIMEOUT = 180

local relayRng = Random.new()

local function randomHex(n)
 local chars = "0123456789abcdef"
 local out = table.create(n)
 for i = 1, n do
 local idx = relayRng:NextInteger(1, 16)
 out[i] = string.sub(chars, idx, idx)
 end
 return table.concat(out)
end

local function relayPersistLastMsgId()
 if relay.deviceId ~= nil and relay.lastMsgId ~= nil then
 pcall(function()
 plugin:SetSetting("AIBridge_LastMsg_" .. relay.deviceId, relay.lastMsgId)
 end)
 end
end

local function relayEnsureIdentity()
 if relay.deviceId ~= nil then
 return
 end
 local stored = getSetting("AIBridge_DeviceId", nil)
 relay.deviceId = randomHex(16)
 pcall(function()
 plugin:SetSetting("AIBridge_DeviceId", relay.deviceId)
 end)
 relay.lastMsgId = nil
 abandonedTurn = nil
 if type(stored) == "string" and #stored &gt;= 8 and stored ~= relay.deviceId then
 relay._oldId = stored
 log("Session channel: " .. relay.deviceId .. " (rotated, previous channel will be wiped)")
 else
 log("Session channel: " .. relay.deviceId)
 end
end

local pendingResults = {}

local function relayPublish(env)

 if type(env.result) == "table" and not env.resultEncoded then
 local okPack, packed = pcall(function()
 return HttpService:JSONEncode(sanitizeEnvelope(env.result, 0))
 end)
 if okPack then
 env.resultEncoded = true
 env.result = packed
 end
 end
 local body = encodeEnvelope(env)
 if #body &gt; RELAY_MAX_RESULT then
 env = {
 id = env.id,
 ok = false,
 error = string.format("result was %d bytes — too large to send from Studio (Roblox HTTP ~1MB limit). Narrow the query (scope/max/depth).", #body),
 }
 body = HttpService:JSONEncode(env)
 end

 return http({ Url = resUrl() .. ".json", Method = "POST", Body = body })
end

local function relayTrimRes()

 task.spawn(function()
 local resp = http({ Url = resUrl() .. ".json?shallow=true", Method = "GET" })
 if resp == nil then
 return
 end
 local ok, keys = pcall(function()
 return HttpService:JSONDecode(resp.Body or "")
 end)
 if not ok or type(keys) ~= "table" then
 return
 end
 local sorted = {}
 for key in pairs(keys) do
 table.insert(sorted, key)
 end
 if #sorted &lt;= 15 then
 return
 end
 table.sort(sorted)
 for i = 1, #sorted - 15 do
 pcall(function()
 http({ Url = resUrl() .. "/" .. sorted[i] .. ".json", Method = "DELETE" })
 end)
 end
 end)
end

function OPS.debug()

 local report = {
 plugin = PLUGIN_TITLE,
 version = VERSION,
 studio = STUDIO_VERSION,
 httpEnabled = HttpService.HttpEnabled,
 uptimeSeconds = math.floor(os.clock() - state.startedAt + 0.5),
 commandsServed = state.commandsServed,
 errors = state.errors,
 }

 report.marketplace = "agent-side (npx golem-bridge search/info)"

 local marker = "debug-" .. tostring(os.clock())
 local okPost, postErr = relayPublish({ op = "debug", v = VERSION, ts = os.time(), marker = marker })
 report.relayPublish = okPost and "ok" or tostring(postErr)
 if okPost then
 local keyName = nil
 pcall(function()
 local posted = HttpService:JSONDecode(okPost.Body or "")
 if type(posted) == "table" then
 keyName = posted.name
 end
 end)
 local verified = false
 if type(keyName) == "string" then
 local resp = http({ Url = resUrl() .. "/" .. keyName .. ".json", Method = "GET" })
 if resp ~= nil and string.find(resp.Body or "", marker, 1, true) ~= nil then
 verified = true
 end
 end
 report.relayRead = verified and "ok" or "read failed"
 end
 return report
end

local function relayDeliver(env)
 local resp, err = relayPublish(env)
 if resp == nil then
 if #pendingResults &lt; 25 then
 table.insert(pendingResults, { env = env, fails = 0 })
 end

 state.publishError = tostring(err)
 log("relay: result publish failed: " .. tostring(err))
 else
 state.publishError = nil
 relayTrimRes()
 end
 updateStatus()

 if resp ~= nil then
 local ok, data = pcall(function()
 return HttpService:JSONDecode(resp.Body or "")
 end)
 if ok and type(data) == "table" and type(data.name) == "string" then
 return data.name
 end
 end
 return nil
end

local function relayFlushPending()
 while #pendingResults &gt; 0 do
 local pending = pendingResults[1]
 local ok, err = relayPublish(pending.env)
 if ok then
 table.remove(pendingResults, 1)
 state.publishError = nil
 elseif string.find(tostring(err), "HTTP 429", 1, true) then
 state.publishError = tostring(err) .. " (relay throttling? results queue and retry)"
 task.wait(6)
 if #pendingResults &gt; 25 then
 table.remove(pendingResults, 1)
 end
 updateStatus()
 return
 else

 pending.fails = (pending.fails or 0) + 1
 if pending.fails &gt;= 2 then
 if pending.env.id ~= nil and not pending.swapped then
 pending.swapped = true
 pending.fails = 0
 pending.env = {
 id = pending.env.id,
 ok = false,
 v = VERSION,
 error = string.format("the command ran, but its result could not be delivered to the relay (%s). This plugin is v%s - if this repeats, make sure Studio runs the latest Golem. Narrow the query (scope/max/depth) and retry.", tostring(err), VERSION),
 }
 task.wait(1)
 else
 table.remove(pendingResults, 1)
 log("relay: dropped a result: " .. tostring(err))
 end
 else
 task.wait(1)
 end
 end
 end
 updateStatus()
end

local function relayBeaconPost(deviceId, env)
 pcall(function()
 http({
 Url = FIREBASE_DB .. "/channels/" .. tostring(deviceId) .. "/beacons.json",
 Method = "POST",
 Body = encodeEnvelope(env),
 })
 end)

 task.spawn(function()
 local resp = http({
 Url = FIREBASE_DB .. "/channels/" .. tostring(deviceId) .. "/beacons.json?shallow=true",
 Method = "GET",
 })
 if resp == nil then
 return
 end
 local okKeys, keys = pcall(function()
 return HttpService:JSONDecode(resp.Body or "")
 end)
 if not okKeys or type(keys) ~= "table" then
 return
 end
 local sorted = {}
 for key in pairs(keys) do
 table.insert(sorted, key)
 end
 if #sorted &lt;= 5 then
 return
 end
 table.sort(sorted)
 for i = 1, #sorted - 5 do
 pcall(function()
 http({
 Url = FIREBASE_DB .. "/channels/" .. tostring(deviceId) .. "/beacons/" .. sorted[i] .. ".json",
 Method = "DELETE",
 })
 end)
 end
 end)
end

local function relayBeacon(op, extra)
 local env = { op = op, v = VERSION, ts = os.time() }
 if type(extra) == "table" then
 for key, value in pairs(extra) do
 env[key] = value
 end
 end
 relayBeaconPost(relay.deviceId, env)
end

local function relayBeaconTo(deviceId, op)

 if type(deviceId) ~= "string" or #deviceId &lt; 8 then
 return
 end
 relayBeaconPost(deviceId, { op = op, v = VERSION, ts = os.time() })
end

local function relayHandleMessage(cmd)

 if type(cmd) ~= "table" then
 log("relay: ignored a non-JSON value on the command channel")
 return
 end
 if cmd.id == nil or type(cmd.op) ~= "string" then
 if cmd.id ~= nil then
 relayDeliver({ id = cmd.id, ok = false, error = "command must include a string 'op' and an 'id'" })
 else
 log("relay: ignored a command without an id")
 end
 return
 end
 state.commandsServed = state.commandsServed + 1
 if abandonedTurn ~= nil and cmd.op ~= "turn_end" and cmd.op ~= "say" and cmd.op ~= "ping" and cmd.op ~= "debug" then
 state.errors = state.errors + 1
 log(string.format("debt block: '%s' refused - the last turn (%d tools) still owes its closing note",
 tostring(cmd.op), abandonedTurn.count))
 relayDeliver({
 id = cmd.id,
 ok = false,
 op = tostring(cmd.op),
 error = string.format("unpaid turn note: the last turn (%d tools) was never closed with `turn end --note`. Post the missing note first: turn end --note \"summary of that work\" - then re-run your command.", abandonedTurn.count),
 turnOpen = false,
 })
 return
 end
 local chatRow = addChatCommand(cmd.op, cmd.args)

 local envelope = nil
 local finished = false
 task.spawn(function()
 if chatRow ~= nil then
 task.wait()
 end
 envelope = executeCommand(cmd)
 finished = true
 end)
 local startedAt = os.time()
 while not finished and os.time() - startedAt &lt; RELAY_CMD_TIMEOUT do
 task.wait(0.1)
 end
 if not finished then
 envelope = {
 id = cmd.id,
 ok = false,
 error = string.format("'%s' did not finish within %d s — it may be stuck; the bridge keeps serving other commands (a Studio restart clears stuck ops)", tostring(cmd.op), RELAY_CMD_TIMEOUT),
 }
 end
 envelope = envelope or { id = cmd.id, ok = false, error = "command returned no result" }

 if type(currentTurn) == "table" and not currentTurn.collapsed then
 envelope.turnOpen = true
 envelope.turnTools = currentTurn.count
 envelope.reminder = string.format('TURN OPEN (%d tools so far). Do NOT reply yet - finish your tools, then run `npx golem-bridge turn end --note "your reply"`. `turn end` without --note is rejected.', currentTurn.count)
 else
 envelope.turnOpen = false
 end
 if chatRow ~= nil then
 chatRow.finish(envelope)
 end
 if envelope.ok then
 log(string.format("OK %s · %s ms", tostring(cmd.op), tostring(envelope.meta and envelope.meta.durationMs or "?")))
 else
 state.errors = state.errors + 1
 log(string.format("ERR %s · %s", tostring(cmd.op), tostring(envelope.error)))
 end
 local resKey = relayDeliver(envelope)
end

local function relayLoop(myGeneration)
 log(string.format("relay: live on %s (polling every ~%ds)", cmdUrl(), relay.interval))
 while myGeneration == generation do
 if not RunService:IsEdit() then

 task.wait(3)
 else
 relayFlushPending()

 local query = ".json?orderBy=" .. HttpService:UrlEncode('"$key"') .. "&amp;limitToLast=25"
 if relay.lastMsgId ~= nil then
 query = query .. "&amp;startAt=" .. HttpService:UrlEncode('"' .. relay.lastMsgId .. '"')
 end
 local resp, err = http({ Url = cmdUrl() .. query, Method = "GET" })
 if resp ~= nil then
 relay.okStreak = relay.okStreak + 1

 if relay.okStreak &gt;= 12 then
 relay.interval = math.max(2, relay.interval - 1)
 relay.okStreak = 0
 end
 setConnected(true)
 if type(resp.Body) == "string" and #resp.Body &gt; 0 and resp.Body ~= "null" then
 local okDecode, data = pcall(function()
 return HttpService:JSONDecode(resp.Body)
 end)
 if okDecode and type(data) == "table" then
 local keys = {}
 for key in pairs(data) do
 table.insert(keys, key)
 end
 table.sort(keys)
 local skippedOld = 0
 for _, key in ipairs(keys) do
 local cmd = data[key]
 if key ~= relay.lastMsgId then
 local isOld = (type(cmd) == "table" and type(cmd.ts) == "number"
 and cmd.ts &lt; relay.skipBefore)
 if type(cmd) == "table" and not isOld then
 local okHandle, errHandle = pcall(relayHandleMessage, cmd)
 if not okHandle then
 state.errors = state.errors + 1
 log("relay: command '" .. tostring(cmd.op) .. "' crashed the handler: " .. tostring(errHandle), "err")
 if cmd.id ~= nil then
 pcall(function()
 relayDeliver({ id = cmd.id, ok = false, op = tostring(cmd.op), error = "plugin internal error, command dropped: " .. tostring(errHandle) })
 end)
 end
 end
 else
 skippedOld = skippedOld + 1
 end

 pcall(function()
 http({ Url = cmdUrl() .. "/" .. key .. ".json", Method = "DELETE" })
 end)
 end
 relay.lastMsgId = key
 end
 relayPersistLastMsgId()
 if skippedOld &gt; 0 then
 log("relay: ignored " .. skippedOld .. " command(s) sent before this Studio session started")
 end
 end
 end
 task.wait(relay.interval)
 else
 local e = tostring(err)
 relay.okStreak = 0
 ensureHttpEnabled()
 setConnected(false, e)
 if string.find(e, "HTTP 429", 1, true) then
 relay.interval = math.min(relay.interval * 2 + 1, 25)
 log(string.format("relay: rate limited - now polling every %ds", relay.interval))
 else
 relay.interval = 2
 end
 task.wait(2.5)
 end
 end
 end
end



local function setupCommandText()

 return "Connect to my Roblox Studio, Run: npx golem-bridge connect " .. tostring(relay.deviceId)
end

local function startBridge()
 ensureHttpEnabled()
 if relay._oldId ~= nil then
 local oldId = relay._oldId
 relay._oldId = nil
 relayBeaconTo(oldId, "revoked")
 task.spawn(function()
 pcall(function()
 http({ Url = FIREBASE_DB .. "/channels/" .. tostring(oldId) .. ".json", Method = "DELETE" })
 end)
 end)
 end
 generation = generation + 1
 state.running = true
 relayEnsureIdentity()

 relay.skipBefore = os.time() - 45
 task.spawn(relayLoop, generation)
 if RunService:IsEdit() then

 relayBeacon("hello", { place = game.PlaceId })
 end
 updateStatus()
end

local function promptRefresh()
 if relay.deviceId == nil then
 return
 end
 local command = setupCommandText()
 if ui.setupBox ~= nil then
 ui.setupBox.Text = command
 end
 if ui.settingsSetupBox ~= nil then
 ui.settingsSetupBox.Text = command
 end
end

local function applyModeToUi()
 promptRefresh()
 updateStatus()
end

local function makeIcon(kind, size, color)

 local holder = createElement("Frame", {
 Name = "Icon_" .. kind,
 AnchorPoint = Vector2.new(0.5, 0.5),
 Position = UDim2.fromScale(0.5, 0.5),
 Size = UDim2.fromOffset(size, size),
 BackgroundTransparency = 1,
 })
 local function bar(w, h, x, y, rot)
 return createElement("Frame", {
 AnchorPoint = Vector2.new(0.5, 0.5),
 Position = UDim2.new(0.5, x, 0.5, y),
 Size = UDim2.fromOffset(w, h),
 BackgroundColor3 = color,
 BorderSizePixel = 0,
 Rotation = rot,
 }, holder)
 end
 if kind == "close" then
 local s = math.floor(size * 0.64)
 bar(2, s, 0, 0, 45)
 bar(2, s, 0, 0, -45)
 elseif kind == "chevronDown" then
 local s = math.floor(size * 0.52)
 local o = math.floor(s / 4)
 bar(2, s, -o, -o, 45)
 bar(2, s, o, -o, -45)
 end
 return holder
end

local function buildUi(widget, linkWidget)
 local function label(props, parent)
 local defaults = {
 BackgroundTransparency = 1,
 FontFace = fontMedium,
 TextSize = 12,
 TextXAlignment = Enum.TextXAlignment.Left,
 TextYAlignment = Enum.TextYAlignment.Top,
 TextColor3 = COLORS.textDim,
 Text = "",
 }
 for k, v in pairs(props) do
 defaults[k] = v
 end
 return createElement("TextLabel", defaults, parent)
 end

 local function textBox(props, parent)
 local defaults = {
 BackgroundColor3 = COLORS.inner,
 TextColor3 = COLORS.text,
 PlaceholderColor3 = COLORS.textFaint,
 ClearTextOnFocus = false,
 FontFace = fontRegular,
 TextSize = 13,
 Text = "",
 BorderSizePixel = 0,
 }
 for k, v in pairs(props) do
 defaults[k] = v
 end
 local box = Instance.new("TextBox")
 for k, v in pairs(defaults) do
 if k ~= "Parent" then
 box[k] = v
 end
 end
 box.Parent = parent
 addCorner(box, 6)
 return box
 end

 local function button(props, parent, hoverColor)
 local baseColor = props.BackgroundColor3 or COLORS.neutral
 local defaults = {
 BackgroundColor3 = COLORS.neutral,
 TextColor3 = COLORS.text,
 FontFace = fontSemibold,
 TextSize = 13,
 BorderSizePixel = 0,
 AutoButtonColor = false,
 Text = "",
 }
 for k, v in pairs(props) do
 defaults[k] = v
 end
 local btn = createElement("TextButton", defaults, parent)
 addCorner(btn, 8)
 btn.MouseEnter:Connect(function()
 tween(btn, { BackgroundColor3 = hoverColor or COLORS.cardHi }, 0.12)
 end)
 btn.MouseLeave:Connect(function()
 tween(btn, { BackgroundColor3 = baseColor }, 0.2)
 end)
 return btn
 end

